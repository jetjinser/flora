
@title{Words and Expressions Commonly Misused 常被误用的词与短语(G–O)}
@summary{从Get到-oriented的常见误用词条。}
@taxon["reference"]

本页收录第四版第四章中从@emph{Get}到@emph{-oriented}的各条目。每个条目先给出被讨论的词或短语，再加以说明；例证保留英文原文。

@subtree[#:id "strunk1999-usage-get"]{
  @title{Get}

  @bi{
    @emph{Get}. The colloquial @emph{have got} for @emph{have} should not be @bold{used in} writing. The preferable form of the participle is @emph{got}, @bold{not} @emph{gotten}.
  }{
    @emph{Get}。口语体的@emph{have got}用来代替@emph{have}，不应@bold{用于}写作。分词更可取的形式是@emph{got}，@bold{不是}@emph{gotten}。
  }

  @itemize{
    @item{误：He has not got any sense.}
    @item{正：He has no sense.}
  }

  @itemize{
    @item{误：They returned without having gotten any.}
    @item{正：They returned without having got any.}
  }
}

@subtree[#:id "strunk1999-usage-gratuitous"]{
  @title{Gratuitous}

  @bi{
    @emph{Gratuitous}. Means "unearned," or "unwarranted."
  }{
    @emph{Gratuitous}。意为"unearned"（不应得的）或"unwarranted"（无正当理由的）。
  }

  @blockquote{The insult seemed gratuitous. (undeserved)}
}

@subtree[#:id "strunk1999-usage-he-is-a-man-who"]{
  @title{He is a man who}

  @bi{
    @emph{He is a man who}. A common type of redundant expression; see @link["strunk1999-rule-17"]{Rule 17}.
  }{
    @emph{He is a man who}。一种常见的冗余表达；见@link["strunk1999-rule-17"]{规则17}。
  }

  @itemize{
    @item{误：He is a man who is very ambitious.}
    @item{正：He is very ambitious.}
  }

  @itemize{
    @item{误：Vermont is a state that attracts visitors because of its winter sports.}
    @item{正：Vermont attracts visitors because of its winter sports.}
  }
}

@subtree[#:id "strunk1999-usage-hopefully"]{
  @title{Hopefully}

  @bi{
    @emph{Hopefully}. This once-useful adverb meaning "with hope" has been distorted and is now widely used to mean "I hope" or "it is to be hoped." Such use is not merely wrong, it is silly. To say, "Hopefully I'll leave on the noon plane" is to talk nonsense. Do you mean you'll leave on the noon plane in a hopeful frame of mind? Or do you mean you hope you'll leave on the noon plane? Whichever you mean, you haven't said it clearly. Although the word in its new, free-floating capacity may be pleasurable and even useful to many, it offends the ear of many others, who do not like to see words dulled or eroded, particularly when the erosion leads to ambiguity, softness, or nonsense.
  }{
    @emph{Hopefully}。这个一度有用的副词，意为"with hope"（怀着希望），如今已被扭曲，广泛用来表示"I hope"（我希望）或"it is to be hoped"（但愿）。这种用法不仅错误，而且愚蠢。说"Hopefully I'll leave on the noon plane"是无意义的。你的意思是你会怀着希望的心情乘中午的飞机离开？还是你希望自己乘中午的飞机离开？无论你指哪一种，你都没有把它说清楚。尽管这个词在它新的、飘忽不定的用法中可能令许多人感到愉快甚至有用，但它却冒犯了另外许多人的耳朵，他们不愿看到词被钝化或侵蚀，尤其当这种侵蚀导致歧义、软弱或荒谬时。
  }
}

@subtree[#:id "strunk1999-usage-however"]{
  @title{However}

  @bi{
    @emph{However}. Avoid starting a sentence with @emph{however} when the meaning is "nevertheless." The word usually serves better when not in first position.
  }{
    @emph{However}。当意思是"nevertheless"（然而）时，避免用它来开头一句。这个词在不出现在句首时通常更合适。
  }

  @itemize{
    @item{误：The roads were almost impassable. However, we at last succeeded in reaching camp.}
    @item{正：The roads were almost impassable. At last, however, we succeeded in reaching camp.}
  }

  @bi{
    When @emph{however} comes first, it means "in whatever way" or "to whatever extent."
  }{
    当@emph{however}位于句首时，意为"in whatever way"（无论以何种方式）或"to whatever extent"（无论到什么程度）。
  }

  @blockquote{However you advise him, he will probably do as he thinks best. However discouraging the prospect, they never lost heart.}
}

@subtree[#:id "strunk1999-usage-illusion"]{
  @title{Illusion}

  @bi{
    @emph{Illusion}. See @emph{allusion}.
  }{
    @emph{Illusion}。见@emph{allusion}。
  }
}

@subtree[#:id "strunk1999-usage-imply-infer"]{
  @title{Imply. Infer}

  @bi{
    @emph{Imply}. @emph{Infer}. Not interchangeable. Something @emph{implied} is something suggested or indicated, though not expressed. Something @emph{inferred} is something deduced from evidence at hand.
  }{
    @emph{Imply}、@emph{Infer}。二者不可互换。@emph{implied}（被暗示的）是被提示或指出、但未明说的东西。@emph{inferred}（被推断的）是从手头证据中推导出来的东西。
  }

  @blockquote{Farming implies early rising. Since she was a farmer, we inferred that she got up early.}
}

@subtree[#:id "strunk1999-usage-importantly"]{
  @title{Importantly}

  @bi{
    @emph{Importantly}. Avoid by rephrasing.
  }{
    @emph{Importantly}。通过改写来避免使用。
  }

  @itemize{
    @item{误：More importantly, he paid for the damages.}
    @item{正：What's more, he paid for the damages.}
  }

  @itemize{
    @item{误：With the breeze freshening, he altered course to pass inside the island. More importantly, as things turned out, he tucked in a reef.}
    @item{正：With the breeze freshening, he altered course to pass inside the island. More important, as things turned out, he tucked in a reef.}
  }
}

@subtree[#:id "strunk1999-usage-in-regard-to"]{
  @title{In regard to}

  @bi{
    @emph{In regard to}. Often wrongly written @emph{in regards to}. But @emph{as regards} is correct, and means the same thing.
  }{
    @emph{In regard to}。常被错误地写成@emph{in regards to}。但@emph{as regards}是正确的，意思相同。
  }
}

@subtree[#:id "strunk1999-usage-in-the-last-analysis"]{
  @title{In the last analysis}

  @bi{
    @emph{In the last analysis}. A bankrupt expression.
  }{
    @emph{In the last analysis}。一个毫无价值的表达。
  }
}

@subtree[#:id "strunk1999-usage-inside-of-inside"]{
  @title{Inside of. Inside}

  @bi{
    @emph{Inside of}. @emph{Inside}. The @emph{of} following @emph{inside} is correct in the adverbial meaning "in less than." In other meanings, @emph{of} is unnecessary.
  }{
    @emph{Inside of}、@emph{Inside}。@emph{inside}后面的@emph{of}，在副词义"in less than"（不到、少于）中是正确的。在其他含义中，@emph{of}是多余的。
  }

  @blockquote{Inside of five minutes I'll be inside the bank.}
}

@subtree[#:id "strunk1999-usage-insightful"]{
  @title{Insightful}

  @bi{
    @emph{Insightful}. The word is a suspicious overstatement for "perceptive." If it is to be used at all, it should be used for instances of remarkably penetrating vision. Usually, it crops up merely to inflate the commonplace.
  }{
    @emph{Insightful}。这个词是对"perceptive"（有洞察力的）的一种可疑的夸大说法。如果要用，也应当用于洞察力非凡的情形。通常，它冒出来只是为了给平庸的话添彩。
  }

  @itemize{
    @item{误：That was an insightful remark you made.}
    @item{正：That was a perceptive remark you made.}
  }
}

@subtree[#:id "strunk1999-usage-in-terms-of"]{
  @title{In terms of}

  @bi{
    @emph{In terms of}. A piece of padding usually best omitted.
  }{
    @emph{In terms of}。一种填充语，通常最好删去。
  }

  @itemize{
    @item{误：The job was unattractive in terms of salary.}
    @item{正：The salary made the job unattractive.}
  }
}

@subtree[#:id "strunk1999-usage-interesting"]{
  @title{Interesting}

  @bi{
    @emph{Interesting}. An unconvincing word; avoid it as a means of introduction. Instead of announcing that what you are about to tell is interesting, make it so.
  }{
    @emph{Interesting}。一个没有说服力的词；避免用它来开头引入。与其宣布你即将讲的东西有趣，不如让它变得有趣。
  }

  @itemize{
    @item{误：An interesting story is told of}
    @item{正：(Tell the story without preamble.)}
  }

  @itemize{
    @item{误：In connection with the forthcoming visit of Mr. B. to America, it is interesting to recall that he}
    @item{正：Mr. B., who will soon visit America}
  }

  @bi{
    Also to be avoided in introduction is the word @emph{funny}. Nothing becomes funny by being labeled so.
  }{
    同样要避免在开头引入时使用@emph{funny}一词。贴上标签并不会让任何东西变得有趣。
  }
}

@subtree[#:id "strunk1999-usage-irregardless"]{
  @title{Irregardless}

  @bi{
    @emph{Irregardless}. Should be @emph{regardless}. The error results from failure to see the negative in @emph{-less} and from a desire to get it in as a prefix, suggested by such words as @emph{irregular}, @emph{irresponsible}, and, perhaps especially, @emph{irrespective}.
  }{
    @emph{Irregardless}。应为@emph{regardless}。这个错误源于没有看出@emph{-less}中的否定含义，以及想把否定作为前缀嵌入的愿望——这种愿望由@emph{irregular}、@emph{irresponsible}，也许尤其是@emph{irrespective}这类词所暗示。
  }
}

@subtree[#:id "strunk1999-usage-ize"]{
  @title{-ize}

  @bi{
    @emph{-ize}. Do not coin verbs by adding this tempting suffix. Many good and useful verbs do end in @emph{-ize}: @emph{summarize}, @emph{fraternize}, @emph{harmonize}, @emph{fertilize}. But there is a growing list of abominations: @emph{containerize}, @emph{prioritize}, @emph{finalize}, to name three. Be suspicious of @emph{-ize}; let your ear and your eye guide you. Never tack @emph{-ize} onto a noun to create a verb. Usually you will discover that a useful verb already exists. Why say "utilize" when there is the simple, unpretentious word @emph{use}?
  }{
    @emph{-ize}。不要通过添加这个诱人的后缀来生造动词。许多好的、有用的动词确实以@emph{-ize}结尾：@emph{summarize}、@emph{fraternize}、@emph{harmonize}、@emph{fertilize}。但可恶的词也越来越多：仅举三例，@emph{containerize}、@emph{prioritize}、@emph{finalize}。对@emph{-ize}要存疑；让你的耳朵和眼睛来引导你。绝不要把@emph{-ize}缀到名词上造动词。通常你会发现一个有用的动词已经存在。既然有简单、朴实的@emph{use}，为什么还要说"utilize"呢？
  }
}

@subtree[#:id "strunk1999-usage-kind-of"]{
  @title{Kind of}

  @bi{
    @emph{Kind of}. Except in familiar style, not to be used as a substitute for @emph{rather} or @emph{something like}. Restrict it to its literal sense: "Amber is a kind of fossil resin"; "I dislike that kind of publicity." The same holds true for @emph{sort of}.
  }{
    @emph{Kind of}。除在随便的文体中外，不用作@emph{rather}或@emph{something like}的替代。把它限制在字面意义上："Amber is a kind of fossil resin"；"I dislike that kind of publicity." @emph{sort of}同样如此。
  }
}

@subtree[#:id "strunk1999-usage-lay"]{
  @title{Lay}

  @bi{
    @emph{Lay}. A transitive verb. Except in slang ("Let it lay"), do not misuse it for the intransitive verb @emph{lie}. The hen, or the play, @emph{lays} an egg; the llama @emph{lies} down. The playwright went home and @emph{lay} down.
  }{
    @emph{Lay}。一个及物动词。除俚语中（"Let it lay"）外，不要把它误用作不及物动词@emph{lie}。母鸡，或者戏剧，@emph{lays}一个蛋；美洲驼@emph{lies} down（躺下）。剧作家回家后@emph{lay} down（躺下）。
  }

  @blockquote{lie, lay, lain, lying        lay, laid, laid, laying}
}

@subtree[#:id "strunk1999-usage-leave"]{
  @title{Leave}

  @bi{
    @emph{Leave}. Not to be misused for @emph{let}.
  }{
    @emph{Leave}。不要误用作@emph{let}。
  }

  @itemize{
    @item{误：Leave it stand the way it is.}
    @item{正：Let it stand the way it is.}
  }

  @itemize{
    @item{误：Leave go of that rope!}
    @item{正：Let go of that rope!}
  }
}

@subtree[#:id "strunk1999-usage-less"]{
  @title{Less}

  @bi{
    @emph{Less}. Should not be misused for @emph{fewer}.
  }{
    @emph{Less}。不应误用作@emph{fewer}。
  }

  @itemize{
    @item{误：They had less workers than in the previous campaign.}
    @item{正：They had fewer workers than in the previous campaign.}
  }

  @bi{
    @emph{Less} refers to quantity, @emph{fewer} to number. "His troubles are less than mine" means "His troubles are not so great as mine." "His troubles are fewer than mine" means "His troubles are not so numerous as mine."
  }{
    @emph{less}指数量（quantity），@emph{fewer}指数目（number）。"His troubles are less than mine"意为"His troubles are not so great as mine"。"His troubles are fewer than mine"意为"His troubles are not so numerous as mine"。
  }
}

@subtree[#:id "strunk1999-usage-like"]{
  @title{Like}

  @bi{
    @emph{Like}. Not to be used for the conjunction @emph{as}. @emph{Like} governs nouns and pronouns; before phrases and clauses the equivalent word is @emph{as}.
  }{
    @emph{Like}。不要用来代替连词@emph{as}。@emph{like}后接名词和代词；在短语和子句之前，对应的词是as。
  }

  @itemize{
    @item{误：We spent the evening like in the old days.}
    @item{正：We spent the evening as in the old days.}
  }

  @itemize{
    @item{误：Chloe smells good, like a baby should.}
    @item{正：Chloe smells good, as a baby should.}
  }

  @bi{
    The use of @emph{like} for @emph{as} has its defenders; they argue that any usage that achieves currency becomes valid automatically. This, they say, is the way the language is formed. It is and it isn't. An expression sometimes merely enjoys a vogue, much as an article of apparel does. @emph{Like} has long been widely misused by the illiterate; lately it has been taken up by the knowing and the well-informed, who find it catchy, or liberating, and who use it as though they were slumming. If every word or device that achieved currency were immediately authenticated, simply on the ground of popularity, the language would be as chaotic as a ball game with no foul lines. For the student, perhaps the most useful thing to know about @emph{like} is that most carefully edited publications regard its use before phrases and clauses as simple error.
  }{
    用@emph{like}代替@emph{as}有其捍卫者；他们辩称，任何获得通用的用法都会自动变得有效。他们说，语言就是这样形成的。是，也不是。一个表达有时只是一时风靡，就像一件衣服一样。@emph{like}长期以来被未受教育的人广泛误用；近来它又被内行和见多识广的人捡了起来，他们觉得它时髦，或者说解放，用它时仿佛是在体验底层生活。如果每一个获得通用的词或手法都仅凭流行就立即被认可，语言就会像一个没有边线的球赛一样混乱。对学生来说，关于@emph{like}也许最有用的一点是：大多数经过仔细编辑的出版物都将其用在短语和子句之前视为纯粹的错误。
  }
}

@subtree[#:id "strunk1999-usage-line"]{
  @title{Line. Along these lines}

  @bi{
    @emph{Line}. @emph{Along these lines}. @emph{Line} in the sense of "course of procedure, conduct, thought" is allowable but has been so overworked, particularly in the phrase @emph{along these lines}, that a writer who aims at freshness or originality had better discard it entirely.
  }{
    @emph{Line}、@emph{Along these lines}。@emph{line}在"course of procedure, conduct, thought"（行事、行为、思想的路线、方针）这一意义上是可用的，但它被用得太滥，尤其是@emph{along these lines}这一短语，因此追求新鲜或独创的作者最好完全弃用。
  }

  @itemize{
    @item{误：Mr. B. also spoke along the same lines.}
    @item{正：Mr. B. also spoke to the same effect.}
  }

  @itemize{
    @item{误：She is studying along the line of French literature.}
    @item{正：She is studying French literature.}
  }
}

@subtree[#:id "strunk1999-usage-literal-literally"]{
  @title{Literal. Literally}

  @bi{
    @emph{Literal}. @emph{Literally}. Often incorrectly used in support of exaggeration or violent metaphor.
  }{
    @emph{Literal}、@emph{Literally}。常被错误地用来支持夸张或激烈的比喻。
  }

  @itemize{
    @item{误：a literal flood of abuse}
    @item{正：a flood of abuse}
  }

  @itemize{
    @item{误：literally dead with fatigue}
    @item{正：almost dead with fatigue}
  }
}

@subtree[#:id "strunk1999-usage-loan"]{
  @title{Loan}

  @bi{
    @emph{Loan}. A noun. As a verb, prefer @emph{lend}.
  }{
    @emph{Loan}。一个名词。作为动词，宁用@emph{lend}。
  }

  @blockquote{Lend me your ears, the loan of your ears}
}

@subtree[#:id "strunk1999-usage-meaningful"]{
  @title{Meaningful}

  @bi{
    @emph{Meaningful}. A bankrupt adjective. Choose another, or rephrase.
  }{
    @emph{Meaningful}。一个毫无价值的形容词。换一个词，或改写。
  }

  @itemize{
    @item{误：His was a meaningful contribution.}
    @item{正：His contribution counted heavily.}
  }

  @itemize{
    @item{误：We are instituting many meaningful changes in the curriculum.}
    @item{正：We are improving the curriculum in many ways.}
  }
}

@subtree[#:id "strunk1999-usage-memento"]{
  @title{Memento}

  @bi{
    @emph{Memento}. Often incorrectly written @emph{momento}.
  }{
    @emph{Memento}。常被错误地写成@emph{momento}。
  }
}

@subtree[#:id "strunk1999-usage-most"]{
  @title{Most}

  @bi{
    @emph{Most}. Not to be used for @emph{almost} in formal composition.
  }{
    @emph{Most}。在正式写作中不要用来代替@emph{almost}。
  }

  @itemize{
    @item{误：most everybody}
    @item{正：almost everybody}
    @item{误：most all the time}
    @item{正：almost all the time}
  }
}

@subtree[#:id "strunk1999-usage-nature"]{
  @title{Nature}

  @bi{
    @emph{Nature}. Often simply redundant, used like @emph{character}.
  }{
    @emph{Nature}。常纯属多余，用法与@emph{character}类似。
  }

  @itemize{
    @item{误：acts of a hostile nature}
    @item{正：hostile acts}
  }

  @bi{
    @emph{Nature} should be avoided in such vague expressions as "a lover of nature," "poems about nature." Unless more specific statements follow, the reader cannot tell whether the poems have to do with natural scenery, rural life, the sunset, the untracked wilderness, or the habits of squirrels.
  }{
    在"a lover of nature"、"poems about nature"这类含糊表达中应避免@emph{nature}。除非后面有更具体的说明，读者无从判断这些诗是关于自然景色、乡间生活、日落、人迹未至的荒野，还是松鼠的习性。
  }
}

@subtree[#:id "strunk1999-usage-nauseous-nauseated"]{
  @title{Nauseous. Nauseated}

  @bi{
    @emph{Nauseous}. @emph{Nauseated}. The first means "sickening to contemplate"; the second means "sick at the stomach." Do not, therefore, say, "I feel nauseous," unless you are sure you have that effect on others.
  }{
    @emph{Nauseous}、@emph{Nauseated}。第一个意为"sickening to contemplate"（令人作呕）；第二个意为"sick at the stomach"（胃里难受）。因此，不要说"I feel nauseous"，除非你确信自己对别人有那种令人作呕的效果。
  }
}

@subtree[#:id "strunk1999-usage-nice"]{
  @title{Nice}

  @bi{
    @emph{Nice}. A shaggy, all-purpose word, to be used sparingly in formal composition. "I had a nice time." "It was nice weather." "She was so nice to her mother." The meanings are indistinct. @emph{Nice} is most useful in the sense of "precise" or "delicate": "a nice distinction."
  }{
    @emph{Nice}。一个毛茸茸的、万能的词，在正式写作中要少用。"I had a nice time." "It was nice weather." "She was so nice to her mother." 这些意思都含糊不清。@emph{nice}在"precise"（精确）或"delicate"（微妙）的意义上最有用："a nice distinction."。
  }
}

@subtree[#:id "strunk1999-usage-nor"]{
  @title{Nor}

  @bi{
    @emph{Nor}. Often used wrongly for @emph{or} after negative expressions.
  }{
    @emph{Nor}。在否定表达之后常被误用为@emph{or}。
  }

  @itemize{
    @item{误：He cannot eat nor sleep.}
    @item{正：He cannot eat or sleep.}
  }

  @blockquote{He can neither eat nor sleep. He cannot eat nor can he sleep.}
}

@subtree[#:id "strunk1999-usage-noun-used-as-verb"]{
  @title{Noun used as verb}

  @bi{
    @emph{Noun used as verb}. Many nouns have lately been pressed into service as verbs. Not all are bad, but all are suspect.
  }{
    @emph{Noun used as verb}。许多名词近来被拿来当动词用。并非全都糟糕，但全都可疑。
  }

  @itemize{
    @item{误：Be prepared for kisses when you gift your girlfriend with this merry scent.}
    @item{正：Be prepared for kisses when you give your girlfriend this merry scent.}
  }

  @itemize{
    @item{误：The candidate hosted a dinner for fifty of her workers.}
    @item{正：The candidate gave a dinner for fifty of her workers.}
  }

  @itemize{
    @item{误：The meeting was chaired by Mr. Oglethorp.}
    @item{正：Mr. Oglethorp was chair of the meeting.}
  }

  @itemize{
    @item{误：She headquarters in Newark.}
    @item{正：She has headquarters in Newark.}
  }

  @itemize{
    @item{误：The theater troupe debuted last fall.}
    @item{正：The theatre troupe made its debut last fall.}
  }
}

@subtree[#:id "strunk1999-usage-offputting-ongoing"]{
  @title{Offputting. Ongoing}

  @bi{
    @emph{Offputting}. @emph{Ongoing}. Newfound adjectives, to be avoided because they are inexact and clumsy. @emph{Ongoing} is a @bold{mix} of "continuing" and "active" and is usually superfluous.
  }{
    @emph{Offputting}、@emph{Ongoing}。新造的形容词，应予避免，因为它们不精确且笨拙。@emph{ongoing}是"continuing"和"active"的@bold{杂糅}，通常是多余的。
  }

  @itemize{
    @item{误：He devoted all his spare time to the ongoing program for aid to the elderly.}
    @item{正：He devoted all his spare time to the program for aid to the elderly.}
  }

  @bi{
    @emph{Offputting} might mean "objectionable," "disconcerting," "distasteful." Select instead a word whose meaning is clear. As a simple test, transform the participles to verbs. It is possible to @emph{upset} something. But to @emph{offput}? To @emph{ongo}?
  }{
    @emph{offputting}可能意为"objectionable"（令人反感的）、"disconcerting"（令人不安的）、"distasteful"（令人厌恶的）。改选一个意思明确的词。有个简单的检验方法：把这些分词还原为动词。让某物@emph{upset}是可能的。但to@emph{offput}呢？to@emph{ongo}呢？
  }
}

@subtree[#:id "strunk1999-usage-one"]{
  @title{One}

  @bi{
    @emph{One}. In the sense of "a person," not to be followed by @emph{his} or @emph{her}.
  }{
    @emph{One}。在"a person"（一个人）的意义上，后面不能接@emph{his}或@emph{her}。
  }

  @itemize{
    @item{误：One must watch his step.}
    @item{正：One must watch one's step. (You must watch your step.)}
  }
}

@subtree[#:id "strunk1999-usage-one-of-the-most"]{
  @title{One of the most}

  @bi{
    @emph{One of the most}. Avoid this feeble formula. "One of the most exciting developments of modern science is…"; "Switzerland is one of the most beautiful countries of Europe." There is nothing wrong with the grammar; the formula is simply threadbare.
  }{
    @emph{One of the most}。避免这个软弱的套话。"One of the most exciting developments of modern science is…"；"Switzerland is one of the most beautiful countries of Europe." 语法上并没有错；只是这个套话被用滥了。
  }
}

@subtree[#:id "strunk1999-usage-oriented"]{
  @title{-oriented}

  @bi{
    @emph{-oriented}. A clumsy, pretentious device, much in vogue. Find a better way of indicating orientation or alignment or direction.
  }{
    @emph{-oriented}。一个笨拙、装腔作势的手法，非常流行。另找一个更好的方式来表示取向、立场或方向。
  }

  @itemize{
    @item{误：It was a manufacturing-oriented company.}
    @item{正：It was a company chiefly concerned with manufacturing.}
  }

  @itemize{
    @item{误：Many of the skits are situation-oriented.}
    @item{正：Many of the skits rely on situation.}
  }
}
