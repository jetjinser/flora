@use-modules[(flora commands) (language scribble commands)]

@title{Words and Expressions Commonly Misused 常被误用的词与短语（P–Z）}
@summary{从Partially到Would的常见误用词条。}
@taxon["reference"]

@subtree[#:id "strunk1999-usage-partially"]{
  @title{Partially}

  @bi{
    @lang["en"]{@emph{Partially}. Not always interchangeable with @emph{partly}. Best used in the sense of "to a certain degree," when speaking of a condition or state: "I'm partially resigned to it." @emph{Partly} carries the idea of a part as distinct from the whole—usually a physical object.}
    @lang["zh-Hans"]{@emph{Partially}。并不总是能与@emph{partly}互换。最好用于"to a certain degree"（在某种程度上）的意义，谈论某种状况或状态时："I'm partially resigned to it."@emph{Partly}带有部分与整体相区别的意思——通常指实物。}
  }

  @itemize{
    @item{误：The log was partially submerged.}
    @item{正：The log was partly submerged.}
  }

  @itemize{
    @item{误：She was partially in and partially out.}
    @item{正：She was partly in and partly out.}
  }

  也可写作：She was part in, part out.
}

@subtree[#:id "strunk1999-usage-participle-for-verbal-noun"]{
  @title{Participle for verbal noun}

  @bi{
    @lang["en"]{@emph{Participle for verbal noun}.}
    @lang["zh-Hans"]{@emph{Participle for verbal noun}（用分词代替动词性名词）。}
  }

  @itemize{
    @item{误：There was little prospect of the Senate accepting even this compromise.}
    @item{正：There was little prospect of the Senate's accepting even this compromise.}
  }

  @bi{
    @lang["en"]{In the lefthand column, @emph{accepting} is a present participle; in the righthand column, it is a verbal noun (gerund). The construction shown in the lefthand column is occasionally found, and has its defenders. Yet it is easy to see that the second sentence has to do not with a prospect of the Senate but with a prospect of accepting.}
    @lang["zh-Hans"]{左栏中，@emph{accepting}是现在分词；右栏中，它是动词性名词（动名词）。左栏所示的构造偶尔可见，也有其辩护者。然而不难看出，第二句讲的不是参议院的前景，而是接受的前景。}
  }

  @bi{
    @lang["en"]{Any sentence in which the use of the possessive is awkward or impossible should of course be recast.}
    @lang["zh-Hans"]{当然，凡是使用所有格显得别扭或不可能的地方，都应当改写。}
  }

  @itemize{
    @item{误：In the event of a reconsideration of the whole matter's becoming necessary}
    @item{正：If it should become necessary to reconsider the whole matter}
  }

  @itemize{
    @item{误：There was great dissatisfaction with the decision of the arbitrators being favorable to the company.}
    @item{正：There was great dissatisfaction with the arbitrators' decision in favor of the company.}
  }
}

@subtree[#:id "strunk1999-usage-people"]{
  @title{People}

  @bi{
    @lang["en"]{@emph{People}. A word with many meanings. (@emph{The American Heritage Dictionary}, Third Edition, gives nine.) @emph{The people} is a political term, not to be confused with @emph{the public}. From the people comes political support or opposition; from the public comes artistic appreciation or commercial patronage.}
    @lang["zh-Hans"]{@emph{People}。一个含义众多的词。（《美国传统词典》第三版列出九种含义。）@emph{The people}是政治术语，不要与@emph{the public}混淆。政治上的支持或反对来自the people；艺术上的欣赏或商业上的赞助来自the public。}
  }

  @bi{
    @lang["en"]{The word @emph{people} is best not used with words of number, in place of @emph{persons}. If of "six people" five went away, how many people would be left? Answer: one people.}
    @lang["zh-Hans"]{@emph{people}一词最好不与数量词连用，也不要用它代替@emph{persons}。如果在"six people"中有五个走了，还剩多少people？答案：one people。}
  }
}

@subtree[#:id "strunk1999-usage-personalize"]{
  @title{Personalize}

  @bi{
    @lang["en"]{@emph{Personalize}. A pretentious word, often carrying bad advice. Do not @emph{personalize} your prose; simply make it good and keep it clean. See Chapter V, @link["strunk1999-reminder-1"]{Reminder 1}.}
    @lang["zh-Hans"]{@emph{Personalize}。一个矫饰的词，往往带来糟糕的建议。不要@emph{personalize}你的文章；只要把它写好、写得干净就行。参见@link["strunk1999-reminder-1"]{提醒1}。}
  }

  @itemize{
    @item{误：a highly personalized affair}
    @item{正：a highly personal affair}
  }

  @itemize{
    @item{误：Personalize your stationery.}
    @item{正：Design a letterhead.}
  }
}

@subtree[#:id "strunk1999-usage-personally"]{
  @title{Personally}

  @bi{
    @lang["en"]{@emph{Personally}. Often unnecessary.}
    @lang["zh-Hans"]{@emph{Personally}。往往不必要。}
  }

  @itemize{
    @item{误：Personally, I thought it was a good book.}
    @item{正：I thought it a good book.}
  }
}

@subtree[#:id "strunk1999-usage-possess"]{
  @title{Possess}

  @bi{
    @lang["en"]{@emph{Possess}. Often used because to the writer it sounds more impressive than @emph{have} or @emph{own}. Such usage is not incorrect but is to be guarded against.}
    @lang["zh-Hans"]{@emph{Possess}。常用它，是因为在作者听来，它比@emph{have}或@emph{own}更显得有分量。这种用法并不错，但须提防。}
  }

  @itemize{
    @item{误：She possessed great courage.}
    @item{正：She had great courage (was very brave).}
  }

  @itemize{
    @item{误：He was the fortunate possessor of}
    @item{正：He was lucky enough to own}
  }
}

@subtree[#:id "strunk1999-usage-presently"]{
  @title{Presently}

  @bi{
    @lang["en"]{@emph{Presently}. Has two meanings: "in a short while" and "currently." Because of this ambiguity it is best restricted to the first meaning: "She'll be here presently" ("soon," or "in a short time").}
    @lang["zh-Hans"]{@emph{Presently}。有两个含义："in a short while"（过一会儿）和"currently"（目前）。由于这种歧义，最好只限于第一个含义："She'll be here presently"（"soon"，或"in a short time"，很快、过不久）。}
  }
}

@subtree[#:id "strunk1999-usage-prestigious"]{
  @title{Prestigious}

  @bi{
    @lang["en"]{@emph{Prestigious}. Often an adjective of last resort. It's in the dictionary, but that doesn't mean you have to use it.}
    @lang["zh-Hans"]{@emph{Prestigious}。常是万不得已才用的形容词。词典里固然收了它，但这并不意味着你必须用它。}
  }
}

@subtree[#:id "strunk1999-usage-refer"]{
  @title{Refer}

  @bi{
    @lang["en"]{@emph{Refer}. See @emph{allude}.}
    @lang["zh-Hans"]{@emph{Refer}。参见@emph{allude}条。}
  }
}

@subtree[#:id "strunk1999-usage-regretful"]{
  @title{Regretful}

  @bi{
    @lang["en"]{@emph{Regretful}. Sometimes carelessly used for @emph{regrettable}: "The mixup was due to a regretful breakdown in communications."}
    @lang["zh-Hans"]{@emph{Regretful}。有时被粗心误用为@emph{regrettable}："The mixup was due to a regretful breakdown in communications."}
  }
}

@subtree[#:id "strunk1999-usage-relate"]{
  @title{Relate}

  @bi{
    @lang["en"]{@emph{Relate}. Not to be used intransitively to suggest rapport.}
    @lang["zh-Hans"]{@emph{Relate}。不得作不及物动词用来表示融洽关系（rapport）。}
  }

  @itemize{
    @item{误：I relate well to Janet.}
    @item{正：Janet and I see things the same way.}
  }

  也可写作：Janet and I have a lot in common.
}

@subtree[#:id "strunk1999-usage-respective-respectively"]{
  @title{Respective. Respectively}

  @bi{
    @lang["en"]{@emph{Respective}. @emph{Respectively}. These words may usually be omitted with advantage.}
    @lang["zh-Hans"]{@emph{Respective}、@emph{Respectively}。这两个词通常略去更好。}
  }

  @itemize{
    @item{误：Works of fiction are listed under the names of their respective authors.}
    @item{正：Works of fiction are listed under the names of their authors.}
  }

  @itemize{
    @item{误：The mile run and the two-mile run were won by Jones and Cummings respectively.}
    @item{正：The mile run was won by Jones, the two-mile run by Cummings.}
  }
}

@subtree[#:id "strunk1999-usage-secondly-thirdly-etc"]{
  @title{Secondly, thirdly, etc}

  @bi{
    @lang["en"]{@emph{Secondly}, @emph{thirdly}, etc. Unless you are prepared to begin @emph{with firstly} and defend it (which will be difficult), do not prettify numbers with -ly. Modern usage prefers @emph{second}, @emph{third}, and so on.}
    @lang["zh-Hans"]{@emph{Secondly}、@emph{thirdly}等。除非你打算以@emph{with firstly}开头并为之辩护（那会很难），否则不要用-ly来给数字"梳妆打扮"。现代用法更喜欢@emph{second}、@emph{third}等。}
  }
}

@subtree[#:id "strunk1999-usage-shall-will"]{
  @title{Shall. Will}

  @bi{
    @lang["en"]{@emph{Shall}. @emph{Will}. In formal writing, the future tense @bold{requires} @emph{shall} for the first person, @emph{will} for the second and @bold{third}. The formula to express the speaker's belief regarding @bold{a future} action or state is @emph{I shall}; @emph{I will} expresses determination or consent. A swimmer in distress cries, "I shall @bold{drown;} no one will save me!" A suicide puts it the other way: "I will drown; no one shall save me!" In relaxed speech, @bold{however,} the words @emph{shall} and @emph{will} are seldom used precisely; our ear guides us or fails to guide us, as the case may be, @bold{and we} are quite likely to drown when we want to survive @bold{and} survive when we want to drown.}
    @lang["zh-Hans"]{@emph{Shall}、@emph{Will}。在正式写作中，将来时@bold{要求}第一人称用@emph{shall}，第二和@bold{第三人称}用@emph{will}。表达说话者关于@bold{未来}动作或状态的看法，其公式是@emph{I shall}；@emph{I will}表示决心或同意。一个溺水挣扎的游泳者喊道："I shall @bold{drown;} no one will save me!"一个自杀者则反过来说："I will drown; no one shall save me!"@bold{然而，}在随意的言谈中，@emph{shall}和@emph{will}很少用得精确；我们的耳朵或引导我们，或不引导我们，视情形而定，@bold{而我们}很可能会在本想活命时溺死，@bold{而}在本想溺死时活下来。}
  }
}

@subtree[#:id "strunk1999-usage-so"]{
  @title{So}

  @bi{
    @lang["en"]{@emph{So}. Avoid, in writing, the use of so as an intensifier: "so good"; "so warm"; "so delightful."}
    @lang["zh-Hans"]{@emph{So}。写作中避免把so用作强调词："so good"、"so warm"、"so delightful"。}
  }
}

@subtree[#:id "strunk1999-usage-sort-of"]{
  @title{Sort of}

  @bi{
    @lang["en"]{@emph{Sort of}. See @emph{kind of}.}
    @lang["zh-Hans"]{@emph{Sort of}。参见@emph{kind of}条。}
  }
}

@subtree[#:id "strunk1999-usage-split-infinitive"]{
  @title{Split infinitive}

  @bi{
    @lang["en"]{@emph{Split infinitive}. There is precedent from the fourteenth century down for interposing an adverb between @emph{to} and the infinitive it governs, but the construction should be avoided unless the writer wishes to place unusual stress on the adverb.}
    @lang["zh-Hans"]{@emph{Split infinitive}（分裂不定式）。自十四世纪以降，就有在@emph{to}与其所支配的不定式之间插入副词的前例，但除非作者想对该副词施加不寻常的强调，否则应当避免这种构造。}
  }

  @itemize{
    @item{误：to diligently inquire}
    @item{正：to inquire diligently}
  }

  @bi{
    @lang["en"]{For another side to the split infinitive, see Chapter V, @link["strunk1999-reminder-14"]{Reminder 14}.}
    @lang["zh-Hans"]{关于分裂不定式的另一面，参见@link["strunk1999-reminder-14"]{提醒14}。}
  }
}

@subtree[#:id "strunk1999-usage-state"]{
  @title{State}

  @bi{
    @lang["en"]{@emph{State}. Not to be used as a mere substitute for @emph{say}, @emph{remark}. Restrict it to the sense of "express fully or clearly": "He refused to state his objections."}
    @lang["zh-Hans"]{@emph{State}。不要仅仅把它当作@emph{say}、@emph{remark}的替代词。把它限于"express fully or clearly"（充分或清楚地表达）这一含义："He refused to state his objections."}
  }
}

@subtree[#:id "strunk1999-usage-student-body"]{
  @title{Student body}

  @bi{
    @lang["en"]{@emph{Student body}. Nine times out of ten a needless and awkward expression, meaning no more than the simple word @emph{students}.}
    @lang["zh-Hans"]{@emph{Student body}。十有八九是个多余而别扭的说法，意思不过就是简单的@emph{students}一词。}
  }

  @itemize{
    @item{误：a member of the student body}
    @item{正：a student}
  }

  @itemize{
    @item{误：popular with the student body}
    @item{正：liked by the students}
  }
}

@subtree[#:id "strunk1999-usage-than"]{
  @title{Than}

  @bi{
    @lang["en"]{@emph{Than}. Any sentence with @emph{than} (to express comparison) should be examined to make sure no essential words are missing.}
    @lang["zh-Hans"]{@emph{Than}。凡含@emph{than}（表比较）的句子都应细察，确保没有遗漏必不可少的词。}
  }

  @blockquote{I'm probably closer to my mother than my father.}

  @bi{
    @lang["en"]{(Ambiguous.)}
    @lang["zh-Hans"]{这句有歧义（Ambiguous.）。可分别写作：}
  }

  @itemize{
    @item{正：I'm probably closer to my mother than to my father.}
    @item{正：I'm probably closer to my mother than my father is.}
  }

  @itemize{
    @item{误：It looked more like a cormorant than a heron.}
    @item{正：It looked more like a cormorant than like a heron.}
  }
}

@subtree[#:id "strunk1999-usage-thanking-you-in-advance"]{
  @title{Thanking you in advance}

  @bi{
    @lang["en"]{@emph{Thanking you in advance}. This sounds as if the writer meant, "It will not be worth my while to write to you again." In making your request, write "Will you please," or "I shall be obliged." Then, later, if you feel moved to do so, or if the circumstances call for it, write a letter of acknowledgment.}
    @lang["zh-Hans"]{@emph{Thanking you in advance}。这听起来像是作者在说："It will not be worth my while to write to you again."（不值得我再给你写信了。）提出请求时，写"Will you please"或"I shall be obliged"。然后，若你日后有意，或情况需要，再写一封致谢的信。}
  }
}

@subtree[#:id "strunk1999-usage-that-which"]{
  @title{That. Which}

  @bi{
    @lang["en"]{@emph{That}. @emph{Which}. @emph{That} is the defining, or restrictive, pronoun, @emph{which} the nondefining, or nonrestrictive. (See @link["strunk1999-rule-3"]{Rule 3}.)}
    @lang["zh-Hans"]{@emph{That}、@emph{Which}。@emph{That}是限定性的，即限制性代词；@emph{which}是非限定性的，即非限制性代词。（参见@link["strunk1999-rule-3"]{规则3}。）}
  }

  @itemize{
    @item{误：The lawn mower that is broken is in the garage.（说明是哪一台。）}
    @item{正：The lawn mower, which is broken, is in the garage.（就所讨论的唯一一台割草机补充一个事实。）}
  }

  @bi{
    @lang["en"]{The use of @emph{which} for @emph{that} is common in written and spoken language ("Let us now go even unto Bethlehem, and see this thing which is come to pass."). Occasionally @emph{which} seems preferable to @emph{that}, as in the sentence from the Bible. But it would be a convenience to all if these two pronouns were used with precision. Careful writers, watchful for small conveniences, go @emph{which}-hunting, remove the defining @emph{whiches}, and by so doing improve their work.}
    @lang["zh-Hans"]{用@emph{of which}代替@emph{that}，在书面语和口语中都很常见（"Let us now go even unto Bethlehem, and see this thing which is come to pass."）。有时@emph{which}似乎比@emph{that}更可取，如上面出自《圣经》的句子。但若这两个代词都能用得精确，对所有人都是一种便利。细心的作者，留意小小的便利，会去"猎捕which"，删掉限定性的@emph{which}，从而改进自己的作品。}
  }
}

@subtree[#:id "strunk1999-usage-the-foreseeable-future"]{
  @title{The foreseeable future}

  @bi{
    @lang["en"]{@emph{The foreseeable future}. A cliche, and a fuzzy one. How much of the future is foreseeable? Ten minutes? Ten years? Any of it? By whom is it foreseeable? Seers? Experts? Everybody?}
    @lang["zh-Hans"]{@emph{The foreseeable future}。一个陈词滥调，而且含义模糊。未来有多少是可预见的？十分钟？十年？有任何部分吗？由谁来预见？先知？专家？所有人？}
  }
}

@subtree[#:id "strunk1999-usage-the-truth-is-the-fact-is"]{
  @title{The truth is... The fact is...}

  @bi{
    @lang["en"]{@emph{The truth is}... @emph{The fact is}... A bad beginning for a sentence. If you feel you are possessed of the truth, or of the fact, simply state it. Do not give it advance billing.}
    @lang["zh-Hans"]{@emph{The truth is...}、@emph{The fact is...}。这是句子的糟糕开头。如果你觉得自己掌握了真相，或掌握了事实，直接说出来就是。不要为它做预告宣传。}
  }
}

@subtree[#:id "strunk1999-usage-they-he-or-she"]{
  @title{They. He or She}

  @bi{
    @lang["en"]{@emph{They}. @emph{He or She}. Do not use @emph{they} when the antecedent is a distributive expression such as @emph{each}, @emph{each one}, @emph{everybody}, @emph{every one}, @emph{many a man}. Use the singular pronoun.}
    @lang["zh-Hans"]{@emph{They}、@emph{He or She}。当先行词是@emph{each}、@emph{each one}、@emph{everybody}、@emph{every one}、@emph{many a man}这类分配性表达时，不要用@emph{they}。要用单数代词。}
  }

  @itemize{
    @item{误：Every one of us knows they are fallible.}
    @item{正：Every one of us knows he is fallible.}
  }

  @itemize{
    @item{误：Everyone in the community, whether they are a member of the Association or not, is invited to attend.}
    @item{正：Everyone in the community, whether he is a member of the Association or not, is invited to attend.}
  }

  @bi{
    @lang["en"]{A similar fault is the use of the plural pronoun with the antecedent @emph{anybody}, @emph{somebody}, @emph{someone}, the intention being either to avoid the awkward @emph{he or she} or to avoid committing oneself to one or the other. Some bashful speakers even say, "A friend of mine told me that they…"}
    @lang["zh-Hans"]{类似的毛病是把复数代词与先行词@emph{anybody}、@emph{somebody}、@emph{someone}连用，其意图要么是避免别扭的@emph{he or she}，要么是避免把自己归于两者中的哪一个。有些羞怯的说话者甚至说："A friend of mine told me that they…"}
  }

  @bi{
    @lang["en"]{The use of @emph{he} as a pronoun for nouns embracing both genders is a simple, practical convention rooted in the beginnings of the English language. Currently, however, many writers find the use of the generic @emph{he} or @emph{his} to rename indefinite antecedents limiting or offensive. Substituting @emph{he or she} in its place is the logical thing to do if it works. But it often doesn't work, if only because repetition makes it sound boring or silly.}
    @lang["zh-Hans"]{用@emph{he}作为涵盖两性的名词的代词，是一种简单而实用的约定，植根于英语的起源。然而如今，许多作者认为用泛指的@emph{he}或@emph{his}来指代不确定的先行词，有局限或令人反感。用@emph{he or she}来替代它，如果行得通，是合乎逻辑的做法。但它往往行不通，哪怕只是因为这重复听起来乏味或愚蠢。}
  }

  @bi{
    @lang["en"]{Consider these strategies to avoid an awkward overuse of @emph{he or she} or an unintentional emphasis on the masculine:}
    @lang["zh-Hans"]{考虑以下策略，以避免别扭地过度使用@emph{he or she}，或无意中强调阳性：}
  }

  @bi{
    @lang["en"]{Use the plural rather than the singular.}
    @lang["zh-Hans"]{用复数而非单数。}
  }

  @itemize{
    @item{误：The writer must address his readers' concerns.}
    @item{正：Writers must address their readers' concerns.}
  }

  @bi{
    @lang["en"]{Eliminate the pronoun altogether.}
    @lang["zh-Hans"]{彻底删去代词。}
  }

  @itemize{
    @item{误：The writer must address his readers' concerns.}
    @item{正：The writer must address readers' concerns.}
  }

  @bi{
    @lang["en"]{Substitute the second person for the third person.}
    @lang["zh-Hans"]{用第二人称代替第三人称。}
  }

  @itemize{
    @item{误：The writer must address his readers' concerns.}
    @item{正：As a writer, you must address your readers' concerns.}
  }

  @bi{
    @lang["en"]{No one need fear to use @emph{he} if common sense supports it. If you think @emph{she} is a handy substitute for @emph{he}, try it and see what happens. Alternatively, put all controversial nouns in the plural and avoid the choice of sex altogether, although you may find your prose sounding general and diffuse as a result.}
    @lang["zh-Hans"]{只要常识支持，谁都不必害怕使用@emph{he}。如果你觉得@emph{she}是替代@emph{he}的顺手选择，不妨试试，看看会怎样。另一种做法是，把所有有争议的名词都变成复数，从而完全避开性别的选择，尽管你可能会发现，这样一来文章听起来笼统而松散。}
  }
}

@subtree[#:id "strunk1999-usage-this"]{
  @title{This}

  @bi{
    @lang["en"]{@emph{This}. The pronoun @emph{this}, referring to the complete sense of a preceding sentence or clause, can't always carry the load and so may produce an imprecise statement.}
    @lang["zh-Hans"]{@emph{This}。代词@emph{this}若指代前一句或子句的完整意思，未必总能承担这一重负，因而可能产生不精确的表述。}
  }

  @itemize{
    @item{误：Visiting dignitaries watched yesterday as ground was broken for the new high-energy physics laboratory with a blowout safety wall. This is the first visible evidence of the university's plans for modernization and expansion.}
    @item{正：Visiting dignitaries watched yesterday as ground was broken for the new high-energy physics laboratory with a blowout safety wall. The ceremony afforded the first visible evidence of the university's plans for modernization and expansion.}
  }

  @bi{
    @lang["en"]{In the lefthand example above, @emph{this} does not immediately make clear what the first visible evidence is.}
    @lang["zh-Hans"]{在上面左栏的例子中，@emph{this}并不能立即说明什么是"第一项可见的证据"。}
  }
}

@subtree[#:id "strunk1999-usage-thrust"]{
  @title{Thrust}

  @bi{
    @lang["en"]{@emph{Thrust}. This showy noun, suggestive of power, hinting of sex, is the darling of executives, politicos, and speech-writers. Use it sparingly. Save it for specific application.}
    @lang["zh-Hans"]{@emph{Thrust}。这个招摇的名词，暗示着权力，暗指性，是主管、政客和演讲稿撰写人的宠儿。要少用它。把它留给具体的用法。}
  }

  @itemize{
    @item{误：Our reorganization plan has a tremendous thrust.}
    @item{正：The piston has a five-inch thrust.}
  }

  @itemize{
    @item{误：The thrust of his letter was that he was working more hours than he'd bargained for.}
    @item{正：The point he made in his letter was that he was working more hours than he'd bargained for.}
  }
}

@subtree[#:id "strunk1999-usage-tortuous-torturous"]{
  @title{Tortuous. Torturous}

  @bi{
    @lang["en"]{@emph{Tortuous}. @emph{Torturous}. A winding road is @emph{tortuous}, a painful ordeal is @emph{torturous}. Both words carry the idea of "twist," the twist having been a form of torture.}
    @lang["zh-Hans"]{@emph{Tortuous}、@emph{Torturous}。蜿蜒的道路是@emph{tortuous}，痛苦的磨难是@emph{torturous}。两个词都带有"twist"（扭曲）的意思，而扭曲曾是torture（酷刑）的一种形式。}
  }
}

@subtree[#:id "strunk1999-usage-transpire"]{
  @title{Transpire}

  @bi{
    @lang["en"]{@emph{Transpire}. Not to be used in the sense of "happen," "come to pass." Many writers so use it (usually when groping toward imagined elegance), but their usage finds little support in the Latin "breathe across or through." It is correct, however, in the sense of "become known." "Eventually, the grim account of his villainy transpired" (literally, "leaked through or out").}
    @lang["zh-Hans"]{@emph{Transpire}。不得用于"happen"、"come to pass"（发生、降临）的意义。许多作者这样用（通常是在摸索想象中的优雅时），但他们的用法在拉丁语"breathe across or through"（透出、渗出）中几乎找不到依据。不过，在"become known"（为人所知）的意义上，它是正确的。"Eventually, the grim account of his villainy transpired"（字面意思是"leaked through or out"，泄漏出来）。}
  }
}

@subtree[#:id "strunk1999-usage-try"]{
  @title{Try}

  @bi{
    @lang["en"]{@emph{Try}. Takes the infinitive: "try to mend it," not "try and mend it." Students of the language will argue that @emph{try and} has won through and become idiom. Indeed it has, and it is relaxed and acceptable. But @emph{try to} is precise, and when you are writing formal prose, try and write @emph{try to}.}
    @lang["zh-Hans"]{@emph{Try}。接不定式："try to mend it"，而非"try and mend it"。研究语言的人会争辩说，@emph{try and}已经流行开来，成了习语。诚然如此，它随意而可接受。但@emph{try to}更精确，当你写正式文章时，试着写@emph{try to}。}
  }
}

@subtree[#:id "strunk1999-usage-type"]{
  @title{Type}

  @bi{
    @lang["en"]{@emph{Type}. Not a synonym for @emph{kind of}. The examples below are common vulgarisms.}
    @lang["zh-Hans"]{@emph{Type}。不是@emph{kind of}的同义词。以下例子都是常见的粗俗用法。}
  }

  @itemize{
    @item{误：that type employee}
    @item{正：that kind of employee}
  }

  @itemize{
    @item{误：I dislike that type publicity.}
    @item{正：I dislike that kind of publicity.}
  }

  @itemize{
    @item{误：small, home-type hotels}
    @item{正：small, homelike hotels}
  }

  @itemize{
    @item{误：a new type plane}
    @item{正：a plane of a new design (new kind)}
  }
}

@subtree[#:id "strunk1999-usage-unique"]{
  @title{Unique}

  @bi{
    @lang["en"]{@emph{Unique}. Means "without like or equal." Hence, there can be no degrees of uniqueness.}
    @lang["zh-Hans"]{@emph{Unique}。意为"without like or equal"（无与伦比、独一无二）。因此，unique没有程度之分。}
  }

  @itemize{
    @item{误：It was the most unique coffee maker on the market.}
    @item{正：It was a unique coffee maker.}
  }

  @itemize{
    @item{误：The balancing act was very unique.}
    @item{正：The balancing act was unique.}
  }

  @itemize{
    @item{误：Of all the spiders, the one that lives in a bubble under water is the most unique.}
    @item{正：Among spiders, the one that lives in a bubble under water is unique.}
  }
}

@subtree[#:id "strunk1999-usage-utilize"]{
  @title{Utilize}

  @bi{
    @lang["en"]{@emph{Utilize}. Prefer @emph{use}.}
    @lang["zh-Hans"]{@emph{Utilize}。宁可说@emph{use}。}
  }

  @itemize{
    @item{误：I utilized the facilities.}
    @item{正：I used the toilet.}
  }

  @itemize{
    @item{误：He utilized the dishwasher.}
    @item{正：He used the dishwasher.}
  }
}

@subtree[#:id "strunk1999-usage-verbal"]{
  @title{Verbal}

  @bi{
    @lang["en"]{@emph{Verbal}. Sometimes means "word for word" and in this sense may refer to something expressed in writing. @emph{Oral} (from Latin @emph{os}, "mouth") limits the meaning to what is transmitted by speech. @emph{Oral agreement} is more precise than @emph{verbal agreement}.}
    @lang["zh-Hans"]{@emph{Verbal}。有时意为"word for word"（逐字），在这个意义上可以指以书面形式表达的东西。@emph{Oral}（源自拉丁语os，"嘴"）把含义限于靠言语传递的内容。@emph{oral agreement}比@emph{verbal agreement}更精确。}
  }
}

@subtree[#:id "strunk1999-usage-very"]{
  @title{Very}

  @bi{
    @lang["en"]{@emph{Very}. Use this word sparingly. Where emphasis is necessary, use words strong in themselves.}
    @lang["zh-Hans"]{@emph{Very}。少用这个词。需要强调时，就用本身有力的词。}
  }
}

@subtree[#:id "strunk1999-usage-while"]{
  @title{While}

  @bi{
    @lang["en"]{@emph{While}. Avoid the indiscriminate use of this word for @emph{and}, @emph{but}, and @emph{although}. Many writers use it frequently as a substitute for @emph{and} or @emph{but}, either from a mere desire to vary the connective or from doubt about which of the two connectives is more appropriate. In this use it is best replaced by a semicolon.}
    @lang["zh-Hans"]{@emph{While}。避免不加区别地用这个词来代替@emph{and}、@emph{but}和@emph{although}。许多作者频繁用它来替代@emph{and}或@emph{but}，要么只是想让连词有些变化，要么是不确定这两个连词哪个更合适。在这种用法中，最好用分号代替它。}
  }

  @itemize{
    @item{误：The office and salesrooms are on the ground floor, while the rest of the building is used for manufacturing.}
    @item{正：The office and salesrooms are on the ground floor; the rest of the building is used for manufacturing.}
  }

  @bi{
    @lang["en"]{Its use as a virtual equivalent of @emph{although} is allowable in sentences where this leads to no ambiguity or absurdity.}
    @lang["zh-Hans"]{在不会导致歧义或荒谬的句子里，把它当作@emph{although}的近乎对等的词使用是允许的。}
  }

  @blockquote{While I admire his energy, I wish it were employed in a better cause.}

  @bi{
    @lang["en"]{This is entirely correct, as shown by the paraphrase}
    @lang["zh-Hans"]{这完全正确，如下面的改写所示：}
  }

  @blockquote{I admire his energy; at the same time, I wish it were employed in a better cause.}

  @bi{
    @lang["en"]{Compare:}
    @lang["zh-Hans"]{比较：}
  }

  @blockquote{While the temperature reaches 90 or 95 degrees in the daytime, the nights are often chilly.}

  @bi{
    @lang["en"]{The paraphrase shows why the use of @emph{while} is incorrect:}
    @lang["zh-Hans"]{下面的改写表明，为什么这里的@emph{while}用得不正确：}
  }

  @blockquote{The temperature reaches 90 or 95 degrees in the daytime; at the same time the nights are often chilly.}

  @bi{
    @lang["en"]{In general, the writer will do well to use @emph{while} only with strict literalness, in the sense of "during the time that."}
    @lang["zh-Hans"]{总的来说，作者最好只在严格的字面意义上使用@emph{while}，即"during the time that"（在……这段时间里）。}
  }
}

@subtree[#:id "strunk1999-usage-wise"]{
  @title{-wise}

  @bi{
    @lang["en"]{@emph{-wise}. Not to be used indiscriminately as a pseudosuffix: @emph{taxwise}, @emph{pricewise}, @emph{marriagewise}, @emph{prosewise}, @emph{saltwater taffy wise}. Chiefly useful when it means "in the manner of": @emph{clockwise}. There is not a noun in the language to which @emph{-wise} cannot be added if the spirit moves one to add it. The sober writer will abstain from the use of this wild additive.}
    @lang["zh-Hans"]{@emph{-wise}。不要不加区分地把它当作伪后缀来用：@emph{taxwise}、@emph{pricewise}、@emph{marriagewise}、@emph{prosewise}、@emph{saltwater taffy wise}。它主要是在意为"in the manner of"（以……的方式）时有用：@emph{clockwise}。只要一时兴起，英语里没有一个名词是不能加上@emph{-wise}的。清醒的作者会戒绝使用这个放荡不羁的附加成分。}
  }
}

@subtree[#:id "strunk1999-usage-worth-while"]{
  @title{Worth while}

  @bi{
    @lang["en"]{@emph{Worth while}. Overworked as a term of vague approval and (with @emph{not}) of disapproval. Strictly applicable only to actions: "Is it worth while to telegraph?"}
    @lang["zh-Hans"]{@emph{Worth while}。作为表达含糊赞许的词（与@emph{not}连用时表示不赞许），用得过滥。严格来说只适用于行为："Is it worth while to telegraph?"}
  }

  @itemize{
    @item{误：His books are not worth while.}
    @item{正：His books are not worth reading (are not worth one's while to read; do not repay reading).}
  }

  @bi{
    @lang["en"]{The adjective @emph{worthwhile} (one word) is acceptable but emaciated. Use a stronger word.}
    @lang["zh-Hans"]{形容词@emph{worthwhile}（一个词）可以接受，但苍白无力。用一个更有力的词吧。}
  }

  @itemize{
    @item{误：a worthwhile project}
    @item{正：a promising (useful, valuable, exciting) project}
  }
}

@subtree[#:id "strunk1999-usage-would"]{
  @title{Would}

  @bi{
    @lang["en"]{@emph{Would}. Commonly used to express habitual or repeated action. ("He would get up early and prepare his own breakfast before he went to work.") But when the idea of habit or repetition is expressed, in such phrases as @emph{once a year}, @emph{every @bold{day,}}, @emph{each Sunday}, the past tense, without @emph{would}, is usually sufficient, and, from its brevity, more emphatic.}
    @lang["zh-Hans"]{@emph{Would}。常用于表达习惯性或重复的动作。（"He would get up early and prepare his own breakfast before he went to work."）但当习惯或重复的意思已由@emph{once a year}、@emph{every @bold{day,}}、@emph{each Sunday}这类短语表达出来时，不用@emph{would}的过去时通常就够了，而且由于简短，更有力。}
  }

  @itemize{
    @item{误：Once a year he would visit the old mansion.}
    @item{正：Once a year he visited the old mansion.}
  }

  @bi{
    @lang["en"]{In narrative writing, always indicate the transition from the general to the particular—that is, from sentences that merely state a general habit to those that express the action of a specific day or period. Failure to indicate the change will cause confusion.}
    @lang["zh-Hans"]{在叙事写作中，务必标出从一般到个别的过渡——也就是从仅仅陈述一般习惯的句子，过渡到表达某个特定日子或时期行动的句子。不标出这种变化会造成混乱。}
  }

  @blockquote{Townsend would get up early and prepare his own breakfast. If the day was cold, he filled the stove and had a warm fire burning before he left the house. On his way out to the garage, he noticed that there were footprints in the new-fallen snow on the porch.}

  @bi{
    @lang["en"]{The reader is lost, having received no signal that Townsend has changed from a mere man of habit to a man who has seen a particular thing on a particular day.}
    @lang["zh-Hans"]{读者会迷失，因为他没有收到任何信号，表明Townsend已经从仅仅是个有习惯的人，变成了在某一天看到某件特定事物的人。}
  }

  @blockquote{Townsend would get up early and prepare his own breakfast. If the day was cold, he filled the stove and had a warm fire burning before he left the house. One morning in January, on his way out to the garage, he noticed footprints in the new-fallen snow on the porch.}
}
