@(define-module (flora queries)
  #:use-module (ice-9 format)
  ;; 只取本模块用到的关系目标:关系级 term-definition-conflicts/
  ;; undefined-term-mentions 与 (forester site) 的森林级版本重名,
  ;; select 过滤后警告消失、森林级版本生效。
  #:use-module ((forester relations)
                #:select (nodeo node-propertyo source-locationo
                          math-containing-paragrapho shorter-than-o))
  #:use-module (forester site)
  #:use-module (grove relation dsl)
  #:use-module (grove ir)
  #:use-module (grove site)
  #:use-module ((forester commands) #:select (forest-query))
  #:use-module (flora commands)
  #:use-module (srfi srfi-1))

@title{flora queries：站点分析管线}
@summary{analyze-flora 的定义：解析作者标记、运行Forest查询并检测孤儿页面。}
@taxon["reference"]

Grove 在所有页面读取完毕后调用一次 @code{analyze-flora}：此刻全站内容可查，适合做跨页面的改写与统计。分析阶段先把作者标记解析为普通链接，并把 Flora 的查询命令降为 Forester 的 @code{forest-query}；随后只构造一次 Forest。查询在完整关系索引建立后运行，结果只加入展示内容，不回写查询所用的作者内容图。命令词汇表见 @link["commands"]{flora commands}。

@subtree[#:id "lib-queries-author"]{
  @title{author 标记的解析}

  @code{flora-author} 元素携带 @code{target} 属性（人物树 id）。分析阶段从完整输入站点按 id 查找人物页面，用其标题生成普通链接，所以全名只在人树存一处。作者链接在 Forest 建立前解析，因此也会参与入链、孤儿等关系查询。目标缺失时回退为裸 id 并告警。
}

@subtree[#:id "lib-queries-relations"]{
  @title{关系查询：入链与孤儿}

  关系 DSL 以逻辑变量描述「什么算一条关系」：@code{incoming-pageo} 把 link 与 transclude 两种节点都计为指向目标页的入链。孤儿检测是集合差——作者页减去有入链的页；成员判断全部走原生哈希表，逻辑查询只负责收集入链 id，避免页数 × 入链数的二次复杂度。@code{math-query-results} 收集「短于 120 字且含公式」的段落作为改写候选，每次展示前 6 条。
}

@subtree[#:id "lib-queries-terms"]{
  @title{术语索引与漂移}

  定义关系收录 @code{defn} 注册的术语（锚点即规范 term-id，display 为术语加释名）；提及关系收录指向无处解析锚点的 fragment 链接与 @code{term} 标记的提及。下面的索引与漂移报告由Forest查询生成，随语料自动更新——术语表页（@link["glossary"]{glossary}）的第一组条目即按此约定注册。

  标记提及的用法：@term["tree"] 这样裸用，标签取定义的 canonical display；也可以 @term["tree"]{这样覆盖标签}。指向未定义术语时——比如 @term["route"]——行内标为 missing-term 而非死链，并计入下面的 backlog。

  @subtree[#:id "lib-queries-term-index"]{
    @title{已定义术语索引}

    @term-index{}
  }

  @subtree[#:id "lib-queries-term-conflicts"]{
    @title{定义漂移与定义待办}

    @term-conflicts{}
  }
}

@subtree[#:id "lib-queries-expand"]{
  @title{命令降级与站点分析}

  @code{analyze-flora} 递归遍历内容树：@code{flora-author} 变为普通链接，四种Flora查询命令变为原生 @code{forest-query}，其他节点保持原样。Forest随后一次性建立页面、链接与内容关系索引，并在此基础上运行查询。
}

@(begin
  ;; Project predicates over the content and page relation snapshots.
  (defrel (incoming-pageo nodes page-id)
    (fresh (node-id kind)
      (conde
        ((== kind 'link))
        ((== kind 'transclude)))
      (nodeo nodes (node-id node-id) (kind kind))
      (node-propertyo nodes node-id 'target page-id)))

  (define (source-dependencies site)
    (map (lambda (page)
           (make-content-text "" #:source (site-page-source page)))
         (site-pages site)))

  ;; 定义索引:relation 事实即收集序(文档序),词汇表保持 authored 顺序。
  ;; 定义藏在命名 subtree 里,定义页是 subtree 自己的 id(如 glossary-grove),
  ;; 所以每条都链到定义锚点所在的独立路由——统一行为,不做本页特判。
  (define (term-index-results site forest)
    (let* ((rows (relation-facts (term-definition-relation forest)))
           (dependencies (source-dependencies site)))
      (list
        (make-content-element
          'paragraph
          (append
            (list (format #f
                    "以下 ~a 条由语料中的 defn 注册，自动生成、保持语料出现顺序："
                    (length rows)))
            dependencies))
        (make-content-element
          'itemize
          (map
            (lambda (row)
              (let ((page-id (cadr row))
                    (anchor (caddr row))
                    (display-text (cadddr row)))
                (make-content-element
                  'item
                  (list (make-content-element
                          'query-link (list display-text)
                          #:source (site-page-source (require-page forest page-id))
                          #:properties `((target . ,page-id)
                                         (fragment . ,anchor)))))))
            rows)
          #:flow-kind 'block))))

  ;; 冲突:同一 term-id 的多个定义页或不同 display——「漂移」的可查询形式。
  ;; backlog:语料用 fragment 链接指向、但无处解析的 term-id,附提及页。
  (define (term-conflict-results site forest)
    (let* ((conflicts (term-definition-conflicts forest))
           (backlog (undefined-term-mentions forest))
           (dependencies (source-dependencies site)))
      (append
        (list
          (make-content-element
            'paragraph
            (append
              (list (format #f
                      "当前 ~a 个术语存在定义漂移，~a 个术语被提及但无处定义："
                      (length conflicts) (length backlog)))
              dependencies)))
        (map
          (lambda (entry)
            (make-content-element
              'item
              (cons (make-content-text
                      (format #f "~a：" (car entry)))
                    (append-map
                      (lambda (occurrence)
                        ;; 投影带上宿主文章(612de0d):occurrence =
                        ;; (host-id host-title page-id anchor display-text)。
                        ;; 深链仍指向定义页自身路由——裸锚点只在那里成立。
                        (let ((host-title (cadr occurrence))
                              (page-id (caddr occurrence))
                              (anchor (cadddr occurrence))
                              (display-text (list-ref occurrence 4)))
                          (list (make-content-element
                                  'query-link
                                  (list (format #f "~a（~a）" display-text host-title))
                                  #:source (site-page-source
                                             (require-page forest page-id))
                                  #:properties `((target . ,page-id)
                                                 (fragment . ,anchor))))))
                      (cdr entry)))))
          conflicts)
        (map
          (lambda (entry)
            (make-content-element
              'item
              (append
                (list (make-content-text
                        (format #f "~a（尚未定义；提及于 " (car entry))))
                ;; backlog occurrence = (host-id host-title page-id)。
                (append-map
                  (lambda (occurrence)
                    (list (make-content-element
                            'query-link (list (cadr occurrence))
                            #:source (site-page-source
                                       (require-page forest (caddr occurrence)))
                            #:properties `((target . ,(caddr occurrence))))))
                  (cadr entry))
                (list (make-content-text "）")))))
          backlog))))

  (define (query-math-paragraphs forest)
    (let ((nodes (content-node-relation forest)))
      (delete-duplicates
        (run* (node-id page-id position text line column)
          (fresh (file)
            (math-containing-paragrapho nodes node-id)
            (shorter-than-o nodes node-id 120)
            (source-locationo nodes node-id file line column)
            (nodeo nodes
                   (node-id node-id)
                   (page-id page-id)
                   (position position)
                   (text text))))
        (lambda (left right) (= (car left) (car right))))))

  (define (math-query-results site forest)
    (let* ((rows (query-math-paragraphs forest))
           (shown (take rows (min 6 (length rows))))
           (dependencies (source-dependencies site))
           (summary
             (make-content-element
               'paragraph
               (append
                 (list (format #f
                         "匹配到 ~a 个短于 120 字且含公式的段落；下面展示前 ~a 个。"
                         (length rows) (length shown)))
                 dependencies))))
      (list summary
            (make-content-element
              'itemize
              (map (lambda (row)
                     (let* ((page-id (cadr row))
                            (position (caddr row))
                            (text (cadddr row))
                            (line (list-ref row 4))
                            (column (list-ref row 5))
                            (source (site-page-source
                                      (require-page forest page-id))))
                       (make-content-element
                         'item
                         (list
                           (make-content-element
                             'query-link (list page-id) #:source source
                             #:properties `((target . ,page-id)))
                           (make-content-text
                             (format #f " (line ~a, column ~a; IR position ~a): ~a"
                                     line column position text)
                             #:source source)))))
                   shown)
              #:flow-kind 'block))))

  (define (orphan-page-results site forest)
    (let* ((nodes (content-node-relation forest))
           (incoming-page-ids
             (delete-duplicates
               (run* (page-id)
                 (incoming-pageo nodes page-id))
               string=?))
           (incoming-set
             (let ((table (make-hash-table)))
               (for-each (lambda (id) (hash-set! table id #t)) incoming-page-ids)
               table))
           ;; 孤儿检测是集合差：作者页 − 有入链页。在 kanren 里对每个候选
           ;; 页面做列表成员判断会退化为页数 × 入链数的统一量；这里全部
           ;; 用原生哈希表完成，查询只负责收集入链 id。
           (orphans
             (filter-map
               (lambda (page)
                 (and (not (assq-ref (site-page-metadata page) 'inline-subtree))
                      (not (hash-ref incoming-set (site-page-id page)))
                      (list (site-page-id page) (site-page-title page))))
               (site-pages site)))
           (dependencies (source-dependencies site)))
      (if (null? orphans)
          (list (make-content-element
                  'paragraph
                  (append
                    (list "No authored pages currently lack incoming links or transclusions.")
                    dependencies)))
          (list
            (make-content-element
              'paragraph
              (append
                (list (format #f
                        "Found ~a authored pages with no incoming links or transclusions:"
                        (length orphans)))
                dependencies))
            (make-content-element
              'itemize
              (map (lambda (row)
                     (let ((page-id (car row))
                           (title (cadr row)))
                       (make-content-element
                         'item
                         (list
                           (make-content-element
                             'query-link (list title)
                             #:source (site-page-source
                                        (require-page forest page-id))
                             #:properties `((target . ,page-id)))
                           (make-content-text (format #f " (~a)" page-id))))))
                   orphans)
              #:flow-kind 'block)))))
)

@(begin
  (define (author-link site marker)
    ;; Resolve an @author marker to a link whose text is the person tree's
    ;; title from the source site; unknown targets fall back to the bare id
    ;; with a warning.
    (let* ((target (content-element-property marker 'target))
           (person (find (lambda (page)
                           (equal? target (site-page-id page)))
                         (site-pages site))))
      (unless person
        (format (current-error-port)
                "WARNING: @author target is not a known tree: ~a~%" target))
      (make-content-element
        'link
        (list (if person (site-page-title person)
                  (make-content-text target)))
        #:source (content-element-source marker)
        #:properties `((target . ,target)))))

  (define (query-kind content)
    (define (marker-kind child)
      (and (content-element? child)
           (memq (content-element-kind child)
                 '(flora-content-query-results flora-orphan-page-results
                   flora-term-index flora-term-conflicts))
           (content-element-kind child)))
    (cond
      ((marker-kind content) (marker-kind content))
      ((and (content-element? content)
            (eq? (content-element-kind content) 'paragraph))
       (any marker-kind (content-element-children content)))
      (else #f)))

  (define (make-flora-query site kind)
    (let ((query
            (case kind
              ((flora-content-query-results) math-query-results)
              ((flora-orphan-page-results) orphan-page-results)
              ((flora-term-index) term-index-results)
              ((flora-term-conflicts) term-conflict-results)
              (else (error "unknown Flora query command" kind)))))
      (forest-query
        (lambda (forest _page-id)
          (make-content-document (query site forest))))))

  (define (expand-flora-content content site)
    (cond
      ((content-document? content)
       (make-content-document
         (append-map (lambda (child)
                       (expand-flora-content child site))
                     (content-document-children content))
         #:source (content-document-source content)))
      ((content-element? content)
       (if (eq? (content-element-kind content) 'flora-author)
           (list (author-link site content))
           (let ((kind (or (query-kind content)
                           (and (eq? (content-element-kind content) 'paragraph)
                                (any query-kind
                                     (content-element-children content))))))
             (if kind
                 (list (make-flora-query site kind))
                 (list
                   (make-content-element
                     (content-element-kind content)
                     (append-map (lambda (child)
                                   (expand-flora-content child site))
                                 (content-element-children content))
                     #:source (content-element-source content)
                     #:properties (content-element-properties content)
                     #:style (content-element-style content)
                     #:flow-kind (content-element-flow-kind content)))))))
      (else (list content))))

  (define (expand-flora-site site)
    (make-site
      (map (lambda (page)
             (make-site-page
               (site-page-id page)
               (site-page-title page)
               (expand-flora-content (site-page-document page) site)
               #:source (site-page-source page)
               #:metadata (site-page-metadata page)))
           (site-pages site))
      #:title (site-title site)
      #:description (site-description site)
      #:sources (site-sources site)))

  (define-public (analyze-flora site)
    (make-forest (expand-flora-site site)))
)
