@(define-module (flora literate)
  #:use-module (grove ir)
  #:use-module (grove style)
  #:use-module ((forester commands) #:prefix f:)
  #:use-module (flora commands)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (lp forester)
  #:use-module (lp checked)
  #:export (code-chunk chunk-tree chunk-source program-code literate-artifacts)
  #:re-export (program checked-example checked-property checked-error))

@title{flora literate：代码分块与程序装配}
@summary{code-chunk 把 Scheme 定义组合成可装配的块，program-code 把块装配为可运行的程序文件。}
@taxon["reference"]

本模块支撑 @link["lp"]{文学编程}文章的代码组织：一个@emph{块}（chunk）是不可变值——kind、id、标题与 parts；parts 既可以是字符串，也可以是更早定义的块，块引用块，装配时拼接源码。@code{program}/@code{checked-example}/@code{checked-property}/@code{checked-error} 转发自 @code{(lp checked)}，供 LP 文章书写与核验代码。

@subtree[#:id "lib-literate-chunk"]{
  @title{code-chunk：定义一个块}

  用法：@code{@"@"code-chunk["chunk-id" "块标题"]{ … }}（经 LP 的 program 机制书写）。id 必须是短 ASCII 标识符；@code{chunk-source} 把块的 parts 递归拼接成源码字符串。
}

@subtree[#:id "lib-literate-tree"]{
  @title{chunk-tree：块的文档渲染}

  块渲染为带稳定 id 的子树：标题、@code{taxon code}，若引用了其他块则先列一行 @emph{Uses:} 链接，最后以 Scheme 代码块展示拼接后的源码。
}

@subtree[#:id "lib-literate-program"]{
  @title{program-code：装配为程序文件}

  用法：@code{@"@"program-code["example.scm"]{ chunk }}。把块的源码输出为一个带 Scheme 高亮的代码块，并以 @code{literate-output} 属性标记文件名，@code{literate-artifacts}（转发 @code{lp-artifacts}）据此把装配结果作为真正的程序文件放进构建产物。文件名只收 @code{.scm} 的 basename，拒绝路径与隐藏文件。
}

@(begin
  ;; Chunks are immutable values composed of strings and earlier chunks.
  ;; No registry or evaluation of the displayed Scheme is needed.
  (define (chunk? value)
    (and (list? value) (equal? (assq-ref value 'kind) 'flora-code-chunk)))

  (define* (code-chunk id title #:rest parts)
    (unless (and (string? id) (not (string-null? id))
                 (string-every (lambda (c) (or (char<=? #\a c #\z)
                                               (char<=? #\0 c #\9)
                                               (char=? c #\-))) id)
                 (string? title) (not (string-null? title))
                 (every (lambda (part) (or (string? part) (chunk? part))) parts))
      (error "code-chunk needs a short ASCII ID, title, and text or chunks" id))
    `((kind . flora-code-chunk) (id . ,id) (title . ,title) (parts . ,parts)))

  (define (chunk-source chunk)
    (unless (chunk? chunk) (error "expected code chunk" chunk))
    (string-concatenate
      (map (lambda (part) (if (string? part) part (chunk-source part)))
           (assq-ref chunk 'parts))))

  (define (chunk-links chunk)
    (let ((dependencies (delete-duplicates (filter chunk? (assq-ref chunk 'parts)))))
      (and (pair? dependencies)
           (make-content-element 'paragraph
             (cons "Uses: "
               (append-map (lambda (dependency)
                             (list (f:link (assq-ref dependency 'id)
                                           (assq-ref dependency 'title)) " "))
                           dependencies))
             #:style (make-content-style 'literate-uses) #:flow-kind 'block))))

  (define (chunk-tree chunk)
    (let ((links (chunk-links chunk)))
      (apply f:subtree #:id (assq-ref chunk 'id)
        (append (list (f:title (assq-ref chunk 'title)) (f:taxon "code"))
                (if links (list links) '())
                (list (make-content-element 'code-block (list (chunk-source chunk))
                        #:properties '((language . scheme))
                        #:style (make-content-style 'literate-code) #:flow-kind 'block))))))

  (define (program-code filename chunk)
    ;; Output names stay in a dedicated directory; reject paths and extensions.
    (unless (and (string? filename) (string-suffix? ".scm" filename)
                 (not (string-index filename #\/))
                 (not (string-index filename #\\))
                 (not (string-prefix? "." filename)))
      (error "program-code needs a .scm basename" filename))
    (make-content-element 'code-block (list (chunk-source chunk))
      #:properties `((language . scheme) (literate-output . ,filename))
      #:style (make-content-style 'literate-code) #:flow-kind 'block))

  (define literate-artifacts lp-artifacts)
)
