@(define-module (flora commands)
  #:use-module (forester commands)
  #:use-module (forester i18n)
  #:use-module (language scribble command)
  #:use-module (grove render html element)
  #:use-module (grove ir)
  #:use-module (grove ir plain-text)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (srfi srfi-14)
  #:re-export (image tag taxon title subtree transclude summary published updated
               bilingual lang)
  ;; term 与 link 同理:本地定义覆盖 forester 原语。term 是术语提及
  ;; 命令(解析进定义关系),原语的 term 是数学记号构造器,站内未用。
  #:re-export-and-replace (link)
  #:replace (term bi))

@(begin
   (define (term-id text)
     ;; 规范化即锚点 key:转小写、空白折叠为连字符(与 taxon/tag 约定一致)。
     (string-join
       (map string-downcase
           (string-split (string-trim-both text) char-set:whitespace))
       "-"))

   (define-public (defn . rest)
     "Marks the defining occurrence of a term: renders as <dfn> with an
anchor derived from the term text (lowercased, whitespace runs collapsed
to hyphens) and registered in the anchor registry, so fragment links and
term queries can see it. An explicit @defn[#:id \"…\"] overrides the
derived anchor. Make-element validates the anchor per call, so defn
constructs per call instead of a top-level define-once."
     (let extract ((args rest) (explicit #f))
       (if (and (pair? args) (pair? (cdr args)) (keyword? (car args)))
           (extract (cddr args)
                    (if (equal? (car args) #:id) (cadr args) explicit))
           (let* ((body (command-body args))
                  (text (string-trim-both
                          (string-concatenate (map content->plain-text body)))))
             ((make-element #:tag "dfn" #:anchor (or explicit (term-id text))) text)))))

   (define-public (sidenote . body)
     "A margin note anchored where it is authored. The renderer lifts
flora-sidenote elements into the page's margin lane (project #:side-lane),
keeps a numbered superscript marker at the anchor, and gives the lane item
a back-reference; numbering is renderer-assigned, so the command emits no
counter of its own. #:kind is what the lane matches - make-element
defaults the kind to span, which the lift would never see."
     (apply (make-element #:tag "span" #:class "flora-sidenote"
                          #:kind 'flora-sidenote)
            body))))

@(define-public (bi . body)
   "Fold a Flora English–Chinese pair, showing the Chinese translation.
Write @bi{source}{translation}; each body is ordinary Scribble content.
Explicit @lang lanes remain accepted for richly structured or other-language
pairs, and @bilingual is available for the full Forester interface."
   (let* ((content (command-body body))
          (pair (filter (lambda (item)
                          (not (and (string? item)
                                    (string-every char-whitespace? item))))
                        content)))
     (if (and (not (any keyword? body))
              (= (length pair) 2)
              (not (and (bilingual-lane? (car pair))
                        (bilingual-lane? (cadr pair)))))
         (bilingual (lang "en" (car pair)) (lang "zh-Hans" (cadr pair)))
         (apply bilingual body))))

@(define-public (emph . body)
   (set! body (command-body body))
   (make-content-element 'emph body))

@(define-public (author id . ignored)
   "Authorship marker resolving to a person tree (taxon person,
bare-surname id): @author[\"kazmer\"]. The display text is the person
tree's own title, filled in at analyze time by modules/queries.plant."
   (make-content-element 'flora-author '()
     #:properties `((target . ,id))))

@(define-public (figure source alt . rest)
   "Semantic figure: <figure><img/><figcaption>…</figcaption></figure>.
@figure[\"path\" \"alt-text\"]{ caption body } — the bracket arguments
are the image source and its plain-text alternative text; the body is
the caption (typically an @emph figure title followed by the legend)."
   (let* ((caption (command-body rest))
          ;; The reader delivers the braces body as one list argument;
          ;; flatten so its items become figcaption children directly.
          (caption (append-map (lambda (item)
                                 (if (list? item) item (list item)))
                               caption)))
     ((make-element #:tag "figure" #:flow-kind 'block)
      (image source alt)
      (apply (make-element #:tag "figcaption" #:flow-kind 'block)
             caption))))

@(define-public (content-query-results)
   (make-content-element 'flora-content-query-results '() #:flow-kind 'block))

@(define-public (orphan-page-results)
   (make-content-element 'flora-orphan-page-results '() #:flow-kind 'block))

@(define-public (term id . rest)
   "Mark a mention of term ID (a defn-registered anchor): resolved at
analyze against the definition relation — rendered as an anchor to the
canonical definition, labelled with the definition's display text unless
the body overrides it. A term nothing defines stays inline as
missing-term and lands in the backlog report, never a dead link.
@term[\"tree\"] or @term[\"tree\"]{树}. Emits a query-link: plain
links must carry a resolvable page target, which a mention does not
know at authoring time."
   (make-content-element 'query-link (command-body rest)
     #:properties `((term . ,id))))

@(define-public (term-index)
   (make-content-element 'flora-term-index '() #:flow-kind 'block))

@(define-public (term-conflicts)
   (make-content-element 'flora-term-conflicts '() #:flow-kind 'block))

@title{flora commands：站点命令库}
@summary{全站共用内容命令的定义与用法：双语块、作者标注、语义插图、边注与术语定义。}
@taxon["reference"]

本模块是 Flora 的命令词汇表，各页面在 @code{use-modules} 中引入 @code{(flora commands)}。本页逐个说明命令的来源与用法；定义在各节的说明之后，构建时求值。转发自 Grove/Forester 原语的命令（@code{image}、@code{tag}、@code{taxon}、@code{title}、@code{subtree}、@code{transclude}、@code{summary}、@code{published}、@code{updated}、@code{bilingual}、@code{lang}、@code{term}）本页不再重复，另见 @link["grove"]{Grove 文档}。

@subtree[#:id "lib-bi"]{
  @title{bi：段落级双语折叠块}

  用法：@code{@"@"bi{The source paragraph.}{译文段落。}}。第一个body固定为英文原文，第二个body固定为简体中文译文；两侧都可写普通内容命令。中文默认显示，英文折叠。需要其他语种或自定义多语段落时，直接组合Forester的@code{bilingual}与@code{lang}。译本示例见@link["blazek2005-front"]{任一译本}。

  例如，两侧都能保留各自的强调标记：

  @bi{
    @emph{An emphasized source phrase.}
  }{
    @emph{一段强调译文。}
  }
}

@subtree[#:id "lib-emph"]{
  @title{emph：强调}

  用法：@code{@"@"emph{…}}。转发为 @code{emph} 内容元素，由 CSS 渲染为斜体（@code{span.emph}）。显式定义是为了把命令体的原始结构转成内容值。
}

@subtree[#:id "lib-author"]{
  @title{author：作者标注}

  用法：@code{@"@"author["kazmer"]}——方括号参数是人物树（@code{taxon person}，裸姓氏 id）的 id，不写显示名：链接文本在分析期从人树标题回填，全名只存于 kazmer.plant 一处。目标树不存在时回退为裸 id 并在构建时告警。实现为占位元素 @code{flora-author}，回填逻辑见 @link["queries"]{flora queries}。
}

@subtree[#:id "lib-figure"]{
  @title{figure：语义插图}

  用法：@code{@"@"figure["blazek2005/fig-2-1.png" "图2.1:……"]{ @"@"emph{图2.1:……。}图例…… }}。方括号参数是图片路径与纯文本替代文本（替代文本内不能放链接），body 是图题——通常以 @emph{图 X.Y:…} 开头，后接图例。渲染为 @code{figure > img + figcaption}，样式见 @code{.article img} 与 @code{figcaption}。全书插图均由此命令书写。
}

@subtree[#:id "lib-sidenote"]{
  @title{sidenote：页边注}

  用法：@code{@"@"sidenote{译注：……}}。渲染期由 Grove 抬入页面级边注 lane（project 的 @code{#:side-lane}）：锚点处保留编号上标，注释本体按文档序收进 @code{.margin-lane}，各带回链——编号由渲染器分配，命令本身不产生计数。原书排印疑误的提醒用它书写。
}

@subtree[#:id "lib-defn"]{
  @title{defn：术语定义}

  用法：@code{@"@"defn{术语}}。渲染为 @code{dfn} 并派生锚点——锚点 id 由术语文本规范化而来（转小写、空白折叠为连字符，@code{term-id}），注册进锚点注册表：fragment 链接校验与「术语在哪定义」类查询从此可见。需要显式指定锚点时用 @code{@"@"defn[#:id "…"]{术语}} 覆盖派生值——比如 @defn[#:id "term-anchor-demo"]{显式锚点} 的锚点就是 @code{term-anchor-demo}，而非派生值。锚点逐次派生（@code{make-element} 在调用时校验），同一术语多处定义会共享同一锚点。Forester 从这些定义建立 term-definition 关系；Flora 的术语索引与漂移报告直接查询该关系。
}

@subtree[#:id "lib-query-markers"]{
  @title{查询占位命令}

  @code{content-query-results} 与 @code{orphan-page-results} 是两个内部占位命令：页面里放一个空标记，分析阶段（见 @link["queries"]{flora queries}）把标记替换为实际的查询结果。它们不面向正文写作。
}
