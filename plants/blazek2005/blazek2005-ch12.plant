@use-commands{flora}

@title{Description of the Source Codes 源代码说明}
@summary{随书源代码的组织与各程序的功能说明。}
@taxon["chapter"]

@bi{
  @lang["en"]{The accompanying CD-ROM contains the source codes of several 1-D and 2-D flow solvers and grid generators. Provided are also input datasets and grids for various 1-D and 2-D examples of flow cases. Furthermore, there are two programs for the von Neumann stability analysis of explicit and implicit time-stepping schemes. Finally, a graphical tool is provided for the visualisation and printing of the results. In total, the CD-ROM comprises more than 60 MBytes of source codes and data.}
  @lang["zh-Hans"]{随书CD-ROM包含若干1-D与2-D流动求解器以及网格生成器的源代码，还提供了用于各种1-D与2-D流动算例的输入数据集和网格。此外，还有两个程序用于对显式与隐式时间推进格式作von Neumann稳定性分析。最后，提供了一个用于结果显示与打印的图形工具。CD-ROM共包含60多兆字节（MBytes）的源代码和数据。}
}

@bi{
  @lang["en"]{The aim of the software is to demonstrate how to translate the theoretical principles of the computational fluid dynamics, which were presented in the previous chapters, into a computer code. The programs should be conceived as a basis for further experimentation and enhancements. The source codes are provided under the terms of the GNU General Public License, which means that they may be freely copied and re-distributed free of charge. See the file LICENSE in one of the directories for more details.}
  @lang["zh-Hans"]{这些软件的目的在于演示如何把前几章所介绍的计算流体力学理论原理转化为计算机代码。这些程序应被视为进一步试验和改进的基础。源代码按GNU通用公共许可证（GNU General Public License）的条款提供，这意味着可以自由复制并无偿再分发。详情参见某个目录中的@code{LICENSE}文件。}
}

@bi{
  @lang["en"]{The source codes of the flow solvers and grid generators are written in standard FORTRAN-77 language with the exception of REAL*8 statements and few inline comments (@code{! ...}). However, this presents in general no problem to recent FORTRAN-77 or even FORTRAN-90 compilers. The programs do not contain any system calls or references to external libraries. The source codes are kept as simple as possible, but still flexible enough. No attempts were made to optimise for the execution speed or the memory. Where applicable, vectors of major variables (conservative variables, coordinates, metrics, residuals, etc.) are dimensioned in the main program @code{main.f} and then passed to the subroutines via parameter lists. The same holds also for the "dummy" vector @code{dum}, which is employed to store temporary variables. This means that the dimensions of the problem are to be set only in the main program, which has then to be recompiled. With a few exceptions, the source codes are organised in such a way that there is just one subroutine or function per file.}
  @lang["zh-Hans"]{流动求解器与网格生成器的源代码以标准FORTRAN-77语言写成，仅有@code{REAL*8}语句和少量行内注释（@code{! ...}）例外。不过，这对新近的FORTRAN-77乃至FORTRAN-90编译器来说一般都不成问题。程序不包含任何系统调用，也不引用外部库。源代码尽可能保持简单，但仍具有足够的灵活性。没有为执行速度或内存作任何优化。在适用的情形下，主要变量（守恒变量、坐标、度量系数、残差等）的向量都在主程序@code{main.f}中定维，然后通过参数表传递给各子程序。用于存放临时变量的“哑”向量@code{dum}也是如此。这意味着问题的维数只需在主程序中设定，然后重新编译主程序即可。除少数例外，源代码的组织方式是每个文件只放一个子程序或函数。}
}

@bi{
  @lang["en"]{All grid, solution and convergence files are stored in a plain ASCII format. The convergence and the solution files are written out in a form suitable for visualisation with the program Vis2D, which is also contained on the CD-ROM. The format of the convergence and solution files is always the same - there is one column for each variable. The names of the variables are given in the header. In the case of the solution files generated by the unstructured flow solver, the indices of the nodes of each element are stored after the coordinates and the flow quantities. The first column represents node 1, the second one node 2, etc. The file format is described in detail in the documentation of Vis2D. Because of its simple form, the format can be easily adapted for other visualisation tools if necessary.}
  @lang["zh-Hans"]{所有网格文件、解文件和收敛文件都以纯ASCII格式存储。收敛文件和解文件以适合用程序Vis2D进行可视化的形式写出，Vis2D同样包含在CD-ROM上。收敛文件与解文件的格式总是相同的——每个变量占一列，变量的名称在文件头中给出。对于由非结构流动求解器生成的解文件，每个单元各节点的索引存储在坐标和流动量之后：第一列代表节点1，第二列代表节点2，依此类推。该文件格式在Vis2D的文档中有详细描述。由于其形式简单，必要时可以方便地改用于其他可视化工具。}
}

@bi{
  @lang["en"]{The directory structure on the CD-ROM consists of two highest-level directories @code{mswin} and @code{unix}. Both directories contain the same data, but in the first case formatted for MS Windows¹, and in the second case for UNIX (also Linux and Mac OS X). The CD-ROM itself is formatted according to the ISO-9660 file system with Rock Ridge and Joliet extensions. The format is fully compatible to UNIX, Linux, Windows and Mac OS X operating systems.}
  @lang["zh-Hans"]{CD-ROM上的目录结构包含两个最高层目录@code{mswin}和@code{unix}。两个目录包含相同的数据，只是前者的数据按MS Windows¹格式组织，后者按UNIX（也包括Linux和Mac OS X）格式组织。CD-ROM本身按带Rock Ridge与Joliet扩展的ISO-9660文件系统格式化。该格式与UNIX、Linux、Windows和Mac OS X操作系统完全兼容。}
}

@emph{¹原书脚注:where applicable, names are registered trademarks of their respective owners(在适用的情形下，所提及的名称均为其各自所有者的注册商标。)}

@bi{
  @lang["en"]{Within either the main @code{mswin} or @code{unix} directory, you will find the following subdirectories:
    @itemize{
      @item{@code{analysis} – von Neumann stability analysis of 1-D model equations}
      @item{@code{graphics} – visualisation tool with GUI}
      @item{@code{grid1d} – 1-D grid generation (Laval nozzle)}
      @item{@code{grid2ds} – 2-D structured grid generation for external and internal flows}
      @item{@code{grid2du} – conversion of 2-D structured into unstructured triangular grids}
      @item{@code{struct1d} – solution of quasi 1-D Euler equations (nozzle flow); demonstration of the multigrid method}
      @item{@code{struct2d} – solution of 2-D Euler / Navier-Stokes equations on structured grids}
      @item{@code{unstr2d} – solution of 2-D Euler / Navier-Stokes equations on unstructured triangular grids.}
    }
  }
  @lang["zh-Hans"]{在主目录@code{mswin}或@code{unix}之下，可以看到下列子目录：
    @itemize{
      @item{@code{analysis}——1-D模型方程的von Neumann稳定性分析；}
      @item{@code{graphics}——带GUI的可视化工具；}
      @item{@code{grid1d}——1-D网格生成（拉瓦尔喷管）；}
      @item{@code{grid2ds}——外部与内部流动的2-D结构网格生成；}
      @item{@code{grid2du}——2-D结构网格到非结构三角网格的转换；}
      @item{@code{struct1d}——准一维Euler方程的求解（喷管流动）；多重网格方法的演示；}
      @item{@code{struct2d}——结构网格上2-D Euler/Navier-Stokes方程的求解；}
      @item{@code{unstr2d}——非结构三角网格上2-D Euler/Navier-Stokes方程的求解。}
    }
  }
}

@bi{
  @lang["en"]{The contents of the above subdirectories is further explained in the sections below. In general, the subdirectory of each simulation code contains a @code{README} file (always in the same place as the sources). It describes the particular files, how to compile and to run the application, and how the results are stored. Additionally, the @code{README} file explains the meaning of the main variables and of the input parameters. In the case of the flow solvers (i.e., @code{struct1d}, @code{struct2d} and @code{unstr2d}), the @code{README} file shows also the call tree. The subdirectory of each flow solver contains the directory @code{run}, where you can find input files, grids, solutions, and graphics for the various demonstration cases.}
  @lang["zh-Hans"]{上述各子目录的内容将在下文各节中进一步说明。一般而言，每个模拟代码的子目录中都包含一个@code{README}文件（总是与源代码放在一起）。它描述了具体的文件、如何编译和运行程序，以及结果如何存储。此外，@code{README}文件还解释了主要变量和输入参数的含义。对于流动求解器（即@code{struct1d}、@code{struct2d}和@code{unstr2d}），@code{README}文件还给出了调用树（call tree）。每个流动求解器的子目录中都包含目录@code{run}，其中可以找到各种演示算例的输入文件、网格、解和图形。}
}

@bi{
  @lang["en"]{The last remark concerns the convergence history. The convergence of all flow solvers provided here is measured as the 2-norm of the difference of the density variable from two consecutive time steps, i.e.,}
  @lang["zh-Hans"]{最后一点说明与收敛历史有关。这里提供的所有流动求解器，都以密度变量在相继两个时间步之差的2-范数来度量收敛，即}
}

@tex-display-math[#:id "eq-12-1"]{\|\Delta\rho\|_{2} = \sqrt{\sum_{I=1}^{N}\left(\rho_I^{\,n+1}-\rho_I^{\,n}\right)^{2}}\,. \tag{12.1}}

@bi{
  @lang["en"]{The summation is carried out over all @tex-math{N} control volumes. It is convenient to normalise the convergence measure in Eq. @link["blazek2005-ch12#eq-12-1"]{(12.1)} with its value from the first iteration. The programs store the normalised convergence history directly in logarithmic scale.}
  @lang["zh-Hans"]{求和遍及全部@tex-math{N}个控制体。用第一次迭代时的值对式@link["blazek2005-ch12#eq-12-1"]{(12.1)}的收敛度量作归一化会比较方便。程序直接以对数刻度存储归一化后的收敛历史。}
}

@subtree[#:id "blazek2005-12-1"]{
  @title{12.1 Programs for Stability Analysis 稳定性分析程序}

  @bi{
    @lang["en"]{The directory @code{mswin\analysis} or @code{unix/analysis} contains two programs for the von Neumann stability analysis (Section 10.3) of linear 1-D model equations. The first program computes the Fourier symbol and the magnitude of the amplification factor for the explicit multistage time-stepping scheme (Subsection 6.1.1) and the hybrid scheme (Subsection 6.1.2). The source code is provided in the subdirectory @code{mstage}. The second program analyses the damping properties of a general implicit scheme (Section 6.2). It is contained in the subdirectory @code{implicit}. Both programs can deal with either the 1-D convection or the 1-D convection-diffusion model equation (Subsections 10.3.2 and 10.3.3). The spatial discretisation can be conducted either by the central scheme with artificial dissipation, by the 1st-order upwind, or by the 2nd-order upwind scheme, respectively. The same schemes can be also applied to the implicit operator. In the case of the explicit scheme, the effect of the (central or upwind) implicit residual smoothing (Section 9.3) can be investigated as well.}
    @lang["zh-Hans"]{目录@code{mswin\analysis}或@code{unix/analysis}包含两个程序，用于对线性1-D模型方程作von Neumann稳定性分析（10.3节）。第一个程序计算显式多级时间推进格式（6.1.1小节）和混合格式（6.1.2小节）的Fourier符号与放大因子的模，其源代码在子目录@code{mstage}中。第二个程序分析一般隐式格式（6.2节）的阻尼特性，位于子目录@code{implicit}中。两个程序都可以处理1-D对流或1-D对流-扩散模型方程（10.3.2和10.3.3小节）。空间离散可以分别采用带人工耗散的中心格式、一阶上风格式或二阶上风格式。同样的格式也可应用于隐式算子。对于显式格式，还可以研究（中心或上风的）隐式残差光顺（9.3节）的影响。}
  }
}

@subtree[#:id "blazek2005-12-2"]{
  @title{12.2 Structured 1-D Grid Generator 结构1-D网格生成器}

  @bi{
    @lang["en"]{The directory @code{mswin\grid1d} or @code{unix/grid1d} contains a program for the generation of 1-D structured grids. Each grid node is associated with a certain area. The area distribution along the @tex-math{x}-axis corresponds to the Laval nozzle. The area of the nozzle is evaluated using the relation}
    @lang["zh-Hans"]{目录@code{mswin\grid1d}或@code{unix/grid1d}包含一个生成1-D结构网格的程序。每个网格节点都与一定的横截面积相关联，沿@tex-math{x}轴的面积分布对应于拉瓦尔喷管（Laval nozzle）。喷管面积用下式计算：}
  }

  @tex-display-math[#:id "eq-12-2"]{\begin{aligned}
A(x) &= 1+\frac{1}{2}\left(A_1-1\right)\left\{1+\cos\left(\frac{\pi x}{x_{thr}}\right)\right\} & \text{for }\ 0\le x\le x_{thr}\\[0.8ex]
A(x) &= 1+\frac{1}{2}\left(A_2-1\right)\left\{1-\cos\left[\frac{\pi\left(x-x_{thr}\right)}{1-x_{thr}}\right]\right\} & \text{for }\ x_{thr}<x\le 1,
\end{aligned} \tag{12.2}}

  @bi{
    @lang["en"]{where @tex-math{x_{thr}} denotes the location of the throat. The length of the nozzle is supposed to be one. Furthermore, in Eq. @link["blazek2005-ch12#eq-12-2"]{(12.2)} @tex-math{A_1} represents the inlet area and @tex-math{A_2} the outlet area (see the sketch in Fig. 12.1). The area of the throat results from Eq. @link["blazek2005-ch12#eq-12-2"]{(12.2)} to @tex-math{A^{*}(x=x_{thr})=1}. The grid generated by this program serves as an input to the quasi 1-D Euler solver from Section 12.5.}
    @lang["zh-Hans"]{其中@tex-math{x_{thr}}表示喉道的位置。喷管长度取为1。此外，式@link["blazek2005-ch12#eq-12-2"]{(12.2)}中的@tex-math{A_1}为入口面积，@tex-math{A_2}为出口面积（见图12.1中的示意图）。由式@link["blazek2005-ch12#eq-12-2"]{(12.2)}可得喉道面积为@tex-math{A^{*}(x=x_{thr})=1}。该程序生成的网格作为12.5节准一维Euler求解器的输入。}
  }

  @figure["blazek2005/fig-12-1.png" "图12.1:1-D Euler求解器的网格与控制体"]{
  @emph{图12.1:1-D Euler求解器的网格与控制体；点@tex-math{i=1}与@tex-math{i=imax}为虚点（dummy points）。}图例：flow——流动方向；@tex-math{A_1}——入口面积；@tex-math{A_2}——出口面积；@tex-math{A_{i+1/2}}——控制体面上的横截面积；control volume——控制体；实心圆点——内部网格点（编号2至ib2）；空心圆点（点1与imax）——虚点。
}}

@subtree[#:id "blazek2005-12-3"]{
  @title{12.3 Structured 2-D Grid Generators 结构2-D网格生成器}

  @bi{
    @lang["en"]{The directory @code{mswin\grid2ds} or @code{unix/grid2ds} contains three programs for the generation of 2-D structured grids for external and internal flows. The first program, which source code is provided in the subdirectory @code{cgrid}, generates a C-type grid (see Subsection 11.1.1) around an airfoil. An example can be seen in Fig. 11.6. The initial grid is generated algebraically by using the linear TFI method Eq. (11.5). Afterwards, elliptic PDE's (Subsection 11.1.3) are employed to produce boundary-orthogonal grid with specified wall spacing. The airfoil contour is approximated by a Bézier spline (see Refs. [1], [2] for an introduction to Bézier splines).}
    @lang["zh-Hans"]{目录@code{mswin\grid2ds}或@code{unix/grid2ds}包含三个程序，用于生成外部与内部流动的2-D结构网格。第一个程序绕翼型生成C型网格（见11.1.1小节），其源代码在子目录@code{cgrid}中；图11.6给出了一个示例。初始网格用线性TFI方法（式(11.5)）以代数方式生成，随后再用椭圆型PDE（11.1.3小节）生成具有指定壁面间距的边界正交网格。翼型外形用Bézier样条逼近（关于Bézier样条的入门介绍可参见文献[1]、[2]）。}
  }

  @bi{
    @lang["en"]{The second program is intended for the generation of an algebraic grid inside a channel with circular bump. The source code can be found in the subdirectory @code{channel}.}
    @lang["zh-Hans"]{第二个程序用于在带圆形鼓包的通道内生成代数网格，其源代码见子目录@code{channel}。}
  }

  @bi{
    @lang["en"]{The next program, which is located in the subdirectory @code{hgrid}, generates an H-type grid (Subsection 11.1.1) for a cascade. An example of grid created by the program is presented in Fig. 11.8. The linear TFI technique (Eq. (11.5)) for algebraic grid generation is employed in this case. The contour of the blade is described again by a Bézier spline.}
    @lang["zh-Hans"]{位于子目录@code{hgrid}中的下一个程序为叶栅生成H型网格（11.1.1小节）。图11.8给出了该程序所生成网格的一个示例。这里同样采用线性TFI技术（式(11.5)）作代数网格生成，叶片外形也仍用Bézier样条描述。}
  }

  @bi{
    @lang["en"]{The programs @code{cgrid} and @code{hgrid} rely on the library provided in the subdirectory @code{srccom}. The library contains routines for spline interpolation, linear TFI, elliptic grid generation and grid stretching.}
    @lang["zh-Hans"]{程序@code{cgrid}与@code{hgrid}依赖于子目录@code{srccom}中提供的库。该库包含样条插值、线性TFI、椭圆网格生成和网格拉伸等子程序。}
  }
}

@subtree[#:id "blazek2005-12-4"]{
  @title{12.4 Structured to Unstructured Grid Converter 结构网格到非结构网格的转换器}

  @bi{
    @lang["en"]{The directory @code{mswin\grid2du} or @code{unix/grid2du} contains a program for the conversion of 2-D structured grids into unstructured triangular grids. The program divides each quadrilateral of the structured grid into two triangles by connecting the diagonal nodes with the shortest distance. The triangulated grids can be used as an input for the unstructured flow solver in Section 12.7.}
    @lang["zh-Hans"]{目录@code{mswin\grid2du}或@code{unix/grid2du}包含一个把2-D结构网格转换为非结构三角网格的程序。该程序通过连接距离最短的一对对角节点，把结构网格的每个四边形分成两个三角形。三角化后的网格可以用作12.7节非结构流动求解器的输入。}
  }
}

@subtree[#:id "blazek2005-12-5"]{
  @title{12.5 Quasi 1-D Euler Solver 准一维Euler求解器}

  @bi{
    @lang["en"]{The directory @code{mswin\struct1d} or @code{unix/struct1d} contains a program for the solution of quasi 1-D Euler equations. The equations govern the inviscid flow in a nozzle or a tube. They can be written in conservative, differential form as [3]}
    @lang["zh-Hans"]{目录@code{mswin\struct1d}或@code{unix/struct1d}包含一个求解准一维Euler方程的程序。这些方程描述喷管或管道中的无黏流动，其守恒微分形式可写为[3]}
  }

  @tex-display-math[#:id "eq-12-3"]{\frac{\partial\vec{W}}{\partial t}+\frac{\partial\vec{F}_c}{\partial x}=\vec{Q}\,. \tag{12.3}}

  @bi{
    @lang["en"]{The vectors of conservative variables, convective fluxes, and the source term read}
    @lang["zh-Hans"]{守恒变量向量、对流通量向量和源项分别为}
  }

  @tex-display-math[#:id "eq-12-4"]{\vec{W}=\begin{bmatrix}\rho A\\ \rho u A\\ \rho E A\end{bmatrix},\qquad \vec{F}_c=\begin{bmatrix}\rho u A\\ \left(\rho u^{2}+p\right)A\\ \rho H u A\end{bmatrix},\qquad \vec{Q}=\begin{bmatrix}0\\ p\,dA/dx\\ 0\end{bmatrix}, \tag{12.4}}

  @bi{
    @lang["en"]{where @tex-math{A} denotes the nozzle area. The total enthalpy @tex-math{H} is given by the formula (2.12), and the pressure results according to Eq. (2.29) from}
    @lang["zh-Hans"]{其中@tex-math{A}表示喷管横截面积。总焓@tex-math{H}由式(2.12)给出，压力则按式(2.29)由下式计算：}
  }

  @tex-display-math[#:id "eq-12-5"]{p=\left(\gamma-1\right)\rho\left(E-\frac{u^{2}}{2}\right). \tag{12.5}}

  @bi{
    @lang["en"]{The governing equations @link["blazek2005-ch12#eq-12-3"]{(12.3)} are discretised on a structured grid using the dual control-volume methodology. A sketch of the grid and of the control volume is displayed in Fig. 12.1. Three different schemes are employed for the spatial discretisation:
      @itemize{
        @item{Central scheme with scalar artificial dissipation (Subsection 4.3.1)}
        @item{CUSP flux-vector splitting scheme (Subsection 4.3.2)}
        @item{Roe's flux-difference splitting scheme (subsection 4.3.3).}
      }
    }
    @lang["zh-Hans"]{控制方程@link["blazek2005-ch12#eq-12-3"]{(12.3)}在结构网格上用对偶控制体方法离散。网格与控制体的示意图见图12.1。空间离散采用三种不同的格式：
      @itemize{
        @item{带标量人工耗散的中心格式（4.3.1小节）；}
        @item{CUSP通量向量分裂格式（4.3.2小节）；}
        @item{Roe通量差分分裂格式（4.3.3小节）。}
      }
    }
  }

  @bi{
    @lang["en"]{The discretised equations are advanced in time using the explicit multistage scheme (Subsection 6.1.1 or 6.1.2). The program uses local time-stepping (Section 9.1) and the central implicit residual smoothing technique (Subsection 9.3.1) for convergence acceleration. The source code can be found in the subdirectory @code{src}, the input files and the results in the subdirectory @code{run}.}
    @lang["zh-Hans"]{离散化的方程用显式多级格式（6.1.1或6.1.2小节）作时间推进。程序采用局部时间步长（9.1节）和中心隐式残差光顺技术（9.3.1小节）来加速收敛。源代码在子目录@code{src}中，输入文件和结果在子目录@code{run}中。}
  }

  @bi{
    @lang["en"]{A second version of the flow solver employs the multigrid method from Section 9.4 for convergence acceleration. The spatial and temporal discretisation schemes are otherwise the same as above. The multigrid scheme uses the FAS formulation for the solution on coarse grids and FMG to initiate the flow on the finest grid. The source code is contained in the subdirectory @code{srcmg}, exemplary input files can be found in the subdirectory @code{runmg}.}
    @lang["zh-Hans"]{流动求解器的第二个版本采用9.4节的多重网格方法加速收敛。除此之外，其空间与时间离散格式与上面相同。该多重网格格式在粗网格上使用FAS（完全近似存储）形式求解，并用FMG（完全多重网格）在最细网格上启动流动。源代码在子目录@code{srcmg}中，示例输入文件在子目录@code{runmg}中。}
  }

  @bi{
    @lang["en"]{The boundary conditions at the inlet and the outlet are implemented in characteristic variables as presented in Section 8.4. The concept of dummy points, described in Section 8.1, is utilised for this purpose (see Fig. 12.1).}
    @lang["zh-Hans"]{入口与出口的边界条件按8.4节所述以特征变量实现。为此利用了8.1节所述的虚点（dummy points）概念（见图12.1）。}
  }
}

@subtree[#:id "blazek2005-12-6"]{
  @title{12.6 Structured 2-D Euler/Navier-Stokes Solver 结构2-D Euler/Navier-Stokes求解器}

  @bi{
    @lang["en"]{The directory @code{mswin\struct2d} or @code{unix/struct2d} contains a program for the solution of 2-D Euler and Navier-Stokes equations on structured body-fitted grids. The spatial discretisation is based on the cell-centred finite-volume approach described in Subsection 4.2.1. It employs the central discretisation scheme with scalar artificial dissipation (Subsection 4.3.1), as well as Roe's upwind scheme presented in Subsection 4.3.3. The governing equations are integrated in time using an explicit multistage scheme (Subsection 6.1.1 or 6.1.2), accelerated by local time-stepping (Section 9.1) and the central implicit residual smoothing (Subsection 9.3.1). The gradients of the velocity components and of the temperature are computed using the dual control-volume approach described in Subsection 4.4.1. In order to keep the code easy to understand, no turbulence model is implemented. The source code of the flow solver is provided in the subdirectory @code{src}.}
    @lang["zh-Hans"]{目录@code{mswin\struct2d}或@code{unix/struct2d}包含一个在结构贴体网格上求解2-D Euler与Navier-Stokes方程的程序。空间离散基于4.2.1小节所述的单元中心型有限体积方法，采用带标量人工耗散的中心离散格式（4.3.1小节）以及4.3.3小节介绍的Roe上风格式。控制方程用显式多级格式（6.1.1或6.1.2小节）作时间积分，并以局部时间步长（9.1节）和中心隐式残差光顺（9.3.1小节）加速。速度分量与温度的梯度用4.4.1小节所述的对偶控制体方法计算。为了保持代码易于理解，程序没有实现湍流模型。流动求解器的源代码在子目录@code{src}中。}
  }

  @bi{
    @lang["en"]{The program utilises the concept of dummy cells (Section 8.1) for the treatment of the boundary conditions. Two layers of dummy cells are employed. A sketch of the grid in the computational domain is displayed in Fig. 12.2 (cf. Fig. 8.1). The program can deal only with single-block grids. However, it is very flexible with respect to the specification and the type of the boundary conditions. The following eight boundary types are provided:
      @itemize{
        @item{Coordinate cut}
        @item{Farfield (optionally with vortex correction)}
        @item{Inflow}
        @item{Outflow}
        @item{Injection}
        @item{Line periodic}
        @item{Solid wall}
        @item{Symmetry.}
      }
    }
    @lang["zh-Hans"]{程序利用虚单元（dummy cells）概念（8.1节）处理边界条件，共使用两层虚单元。计算域中网格的示意图见图12.2（对照图8.1）。程序只能处理单块网格，但在边界条件的设定与类型方面非常灵活。提供下列八种边界类型：
      @itemize{
        @item{坐标切割（coordinate cut）；}
        @item{远场（farfield，可选作涡修正）；}
        @item{入流（inflow）；}
        @item{出流（outflow）；}
        @item{喷注（injection）；}
        @item{线周期（line periodic）；}
        @item{固壁（solid wall）；}
        @item{对称（symmetry）。}
      }
    }
  }

  @bi{
    @lang["en"]{The implementation of the above boundary conditions closely follows the discussion in Chapter 8.}
    @lang["zh-Hans"]{上述边界条件的实现完全遵循第8章中的讨论。}
  }

  @bi{
    @lang["en"]{The four boundaries in the computational space can be divided into an arbitrary number of segments. Each of the segments can be associated with a different boundary condition. This approach is quite similar to the description of block interfaces presented in Section 8.9. In fact, the program could be relatively easily extended to multiblock grids. Definitions of the segments are stored separately from the grid in the topology file (extension @code{.top}).}
    @lang["zh-Hans"]{计算空间中的四条边界可以划分为任意数目的分段，每个分段都可以关联不同的边界条件。这一做法与8.9节所述块界面的描述十分相似。事实上，该程序可以相对容易地扩展到多块网格。分段的定义与网格分开，存储在拓扑文件（扩展名为@code{.top}）中。}
  }

  @bi{
    @lang["en"]{The definition of the face vectors @code{SI} and @code{SJ} (i.e., @tex-math{\vec{n}\cdot\Delta S}) employed in the solver can be seen in Fig. 12.3. The face vectors are associated with the left and the bottom face of the control volume @code{VOL(I,J)} (corresponds to @tex-math{\Omega_{I,J}}). They point outwards of the control volume. The face vectors of the remaining two sides of the control volume are obtained as @code{-SI(I+1,J)} and @code{-SJ(I,J+1)}. In this way, we have to store only two face vectors for each control volume.}
    @lang["zh-Hans"]{求解器中所用面向量@code{SI}与@code{SJ}（即@tex-math{\vec{n}\cdot\Delta S}）的定义见图12.3。面向量与控制体@code{VOL(I,J)}（对应@tex-math{\Omega_{I,J}}）的左面和底面相关联，指向控制体外侧。控制体其余两条边的面向量由@code{-SI(I+1,J)}与@code{-SJ(I,J+1)}得到。这样，每个控制体只需存储两个面向量。}
  }

  @figure["blazek2005/fig-12-2.png" "图12.2:结构2-D Euler/Navier-Stokes求解器在计算空间中的网格"]{
  @emph{图12.2:结构2-D Euler/Navier-Stokes求解器在计算空间中的网格。每条边界处均有两层虚单元（虚线所示）。带圈数字表示计算域的各边。}图例：横轴@tex-math{I}、纵轴@tex-math{J}——计算空间的索引方向；0、1、2——网格线/点编号；@tex-math{J_2}、@tex-math{J_L}、@tex-math{J_M}与@tex-math{I_2}、@tex-math{I_L}、@tex-math{I_M}——物理网格在各方向的界限；①②③④——计算域的下、右、上、左四条边；虚线——虚单元（两层）。
}
  @figure["blazek2005/fig-12-3.png" "图12.3:结构2-D Euler/Navier-Stokes求解器的控制体与面向量"]{
  @emph{图12.3:结构2-D Euler/Navier-Stokes求解器的控制体与面向量。索引@tex-math{(I,J)}表示单元，索引@tex-math{(i,j)}表示网格节点。}图例：@code{VOL(I,J)}——单元@tex-math{(I,J)}的控制体（阴影）；@tex-math{I,J}——该单元的中心；@tex-math{I{+}1,J}——相邻单元的中心；@tex-math{i,j}、@tex-math{i{+}1,j}、@tex-math{i,j{+}1}、@tex-math{i{+}1,j{+}1}——网格节点；@code{SI(I,J)}——左面上指向控制体外侧的面向量；@code{SJ(I,J)}——底面上指向控制体外侧的面向量。
}}

@subtree[#:id "blazek2005-12-7"]{
  @title{12.7 Unstructured 2-D Euler/Navier-Stokes Solver 非结构2-D Euler/Navier-Stokes求解器}

  @bi{
    @lang["en"]{The directory @code{mswin\unstr2d} or @code{unix/unstr2d} contains a program for the solution of 2-D Euler and Navier-Stokes equations on unstructured triangular grids. The median-dual cell-vertex scheme described in Subsection 5.2.2 is utilised for the spatial discretisation. The computation of the convective and viscous fluxes, as well as of the gradients employs an edge-based data structure. The source code can be found in the subdirectory @code{src}.}
    @lang["zh-Hans"]{目录@code{mswin\unstr2d}或@code{unix/unstr2d}包含一个在非结构三角网格上求解2-D Euler与Navier-Stokes方程的程序。空间离散采用5.2.2小节所述的中位对偶单元顶点格式（median-dual cell-vertex scheme）。对流与黏性通量以及梯度的计算都采用基于边的数据结构。源代码在子目录@code{src}中。}
  }

  @bi{
    @lang["en"]{The convective fluxes are evaluated according to Roe's flux-difference splitting scheme (Subsection 4.3.3 and 5.3.2. The solution at the faces of the control volume is obtained by piecewise linear reconstruction of the left and right states as given by Eq. (5.42). The gradients of the flow variables are computed with the Green-Gauss approach (Eqs. (5.49), (5.50)). The reconstructed solution is limited using Venkatakrishnan's limiter described in Subsection 5.3.5 (Eq. (5.67)). The gradients at the faces of the control volume, which are required for the evaluation of the viscous fluxes, are obtained by the methodology presented in Subsection 5.4.2. The discretised governing equations are integrated in time using the explicit multistage scheme (Subsection 6.1.1 or 6.1.2), enhanced by local time-stepping (Section 9.1) and the central implicit residual smoothing (Subsection 9.3.2).}
    @lang["zh-Hans"]{对流通量按Roe通量差分分裂格式计算（4.3.3与5.3.2小节 @sidenote{译注：原书此处印作“(Subsection 4.3.3 and 5.3.2.”，按文义应为“(Subsections 4.3.3 and 5.3.2)”，即原书脱漏了复数形式与右括号。}）。控制体面上的解由左、右状态按式(5.42)作分段线性重构得到。流动变量的梯度用Green-Gauss方法（式(5.49)、(5.50)）计算。重构后的解用5.3.5小节所述的Venkatakrishnan限制器（式(5.67)）加以限制。计算黏性通量所需的控制体面上的梯度，按5.4.2小节介绍的方法求得。离散化的控制方程用显式多级格式（6.1.1或6.1.2小节）作时间积分，并辅以局部时间步长（9.1节）和中心隐式残差光顺（9.3.2小节）。}
  }

  @bi{
    @lang["en"]{The same boundary conditions as described previously for the structured flow solver (except the injection and the coordinate cut) are included. The data structure is such that each boundary face could have a different boundary condition. The implementation of the farfield, inlet and outlet boundary conditions employs the concept of dummy nodes (with one layer). All logical data related to the boundary conditions is stored together with the grid coordinates and the node indices in one file (extension @code{.ugr}).}
    @lang["zh-Hans"]{程序包含与前面结构流动求解器相同的边界条件（喷注与坐标切割除外）。其数据结构使得每个边界面都可以有不同的边界条件。远场、入口与出口边界条件的实现利用了虚节点（dummy nodes）概念（一层）。与边界条件有关的全部逻辑数据，与网格坐标、节点索引一起存储在一个文件（扩展名为@code{.ugr}）中。}
  }
}

@subtree[#:id "blazek2005-12-8"]{
  @title{12.8 Visualisation Tool 可视化工具}

  @bi{
    @lang["en"]{All results of the flow solvers, grid generators and of the stability analysis can be graphically postprocessed using the Vis2D software, which can be found in the directory @code{mswin\graphics} or @code{unix/graphics}. The visualisation tool is controlled via a self-explanatory Graphical User Interface (GUI). It enables the display of @tex-math{x}-@tex-math{y}-diagrams like of the Mach-number distribution in Fig. 12.4. As demonstrated in Fig. 12.5, a second @tex-math{y}-axis can be utilised, for example, to render the convergence data. Vis2D also allows the user to plot structured and unstructured (triangular) grids (Fig. 12.6). Furthermore, contour lines can be displayed in various forms, for example flooded as in Fig. 12.7. It is also possible to plot vector variables, as it is shown in Fig. 12.8 for the velocity field. The number of variables in Vis2D is free, as it is the number of zones (i.e., the number of curves and grids). Individual zones can be switched on or off, translated, and also animated (particularly interesting for unsteady flows). Values of the displayed variables can be probed in various ways. More about the capabilities, the use and about the file format of Vis2D can be found in the subdirectory @code{doc}.}
    @lang["zh-Hans"]{流动求解器、网格生成器和稳定性分析的全部结果都可以用Vis2D软件作图形后处理，该软件位于目录@code{mswin\graphics}或@code{unix/graphics}中。可视化工具通过一目了然的图形用户界面（GUI）进行控制。它可以显示@tex-math{x}-@tex-math{y}图，例如图12.4中的马赫数分布。如图12.5所示，还可以利用第二根@tex-math{y}轴，例如用来绘制收敛数据。Vis2D也允许用户绘制结构与非结构（三角）网格（图12.6）。此外，等值线可以多种形式显示，例如图12.7中的色阶填充（flooded）形式。还可以绘制向量变量，图12.8展示的正是速度场的情形。Vis2D中变量的数目不受限制，区域的数目（即曲线和网格的数目）也是如此。各个区域可以单独打开或关闭、平移，还可以做成动画（对非定常流动特别有用）。所显示变量的值可以通过多种方式探测。关于Vis2D的功能、用法和文件格式的更多信息见子目录@code{doc}。}
  }

  @bi{
    @lang["en"]{The source code of Vis2D is located in the subdirectory @code{src}. It is written in ANSI C and uses the Motif(R) widget set together with the X Window System (X11) for the GUI. Both libraries are standard on UNIX systems. X11 is also the standard graphics library on Linux, and Motif is normally included with the distribution. Otherwise, it can be downloaded for free². If you intend to compile Vis2D for Mac OS X, you will have to install the X11 SDK from Developer Tools CD first, and then also to download and install Motif. Alternatively, compiled versions of Vis2D for Linux and Mac OS X are provided in the subdirectory @code{bin}. They are already statically linked with the libraries, so that only the X11 system needs to be installed and running. The installation on MS Windows requires an X11 emulation³ together with the Motif library.}
    @lang["zh-Hans"]{Vis2D的源代码位于子目录@code{src}中。它以ANSI C写成，GUI使用Motif®部件集和X Window System（X11）。这两个库在UNIX系统上都是标准的。X11也是Linux上的标准图形库，Motif通常随发行版一起提供；否则可以免费下载²。如果要为Mac OS X编译Vis2D，必须先安装Developer Tools CD中的X11 SDK，然后再下载并安装Motif。另一种选择是，@code{bin}子目录中提供了已为Linux和Mac OS X编译好的Vis2D版本，它们已经与库静态链接，因此只需安装并运行X11系统即可。在MS Windows上安装则需要X11仿真³连同Motif库。}
  }

  @emph{²原书脚注:http://www.opengroup.org/openmotif/downloads.html or http://www.motifzone.net(即 http://www.opengroup.org/openmotif/downloads.html 或 http://www.motifzone.net。)}

  @emph{³原书脚注:see, e.g., http://cygwin.com(例如可参见 http://cygwin.com。)}

  @figure["blazek2005/fig-12-4.png" "图12.4:Vis2D中绘制翼型(沿x方向放置)上的马赫数分布"]{
  @emph{图12.4:Vis2D中绘制翼型（沿@tex-math{x}方向放置）上的马赫数分布。}图例：纵轴——Mach number（马赫数）；横轴——@tex-math{x} [m]；带标记的两条曲线为沿翼型的马赫数分布。
}
  @figure["blazek2005/fig-12-5.png" "图12.5:Vis2D中用第二y轴显示收敛数据的示例"]{
  @emph{图12.5:Vis2D中用第二@tex-math{y}轴显示收敛数据的示例。}图例：左纵轴——log(res)（残差对数）；右纵轴——mass ratio（流量比）；横轴——iteration（迭代步数）；曲线图例：convergence history——收敛历史；mass flow ratio——质量流量比。
}
  @figure["blazek2005/fig-12-6.png" "图12.6:Vis2D绘制的非结构三角网格示例"]{
  @emph{图12.6:Vis2D绘制的非结构三角网格示例。}图例：窗口标题为“Channel with 10% circular bump”（含10%圆形鼓包的通道）。
}
  @figure["blazek2005/fig-12-7.png" "图12.7:Vis2D以等值线形式绘制的翼型周围马赫数分布"]{
  @emph{图12.7:Vis2D以等值线（iso-contours）形式绘制的翼型周围马赫数分布。}图例：右侧色标——Mach number（马赫数），色标范围9.818e-02至1.352e+00。
}
  @figure["blazek2005/fig-12-8.png" "图12.8:Vis2D窗口:马赫数等值线叠加速度向量"]{
  @emph{图12.8:Vis2D窗口，显示马赫数等值线并叠加速度向量。}图例：底部色标——Mach number（马赫数），色标值9.818e-02至1.352e+00。
}}
  @emph{Appendix A 附录A}

  本附录汇集正文多处引用的推导:度量项、旋转坐标系、TSL/PNS 近似、通量雅可比、变量变换、GMRES 算法与张量记号。公式编号 (A.N) 与原书一致,正文的 (A.N) 引用可直接点击跳转。

@subtree[#:id "blazek2005-a-1"]{
  @title{A.1 Governing Equations in Differential Form A.1 微分形式的控制方程}

  @bi{
    @lang["en"]{Supposed the convective and viscous fluxes are continuous, the governing equations (2.19) can be transformed from integral to differential form by first applying Gauss's theorem. This leads to}
    @lang["zh-Hans"]{假设对流通量与黏性通量连续，先把Gauss定理应用于控制方程(2.19)，即可将其从积分形式变换为微分形式。由此得到@sidenote{译注：原书句首印作“Supposed”，按文义应为“Supposing”（假设）。}}
  }

  @tex-display-math[#:id "eq-a-1"]{\frac{\partial}{\partial t}\int_{\Omega}\tilde{W}\,d\Omega + \int_{\Omega}\vec{\nabla}\cdot\left(\overline{\overline{F}}_c - \overline{\overline{F}}_v\right)d\Omega = \int_{\Omega}\vec{Q}\,d\Omega, \tag{A.1}}

  @bi{
    @lang["en"]{where @tex-math{\overline{\overline{F}}_c} and @tex-math{\overline{\overline{F}}_v} denote the tensors of the convective and viscous fluxes, respectively. Equation @link["blazek2005-ch12#eq-a-1"]{(A.1)} can then be written for an arbitrary control volume @tex-math{\Omega} in the differential form as}
    @lang["zh-Hans"]{其中@tex-math{\overline{\overline{F}}_c}与@tex-math{\overline{\overline{F}}_v}分别表示对流通量张量与黏性通量张量。于是，对于任意控制体@tex-math{\Omega}，方程@link["blazek2005-ch12#eq-a-1"]{(A.1)}都可以写成如下微分形式}
  }

  @tex-display-math[#:id "eq-a-2"]{\frac{\partial\tilde{W}}{\partial t} + \vec{\nabla}\cdot\left(\overline{\overline{F}}_c - \overline{\overline{F}}_v\right) = \vec{Q}. \tag{A.2}}

  @bi{
    @lang["en"]{In order to account for arbitrary body-fitted grids, we introduce a mapping function between the Cartesian (@tex-math{x}, @tex-math{y}, @tex-math{z}) and a curvilinear (@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta}) coordinate system (cf. Fig. 3.2)}
    @lang["zh-Hans"]{为了适用于任意的贴体网格，在笛卡尔坐标(@tex-math{x}, @tex-math{y}, @tex-math{z})与曲线坐标(@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta})之间引入一个映射函数（参见图3.2）}
  }

  @tex-display-math[#:id "eq-a-3"]{\begin{aligned} \xi &= \xi(x, y, z, t)\\ \eta &= \eta(x, y, z, t)\\ \zeta &= \zeta(x, y, z, t) \end{aligned} \tag{A.3}}

  @bi{
    @lang["en"]{With this, the differential form of the three-dimensional Navier-Stokes equations @link["blazek2005-ch12#eq-a-2"]{(A.2)} transforms into}
    @lang["zh-Hans"]{由此，三维Navier-Stokes方程@link["blazek2005-ch12#eq-a-2"]{(A.2)}的微分形式变换为}
  }

  @tex-display-math[#:id "eq-a-4"]{\frac{\partial\vec{W}^{*}}{\partial t} + \frac{\partial\vec{F}_{c,1}}{\partial\xi} + \frac{\partial\vec{F}_{c,2}}{\partial\eta} + \frac{\partial\vec{F}_{c,3}}{\partial\zeta} = \frac{\partial\vec{F}_{v,1}}{\partial\xi} + \frac{\partial\vec{F}_{v,2}}{\partial\eta} + \frac{\partial\vec{F}_{v,3}}{\partial\zeta} + \vec{Q}^{*}. \tag{A.4}}

  @bi{
    @lang["en"]{The vector of the conservative variables is now given by}
    @lang["zh-Hans"]{此时，守恒变量向量为}
  }

  @tex-display-math[#:id "eq-a-5"]{\vec{W}^{*} = J^{-1}\begin{bmatrix} \rho\\ \rho u\\ \rho v\\ \rho w\\ \rho E \end{bmatrix}. \tag{A.5}}

  @bi{
    @lang["en"]{The vectors of the convective fluxes follow from the relationships}
    @lang["zh-Hans"]{对流通量向量由下列关系式给出}
  }

  @tex-display-math[#:id "eq-a-6"]{\begin{aligned} \vec{F}_{c,1} &= J^{-1}\begin{bmatrix} \rho V_1\\ \rho V_1 u + \xi_x p\\ \rho V_1 v + \xi_y p\\ \rho V_1 w + \xi_z p\\ \rho V_1 H \end{bmatrix}, \quad \vec{F}_{c,2} = J^{-1}\begin{bmatrix} \rho V_2\\ \rho V_2 u + \eta_x p\\ \rho V_2 v + \eta_y p\\ \rho V_2 w + \eta_z p\\ \rho V_2 H \end{bmatrix},\\ \vec{F}_{c,3} &= J^{-1}\begin{bmatrix} \rho V_3\\ \rho V_3 u + \zeta_x p\\ \rho V_3 v + \zeta_y p\\ \rho V_3 w + \zeta_z p\\ \rho V_3 H \end{bmatrix}, \end{aligned} \tag{A.6}}

  @bi{
    @lang["en"]{and the vectors of the viscous fluxes are defined as}
    @lang["zh-Hans"]{而黏性通量向量则定义为}
  }

  @tex-display-math[#:id "eq-a-7"]{\begin{aligned} \vec{F}_{v,1} &= J^{-1}\begin{bmatrix} 0\\ \xi_x\tau_{xx} + \xi_y\tau_{xy} + \xi_z\tau_{xz}\\ \xi_x\tau_{yx} + \xi_y\tau_{yy} + \xi_z\tau_{yz}\\ \xi_x\tau_{zx} + \xi_y\tau_{zy} + \xi_z\tau_{zz}\\ \xi_x\Theta_x + \xi_y\Theta_y + \xi_z\Theta_z \end{bmatrix},\\ \vec{F}_{v,2} &= J^{-1}\begin{bmatrix} 0\\ \eta_x\tau_{xx} + \eta_y\tau_{xy} + \eta_z\tau_{xz}\\ \eta_x\tau_{yx} + \eta_y\tau_{yy} + \eta_z\tau_{yz}\\ \eta_x\tau_{zx} + \eta_y\tau_{zy} + \eta_z\tau_{zz}\\ \eta_x\Theta_x + \eta_y\Theta_y + \eta_z\Theta_z \end{bmatrix},\\ \vec{F}_{v,3} &= J^{-1}\begin{bmatrix} 0\\ \zeta_x\tau_{xx} + \zeta_y\tau_{xy} + \zeta_z\tau_{xz}\\ \zeta_x\tau_{yx} + \zeta_y\tau_{yy} + \zeta_z\tau_{yz}\\ \zeta_x\tau_{zx} + \zeta_y\tau_{zy} + \zeta_z\tau_{zz}\\ \zeta_x\Theta_x + \zeta_y\Theta_y + \zeta_z\Theta_z \end{bmatrix}. \end{aligned} \tag{A.7}}

  @bi{
    @lang["en"]{Finally, the source term transforms to}
    @lang["zh-Hans"]{最后，源项变换为}
  }

  @tex-display-math[#:id "eq-a-8"]{\vec{Q}^{*} = J^{-1}\begin{bmatrix} 0\\ \rho f_{e,x}\\ \rho f_{e,y}\\ \rho f_{e,z}\\ \rho\vec{f}_e\cdot\vec{v} + \dot{q}_h \end{bmatrix}. \tag{A.8}}

  @bi{
    @lang["en"]{where @tex-math{\vec{f}_e} represents the vector of the external body forces.}
    @lang["zh-Hans"]{其中@tex-math{\vec{f}_e}表示外部体力（体积力）向量。}
  }

  @bi{
    @lang["en"]{The contravariant velocities in the @tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta} coordinate directions for a stationary grid are given by the formulae}
    @lang["zh-Hans"]{对于静止网格，@tex-math{\xi}、@tex-math{\eta}、@tex-math{\zeta}坐标方向上的逆变速度由下式给出}
  }

  @tex-display-math[#:id "eq-a-9"]{\begin{aligned} V_1 &= \xi_x u + \xi_y v + \xi_z w\\ V_2 &= \eta_x u + \eta_y v + \eta_z w\\ V_3 &= \zeta_x u + \zeta_y v + \zeta_z w \end{aligned} \tag{A.9}}

  @bi{
    @lang["en"]{The components of the viscous stress tensor and of the thermal fluxes read}
    @lang["zh-Hans"]{黏性应力张量与热通量的各分量为}
  }

  @tex-display-math[#:id "eq-a-10"]{\begin{aligned} \tau_{xx} &= 2\mu\frac{\partial u}{\partial x} + \lambda\left(\frac{\partial u}{\partial x} + \frac{\partial v}{\partial y} + \frac{\partial w}{\partial z}\right)\\ \tau_{yy} &= 2\mu\frac{\partial v}{\partial y} + \lambda\left(\frac{\partial u}{\partial x} + \frac{\partial v}{\partial y} + \frac{\partial w}{\partial z}\right)\\ \tau_{zz} &= 2\mu\frac{\partial w}{\partial z} + \lambda\left(\frac{\partial u}{\partial x} + \frac{\partial v}{\partial y} + \frac{\partial w}{\partial z}\right)\\ \tau_{xy} &= \tau_{yx} = \mu\left(\frac{\partial u}{\partial y} + \frac{\partial v}{\partial x}\right)\\ \tau_{xz} &= \tau_{zx} = \mu\left(\frac{\partial u}{\partial z} + \frac{\partial w}{\partial x}\right)\\ \tau_{yz} &= \tau_{zy} = \mu\left(\frac{\partial v}{\partial z} + \frac{\partial w}{\partial y}\right)\\ \Theta_x &= u\tau_{xx} + v\tau_{xy} + w\tau_{xz} + k\frac{\partial T}{\partial x}\\ \Theta_y &= u\tau_{yx} + v\tau_{yy} + w\tau_{yz} + k\frac{\partial T}{\partial y}\\ \Theta_z &= u\tau_{zx} + v\tau_{zy} + w\tau_{zz} + k\frac{\partial T}{\partial z} \end{aligned} \tag{A.10}}

  @bi{
    @lang["en"]{In the above Eq. @link["blazek2005-ch12#eq-a-10"]{(A.10)}, @tex-math{k} stands for the thermal conductivity coefficient, @tex-math{\mu} for the coefficient of the dynamic viscosity, and @tex-math{\lambda} denotes the second viscosity coefficient (@tex-math{\lambda = -(2/3)\mu} according to Stokes's hypothesis). The diffusive thermal fluxes can also be written in the following modified form}
    @lang["zh-Hans"]{在上面的方程@link["blazek2005-ch12#eq-a-10"]{(A.10)}中，@tex-math{k}表示热导率系数，@tex-math{\mu}表示动力黏度系数，@tex-math{\lambda}表示第二黏性系数（按照Stokes假设，@tex-math{\lambda = -(2/3)\mu}）。扩散热通量也可以写成如下变形形式}
  }

  @tex-display-math[#:id "eq-a-11"]{\begin{aligned} k\frac{\partial T}{\partial x} &= \frac{\mu}{(\gamma - 1)Pr}\frac{\partial c^2}{\partial x}\\ k\frac{\partial T}{\partial y} &= \frac{\mu}{(\gamma - 1)Pr}\frac{\partial c^2}{\partial y}\\ k\frac{\partial T}{\partial z} &= \frac{\mu}{(\gamma - 1)Pr}\frac{\partial c^2}{\partial z} \end{aligned} \tag{A.11}}

  @bi{
    @lang["en"]{with @tex-math{c} representing the speed of sound and @tex-math{Pr} the Prandtl number. The derivatives of the velocity components @tex-math{u}, @tex-math{v}, @tex-math{w} and the temperature @tex-math{T} in Cartesian coordinates @tex-math{x}, @tex-math{y}, @tex-math{z} can be expressed with the aid of the chain rule as derivatives of @tex-math{\xi}, @tex-math{\eta} and @tex-math{\zeta}. For example,}
    @lang["zh-Hans"]{其中@tex-math{c}表示声速，@tex-math{Pr}表示Prandtl数。速度分量@tex-math{u}、@tex-math{v}、@tex-math{w}以及温度@tex-math{T}在笛卡尔坐标@tex-math{x}、@tex-math{y}、@tex-math{z}下的导数，可以借助链式法则写成对@tex-math{\xi}、@tex-math{\eta}、@tex-math{\zeta}的导数。例如}
  }

  @tex-display-math[#:id "eq-a-12"]{\begin{aligned} \frac{\partial u}{\partial x} &= \xi_x\frac{\partial u}{\partial\xi} + \eta_x\frac{\partial u}{\partial\eta} + \zeta_x\frac{\partial u}{\partial\zeta}\\ \frac{\partial u}{\partial y} &= \xi_y\frac{\partial u}{\partial\xi} + \eta_y\frac{\partial u}{\partial\eta} + \zeta_y\frac{\partial u}{\partial\zeta} \end{aligned}, \quad \text{etc.} \tag{A.12}}

  @bi{
    @lang["en"]{The inverse of the determinant of the coordinate transformation Jacobian @tex-math{\partial(\xi, \eta, \zeta)/\partial(x, y, z)} is defined as}
    @lang["zh-Hans"]{坐标变换Jacobian行列式@tex-math{\partial(\xi, \eta, \zeta)/\partial(x, y, z)}的逆定义为}
  }

  @tex-display-math[#:id "eq-a-13"]{\begin{aligned} J^{-1} = {} & \frac{\partial x}{\partial\xi}\frac{\partial y}{\partial\eta}\frac{\partial z}{\partial\zeta} + \frac{\partial x}{\partial\eta}\frac{\partial y}{\partial\zeta}\frac{\partial z}{\partial\xi} + \frac{\partial x}{\partial\zeta}\frac{\partial y}{\partial\xi}\frac{\partial z}{\partial\eta} - {}\\ & - \frac{\partial x}{\partial\xi}\frac{\partial y}{\partial\zeta}\frac{\partial z}{\partial\eta} - \frac{\partial x}{\partial\eta}\frac{\partial y}{\partial\xi}\frac{\partial z}{\partial\zeta} - \frac{\partial x}{\partial\zeta}\frac{\partial y}{\partial\eta}\frac{\partial z}{\partial\xi}. \end{aligned} \tag{A.13}}

  @bi{
    @lang["en"]{Finally, the metric terms are specified through the relations}
    @lang["zh-Hans"]{最后，度量项由下列关系式确定}
  }

  @tex-display-math[#:id "eq-a-14"]{\begin{aligned} \xi_x &= J\left(\frac{\partial y}{\partial\eta}\frac{\partial z}{\partial\zeta} - \frac{\partial y}{\partial\zeta}\frac{\partial z}{\partial\eta}\right)\\ \xi_y &= J\left(\frac{\partial z}{\partial\eta}\frac{\partial x}{\partial\zeta} - \frac{\partial z}{\partial\zeta}\frac{\partial x}{\partial\eta}\right)\\ \xi_z &= J\left(\frac{\partial x}{\partial\eta}\frac{\partial y}{\partial\zeta} - \frac{\partial x}{\partial\zeta}\frac{\partial y}{\partial\eta}\right)\\ \eta_x &= J\left(\frac{\partial y}{\partial\zeta}\frac{\partial z}{\partial\xi} - \frac{\partial y}{\partial\xi}\frac{\partial z}{\partial\zeta}\right)\\ \eta_y &= J\left(\frac{\partial z}{\partial\zeta}\frac{\partial x}{\partial\xi} - \frac{\partial z}{\partial\xi}\frac{\partial x}{\partial\zeta}\right)\\ \eta_z &= J\left(\frac{\partial x}{\partial\zeta}\frac{\partial y}{\partial\xi} - \frac{\partial x}{\partial\xi}\frac{\partial y}{\partial\zeta}\right)\\ \zeta_x &= J\left(\frac{\partial y}{\partial\xi}\frac{\partial z}{\partial\eta} - \frac{\partial z}{\partial\xi}\frac{\partial y}{\partial\eta}\right)\\ \zeta_y &= J\left(\frac{\partial z}{\partial\xi}\frac{\partial x}{\partial\eta} - \frac{\partial x}{\partial\xi}\frac{\partial z}{\partial\eta}\right)\\ \zeta_z &= J\left(\frac{\partial x}{\partial\xi}\frac{\partial y}{\partial\eta} - \frac{\partial y}{\partial\xi}\frac{\partial x}{\partial\eta}\right). \end{aligned} \tag{A.14}}

  @bi{
    @lang["en"]{It is important to see how the above metric terms from Eqs. @link["blazek2005-ch12#eq-a-13"]{(A.13)}, @link["blazek2005-ch12#eq-a-14"]{(A.14)} are related to geometrical quantities like the volume or the face vectors. Let us for this purpose consider a 2-D structured grid, as it is sketched in Fig. A.1. We want further assume that the @tex-math{\xi}-coordinate corresponds to the @tex-math{i}-direction, and the @tex-math{\eta}-coordinate to the @tex-math{j}-direction, respectively. Then, the derivatives of the Cartesian coordinates with respect to the curvilinear coordinates in Eq. @link["blazek2005-ch12#eq-a-14"]{(A.14)} can be approximated at point @tex-math{(i, j)} as}
    @lang["zh-Hans"]{重要的是要弄清，上面@link["blazek2005-ch12#eq-a-13"]{(A.13)}、@link["blazek2005-ch12#eq-a-14"]{(A.14)}两式中的度量项与体积、面向量这类几何量之间有什么关系。为此，考察图A.1所示的二维结构网格。进一步假定@tex-math{\xi}坐标对应@tex-math{i}方向，@tex-math{\eta}坐标对应@tex-math{j}方向。于是，@link["blazek2005-ch12#eq-a-14"]{(A.14)}中笛卡尔坐标对曲线坐标的导数在点@tex-math{(i, j)}处可以近似为}
  }

  @tex-display-math[#:id "eq-a-15"]{\begin{aligned} \left(\frac{\partial x}{\partial\xi}\right)_{i,j} &\approx \frac{\frac{1}{2}\left[(x_{i,j} + x_{i+1,j}) - (x_{i,j} + x_{i-1,j})\right]}{(i + 1/2) - (i - 1/2)} = \frac{1}{2}\left(x_{i+1,j} - x_{i-1,j}\right)\\ \left(\frac{\partial y}{\partial\xi}\right)_{i,j} &\approx \frac{\frac{1}{2}\left[(y_{i,j} + y_{i+1,j}) - (y_{i,j} + y_{i-1,j})\right]}{(i + 1/2) - (i - 1/2)} = \frac{1}{2}\left(y_{i+1,j} - y_{i-1,j}\right) \end{aligned} \tag{A.15}}

  @figure["blazek2005/fig-a-1.png" "图A.1:二维度量项的几何表示"]{
  @emph{图A.1:二维度量项的几何表示。}图例:网格节点@tex-math{(i-1,j)}、@tex-math{(i,j-1)}、@tex-math{(i,j)}、@tex-math{(i+1,j)}、@tex-math{(i,j+1)};@tex-math{|\vec{S}^I|}——@tex-math{i}方向平均面向量(图中两处箭头);@tex-math{\Omega}——控制体(中心阴影菱形);@tex-math{\Omega^{*}}——对偶控制体(外围虚线菱形)。
}
  @bi{
    @lang["en"]{and}
    @lang["zh-Hans"]{以及}
  }

  @tex-display-math[#:id "eq-a-16"]{\begin{aligned} \left(\frac{\partial x}{\partial\eta}\right)_{i,j} &\approx \frac{\frac{1}{2}\left[(x_{i,j} + x_{i,j+1}) - (x_{i,j} + x_{i,j-1})\right]}{(j + 1/2) - (j - 1/2)} = \frac{1}{2}\left(x_{i,j+1} - x_{i,j-1}\right)\\ \left(\frac{\partial y}{\partial\eta}\right)_{i,j} &\approx \frac{\frac{1}{2}\left[(y_{i,j} + y_{i,j+1}) - (y_{i,j} + y_{i,j-1})\right]}{(j + 1/2) - (j - 1/2)} = \frac{1}{2}\left(y_{i,j+1} - y_{i,j-1}\right). \end{aligned} \tag{A.16}}

  @bi{
    @lang["en"]{Thus, using the above approximations of Eqs. @link["blazek2005-ch12#eq-a-15"]{(A.15)} and @link["blazek2005-ch12#eq-a-16"]{(A.16)}, the formulae in Eq. @link["blazek2005-ch12#eq-a-14"]{(A.14)} become}
    @lang["zh-Hans"]{于是，利用@link["blazek2005-ch12#eq-a-15"]{(A.15)}与@link["blazek2005-ch12#eq-a-16"]{(A.16)}的上述近似，@link["blazek2005-ch12#eq-a-14"]{(A.14)}中的公式成为}
  }

  @tex-display-math[#:id "eq-a-17"]{\begin{aligned} \xi_x &= \ J\frac{\partial y}{\partial\eta} \approx J S_x^I\\ \xi_y &= -J\frac{\partial x}{\partial\eta} \approx J S_y^I\\ \eta_x &= -J\frac{\partial y}{\partial\xi} \approx J S_x^J\\ \eta_y &= \ J\frac{\partial x}{\partial\xi} \approx J S_y^J, \end{aligned} \tag{A.17}}

  @bi{
    @lang["en"]{where @tex-math{\vec{S}^I = [S_x^I, S_y^I]^T} denotes the average face vector in @tex-math{i}-direction, and @tex-math{\vec{S}^J = (S_x^J, S_y^J)^T} the vector in @tex-math{j}-direction, respectively (cf. Fig. A.1). The relationships in Eq. @link["blazek2005-ch12#eq-a-17"]{(A.17)} can also be expressed in the form}
    @lang["zh-Hans"]{其中@tex-math{\vec{S}^I = [S_x^I, S_y^I]^T}表示@tex-math{i}方向的平均面向量，@tex-math{\vec{S}^J = (S_x^J, S_y^J)^T}表示@tex-math{j}方向的面向量（参见图A.1）。@link["blazek2005-ch12#eq-a-17"]{(A.17)}中的关系也可以写成}
  }

  @tex-display-math[#:id "eq-a-18"]{\vec{S}^I = J^{-1}\begin{bmatrix} \xi_x\\ \xi_y \end{bmatrix}, \quad \vec{S}^J = J^{-1}\begin{bmatrix} \eta_x\\ \eta_y \end{bmatrix}. \tag{A.18}}

  @bi{
    @lang["en"]{From the above we can see that the metric terms correspond to the components of the face vectors in the finite volume scheme, divided by the determinant of the coordinate transformation Jacobian @tex-math{J}.}
    @lang["zh-Hans"]{由此可以看到，度量项正对应于有限体积格式中面向量的各分量除以坐标变换Jacobian行列式@tex-math{J}。}
  }

  @bi{
    @lang["en"]{The question is now, what is the geometrical interpretation of @tex-math{J^{-1}}? Using Eq. @link["blazek2005-ch12#eq-a-13"]{(A.13)} which reads in two dimensions as}
    @lang["zh-Hans"]{现在的问题是：@tex-math{J^{-1}}的几何解释是什么？利用@link["blazek2005-ch12#eq-a-13"]{(A.13)}在二维情形下的形式}
  }

  @tex-display-math[#:id "eq-a-19"]{J^{-1} = \frac{\partial x}{\partial\xi}\frac{\partial y}{\partial\eta} - \frac{\partial x}{\partial\eta}\frac{\partial y}{\partial\xi}, \tag{A.19}}

  @bi{
    @lang["en"]{and inserting the expressions Eq. @link["blazek2005-ch12#eq-a-17"]{(A.17)} for the metric terms into Eq. @link["blazek2005-ch12#eq-a-19"]{(A.19)}, it can be shown that}
    @lang["zh-Hans"]{并把@link["blazek2005-ch12#eq-a-17"]{(A.17)}的度量项表达式代入@link["blazek2005-ch12#eq-a-19"]{(A.19)}，即可证明}
  }

  @tex-display-math[#:id "eq-a-20"]{J^{-1} = 2\Omega = \frac{1}{2}\Omega^{*}. \tag{A.20}}

  @bi{
    @lang["en"]{The volumes @tex-math{\Omega} and @tex-math{\Omega^{*}} (with constant depth @tex-math{b=1}) are displayed in Fig. A.1. They are defined by the points @tex-math{(i+1/2, j)}, @tex-math{(i, j+1/2)}, @tex-math{(i-1/2, j)}, @tex-math{(i, j-1/2)} in the case of @tex-math{\Omega}, and by the grid nodes @tex-math{(i, j-1)}, @tex-math{(i+1, j)}, @tex-math{(i, j+1)}, @tex-math{(i-1, j)} in the case of @tex-math{\Omega^{*}}, respectively. It should be noted that on a rectangular grid @tex-math{J^{-1}} equals to the dual control volume which was presented in Subsection 4.2.3.}
    @lang["zh-Hans"]{体积@tex-math{\Omega}与@tex-math{\Omega^{*}}（取常深度@tex-math{b=1}）示于图A.1。对于@tex-math{\Omega}，它由点@tex-math{(i+1/2, j)}、@tex-math{(i, j+1/2)}、@tex-math{(i-1/2, j)}、@tex-math{(i, j-1/2)}确定；对于@tex-math{\Omega^{*}}，则由网格节点@tex-math{(i, j-1)}、@tex-math{(i+1, j)}、@tex-math{(i, j+1)}、@tex-math{(i-1, j)}确定。应当注意，在矩形网格上@tex-math{J^{-1}}恰好等于4.2.3小节所引入的对偶控制体。}
  }

  @bi{
    @lang["en"]{The same derivations for the metric terms as above can be conducted in three dimensions. The results are shown in Fig. A.2. The inverse of the determinant of the transformation Jacobian (@tex-math{J^{-1}}) equals to twice the volume defined by the grid nodes @tex-math{(i, j, k-1/2)}, @tex-math{(i+1/2, j, k)}, @tex-math{(i, j, k+1/2)}, @tex-math{(i-1/2, j, k)}, @tex-math{(i, j-1/2, k)}, and @tex-math{(i, j+1/2, k)}. On a rectangular grid, this again corresponds exactly to the dual control volume of Subsection 4.2.3.}
    @lang["zh-Hans"]{上述度量项的推导同样可以在三维情形进行，结果示于图A.2。变换Jacobian行列式的逆（@tex-math{J^{-1}}）等于由网格节点@tex-math{(i, j, k-1/2)}、@tex-math{(i+1/2, j, k)}、@tex-math{(i, j, k+1/2)}、@tex-math{(i-1/2, j, k)}、@tex-math{(i, j-1/2, k)}与@tex-math{(i, j+1/2, k)}所确定的体积的两倍。在矩形网格上，这同样恰好对应4.2.3小节的对偶控制体。}
  }

  @figure["blazek2005/fig-a-2.png" "图A.2:三维度量项的几何表示"]{
  @emph{图A.2:三维度量项的几何表示。}图例:中心网格节点@tex-math{(i,j,k)};面中点节点@tex-math{(i,j,k+1/2)}、@tex-math{(i,j,k-1/2)}、@tex-math{(i+1/2,j,k)}、@tex-math{(i-1/2,j,k)}、@tex-math{(i,j+1/2,k)}、@tex-math{(i,j-1/2,k)};@tex-math{\frac{1}{2}|\vec{S}^I|}、@tex-math{\frac{1}{2}|\vec{S}^J|}、@tex-math{\frac{1}{2}|\vec{S}^K|}——相应坐标方向上面向量之半(图中阴影三角形)。
}}
@subtree[#:id "blazek2005-a-2"]{
  @title{A.2 Quasilinear Form of the Euler Equations A.2 欧拉方程的拟线性形式}

  @bi{
    @lang["en"]{This particular form is instructive in understanding the mathematical properties of the governing equations. It is also useful in the development and analysis of numerical schemes.}
    @lang["zh-Hans"]{这种特殊形式有助于理解控制方程的数学性质，对数值格式的构造与分析也十分有用。}
  }

  @bi{
    @lang["en"]{The quasilinear form is derived from the governing equations in differential formulation @link["blazek2005-ch12#eq-a-4"]{(A.4)}. We will consider here only the Euler equations, i.e.,}
    @lang["zh-Hans"]{拟线性形式由微分形式的控制方程@link["blazek2005-ch12#eq-a-4"]{(A.4)}导出。这里只考虑欧拉方程，即}
  }

  @tex-display-math[#:id "eq-a-21"]{\frac{\partial\vec{W}^{*}}{\partial t} + \frac{\partial\vec{F}_{c,1}}{\partial\xi} + \frac{\partial\vec{F}_{c,2}}{\partial\eta} + \frac{\partial\vec{F}_{c,3}}{\partial\zeta} = 0, \tag{A.21}}

  @bi{
    @lang["en"]{where @tex-math{\vec{W}^{*} = J^{-1}\vec{W}} and the convective fluxes @tex-math{\vec{F}_{c,1/2/3}} are defined in Eq. @link["blazek2005-ch12#eq-a-6"]{(A.6)}. The linearisation replaces the spatial derivatives of the fluxes by derivatives of the conservative variables. For example,}
    @lang["zh-Hans"]{其中@tex-math{\vec{W}^{*} = J^{-1}\vec{W}}，对流通量@tex-math{\vec{F}_{c,1/2/3}}由@link["blazek2005-ch12#eq-a-6"]{(A.6)}定义。线性化把通量的空间导数替换为守恒变量的导数。例如}
  }

  @tex-display-math[#:id "eq-a-22"]{\frac{\partial\vec{F}_{c,1}}{\partial\xi} = \frac{\partial\vec{F}_{c,1}}{\partial\vec{W}}\frac{\partial\vec{W}}{\partial\xi}. \tag{A.22}}

  @bi{
    @lang["en"]{The effect is that the spatial derivatives are now linear functions of the conserved variables. Using the definition of the convective flux Jacobian from Eq. @link["blazek2005-ch12#eq-a-65"]{(A.65)}, we obtain the quasilinear form of the Euler equations}
    @lang["zh-Hans"]{其效果是，空间导数此时成为守恒变量的线性函数。利用@link["blazek2005-ch12#eq-a-65"]{(A.65)}给出的对流通量Jacobian定义，便得到欧拉方程的拟线性形式}
  }

  @tex-display-math[#:id "eq-a-23"]{J^{-1}\frac{\partial\vec{W}}{\partial t} + \bar{A}_{c,1}\frac{\partial\vec{W}}{\partial\xi} + \bar{A}_{c,2}\frac{\partial\vec{W}}{\partial\eta} + \bar{A}_{c,3}\frac{\partial\vec{W}}{\partial\zeta} = 0. \tag{A.23}}

  @bi{
    @lang["en"]{The Jacobian @tex-math{\bar{A}_{c,1}} is given by the formula @link["blazek2005-ch12#eq-a-68"]{(A.68)} (or Eq. @link["blazek2005-ch12#eq-a-66"]{(A.66)} in 2D) with @tex-math{(n_x, n_y, n_z)} replaced by @tex-math{J^{-1}(\xi_x, \xi_y, \xi_z)}. The convective flux Jacobians @tex-math{\bar{A}_{c,2}} and @tex-math{\bar{A}_{c,3}} are defined in a similar way with derivatives of @tex-math{\eta} and @tex-math{\zeta}, respectively. The eigenvalues of the Jacobians determine the speed and the direction of propagation of waves (with convective and acoustic modes) through the flow domain. Therefore, the eigenvalues determine the time step of explicit time-stepping schemes. The eigenvalues and eigenvectors of the Jacobians also play an important role in upwind spatial discretisation schemes, where the stencil is biased in the direction of the wave propagation.}
    @lang["zh-Hans"]{Jacobian@tex-math{\bar{A}_{c,1}}由@link["blazek2005-ch12#eq-a-68"]{(A.68)}给出（二维情形为@link["blazek2005-ch12#eq-a-66"]{(A.66)}），只需把@tex-math{(n_x, n_y, n_z)}换成@tex-math{J^{-1}(\xi_x, \xi_y, \xi_z)}。对流通量Jacobian@tex-math{\bar{A}_{c,2}}与@tex-math{\bar{A}_{c,3}}按类似方式分别用@tex-math{\eta}与@tex-math{\zeta}的导数定义。各Jacobian的特征值决定了波（对流模态与声波模态）在流动域中传播的速度与方向，从而决定了显式时间推进格式的时间步长。Jacobian的特征值与特征向量在上风空间离散格式中也起着重要作用——这类格式的模板沿波传播方向偏置。}
  }
}
@subtree[#:id "blazek2005-a-3"]{
  @title{A.3 Mathematical Character of the Governing Equations A.3 控制方程的数学性质}

  @bi{
    @lang["en"]{The mathematical character of the partial differential equations (PDE's) is best explained through the classical example of the quasi-linear second-order equation}
    @lang["zh-Hans"]{偏微分方程（PDE）的数学性质，最好通过拟线性二阶方程的经典例子来说明}
  }

  @tex-display-math[#:id "eq-a-24"]{a\frac{\partial^2 U}{\partial x^2} + b\frac{\partial^2 U}{\partial x\partial y} + c\frac{\partial^2 U}{\partial y^2} = d, \tag{A.24}}

  @bi{
    @lang["en"]{where @tex-math{U} represents a general scalar function. The coefficients @tex-math{a}, @tex-math{b}, @tex-math{c} and @tex-math{d} may be non-linear functions of the coordinates, of @tex-math{U} and of its first derivatives, but not of the second derivatives of @tex-math{U}. Depending on the sign of the discriminant function (@tex-math{b^2 - 4ac}), three different classes of PDE's can be defined @link["blazek2005-ra-1"]{[1]}, @link["blazek2005-ra-2"]{[2]}. Namely, if the discriminant is positive the equation is said to be @emph{hyperbolic}, whereas if (@tex-math{b^2 - 4ac} < 0) it becomes @emph{elliptic}. Finally, if (@tex-math{b^2 - 4ac}) is zero the PDE is denoted as @emph{parabolic}.}
    @lang["zh-Hans"]{其中@tex-math{U}表示一般的标量函数。系数@tex-math{a}、@tex-math{b}、@tex-math{c}、@tex-math{d}可以是坐标、@tex-math{U}及其一阶导数的非线性函数，但不能是@tex-math{U}的二阶导数的函数。根据判别式（@tex-math{b^2 - 4ac}）的符号，可以定义三种不同类型的PDE @link["blazek2005-ra-1"]{[1]}、@link["blazek2005-ra-2"]{[2]}：判别式为正时，方程称为@emph{双曲型}（hyperbolic）；(@tex-math{b^2 - 4ac} < 0)时为@emph{椭圆型}（elliptic）；(@tex-math{b^2 - 4ac})为零时，则称为@emph{抛物型}（parabolic）。}
  }

  @bi{
    @lang["en"]{The Navier-Stokes equations cannot be characterised in such an easy way. In fact, they are in general a mixture of all three classes, depending on the flow conditions and on the geometry of the problem. Nevertheless, it is worthwhile to illustrate the physical behaviour of hyperbolic, parabolic and elliptic PDE's which must be considered for proper mathematical formulation of solution methods in fluid dynamics.}
    @lang["zh-Hans"]{Navier-Stokes方程却无法这样简单地归类。实际上，依据流动条件和问题的几何形状，它们一般是三种类型的混合。尽管如此，仍然值得说明双曲型、抛物型与椭圆型PDE的物理行为——在流体动力学中为求解方法建立恰当的数学表述时，必须考虑这些性质。}
  }

  @subtree[#:id "blazek2005-a-3-1"]{
    @title{A.3.1 Hyperbolic Equations A.3.1 双曲型方程}

    @bi{
      @lang["en"]{If the Equation @link["blazek2005-ch12#eq-a-24"]{(A.24)} is of hyperbolic type, it has two real characteristics. The situation is sketched in Fig. A.3. It is known from the theory that the information at point @tex-math{P} influences only the region between the advancing characteristics. On the other hand, point @tex-math{P} receives information only from the part of the domain between the characteristics @tex-math{AP} and @tex-math{BP}. Furthermore, the solution at point @tex-math{P} depends only on that part of the boundary which is intercepted by and included within the two characteristic lines through point @tex-math{P}, i.e., the interval @tex-math{AB}. For example, point @tex-math{P} obtains no information from point @tex-math{C}, since @tex-math{P} is not enclosed within the characteristics propagating from @tex-math{C}. Therefore, we need to specify conditions at only one part of the boundary in order to determine the solution in a given region. Hence, the hyperbolic equations represent an @emph{initial-value} problem.}
      @lang["zh-Hans"]{若方程@link["blazek2005-ch12#eq-a-24"]{(A.24)}是双曲型的，它有两条实特征线。情形如图A.3所示。由理论可知，点@tex-math{P}处的信息只影响前向特征线之间的区域；另一方面，点@tex-math{P}也只从特征线@tex-math{AP}与@tex-math{BP}之间的那部分区域接收信息。此外，点@tex-math{P}处的解只依赖于通过点@tex-math{P}的两条特征线所截取并被包含于其内的那部分边界，即区间@tex-math{AB}。例如，点@tex-math{P}不会从点@tex-math{C}获得任何信息，因为@tex-math{P}并不位于从@tex-math{C}传播出的特征线所围的范围之内。因此，为确定给定区域内的解，只需在边界的某一部分给定条件。所以，双曲型方程代表一个@emph{初值}（initial-value）问题。}
    }

    @bi{
      @lang["en"]{In fluid dynamics, the following are examples of flows which are governed by hyperbolic partial differential equations:
        @itemize{
          @item{Steady, inviscid supersonic flow: If the flow is two-dimensional, the behaviour is like that already discussed above. For a 3-D flow, there are characteristic surfaces in the @tex-math{(x, y, z)} space. The point @tex-math{P} influences then the volume enclosed within the advancing (downstream) characteristic surface. The characteristic surface corresponds to the Mach cone in the case of the linearised potential equation.}
        }
      }
      @lang["zh-Hans"]{在流体动力学中，由双曲型偏微分方程支配的流动有如下例子：
        @itemize{
          @item{定常无黏超声速流动：若流动是二维的，其行为与上面讨论的相同。对三维流动，@tex-math{(x, y, z)}空间中存在特征曲面，点@tex-math{P}影响前向（下游）特征曲面所包围的体积。在线化势方程的情形下，特征曲面对应Mach锥。}
        }
      }
    }

    @figure["blazek2005/fig-a-3.png" "图A.3:每点具有两条特征线的双曲型PDE的依赖域与影响域"]{
    @emph{图A.3:每点具有两条特征线的双曲型偏微分方程的依赖域与影响域 @link["blazek2005-ra-3"]{[3]}。}图例:zone of influence of point P——点P的影响区;left-running characteristic——左行特征线;right-running characteristic——右行特征线;region of dependence of point P——点P的依赖区;boundary——边界;P、A、B、C——考察点与边界上的点。
}
    @figure["blazek2005/fig-a-4.png" "图A.4:抛物型PDE的影响域"]{
    @emph{图A.4:抛物型偏微分方程的影响域 @link["blazek2005-ra-3"]{[3]}。}图例:characteristic——特征线;zone of influence of point P——点P的影响区;boundary——边界;P、A、B、C、D——考察点与边界上的点。
}
    @bi{
      @lang["en"]{
        @itemize{
          @item{@emph{Unsteady flow:} The governing equations are in this case hyperbolic in @emph{time}. Of course, the equations can be of different type in @emph{space}. Hence, it then does not matter whether the flow is locally subsonic or supersonic. Because of the (partial) hyperbolic nature, it is necessary to specify an initial solution which is then advanced in time.}
        }
      }
      @lang["zh-Hans"]{
        @itemize{
          @item{@emph{非定常流动：}此时控制方程在@emph{时间}上是双曲型的。当然，方程在@emph{空间}上可以是别的类型；因此，流动局部是亚声速还是超声速并不要紧。由于这种（部分的）双曲性质，必须给定一个初始解，然后将其沿时间推进。}
        }
      }
    }
  }

  @subtree[#:id "blazek2005-a-3-2"]{
    @title{A.3.2 Parabolic Equations A.3.2 抛物型方程}

    @bi{
      @lang["en"]{In this case, Equation @link["blazek2005-ch12#eq-a-24"]{(A.24)} has only one real characteristic. Fig. A.4 shows the characteristic together with the domain of influence. For parabolic equations, information at point @tex-math{P} influences the entire region on one side of the characteristic (@tex-math{BP} in the sketch) and hence also the points @tex-math{C} and @tex-math{D}. On the other hand, the solution at point @tex-math{A} is completely independent of that at point @tex-math{P}. Hence, the information is transfered in one direction only, like for hyperbolic PDE's. Furthermore, as we can see from Fig. A.4, for example the solution at point @tex-math{D} depends on conditions along the whole characteristic @tex-math{BP} as well as on those prescribed at the boundary segment @tex-math{BC}. Thus, the parabolic equations represent a mixed @emph{initial}- and @emph{boundary-value} problem.}
      @lang["zh-Hans"]{这种情形下，方程@link["blazek2005-ch12#eq-a-24"]{(A.24)}只有一条实特征线。图A.4给出了该特征线及其影响域。对抛物型方程，点@tex-math{P}处的信息影响特征线一侧的整个区域（图中为@tex-math{BP}一侧），因而也影响点@tex-math{C}与@tex-math{D}；另一方面，点@tex-math{A}处的解完全不依赖于点@tex-math{P}处的解。所以，与双曲型PDE一样，信息只沿一个方向传递。此外，从图A.4可以看到，例如点@tex-math{D}处的解既取决于整条特征线@tex-math{BP}上的条件，也取决于边界段@tex-math{BC}上给定的条件。因此，抛物型方程代表一个@emph{初值}与@emph{边值}的混合问题。}
    }

    @bi{
      @lang["en"]{One particular form of the simplified governing equations, namely the so-called @emph{Parabolised Navier-Stokes} (PNS) equations (see Subsection 2.4.3) exhibit the described parabolic-type behaviour. In this case, the viscous stress terms involving the derivatives with respect to the streamwise direction are ignored in the governing equations. The solution of the PNS equations is started from some prescribed (initial) data at the inlet boundary. The simulation then proceeds by marching downstream. Each streamwise station represents a plane (line in 2-D) which is perpendicular to the main flow direction and which is coupled in an explicit way to one or two upstream planes. In each plane, the equations have to be solved iteratively.}
      @lang["zh-Hans"]{简化控制方程的一种特殊形式，即所谓的@emph{抛物化Navier-Stokes}（Parabolised Navier-Stokes，PNS）方程（见2.4.3小节），就表现出上述抛物型行为。此时，控制方程中含流向导数的黏性应力项被忽略。PNS方程的求解从进口边界上给定的（初始）数据出发，随后向下游推进。每个流向站位代表一个垂直于主流方向的平面（二维为直线），它与上游的一两个平面显式耦合；在每个平面内，方程需要迭代求解。}
    }

    @bi{
      @lang["en"]{A further simplification of the Navier-Stokes equations for the case of high Reynolds numbers leads to the well-known boundary layer equations. These are also of parabolic type and they can be solved by a similar explicit space-marching procedure.}
      @lang["zh-Hans"]{对高雷诺数情形进一步简化Navier-Stokes方程，便得到著名的边界层方程。它们同样是抛物型的，可以用类似的显式空间推进方法求解。}
    }
  }

  @subtree[#:id "blazek2005-a-3-3"]{
    @title{A.3.3 Elliptic Equations A.3.3 椭圆型方程}

    @bi{
      @lang["en"]{Finally, if Eq. @link["blazek2005-ch12#eq-a-24"]{(A.24)} is of elliptic type, it has two complex characteristics. It is known from the theory that the information at some point @tex-math{P} influences all other regions of the domain. On the other hand, the solution at point @tex-math{P} depends on the whole surrounding domain. The situation is sketched in Fig. A.5. This implies that the solution at point @tex-math{P} is influenced by the entire closed boundary (@tex-math{A}, @tex-math{B}, @tex-math{C}). Therefore, the elliptic PDE's represent a @emph{boundary-value} problem, where the solution at point @tex-math{P} must be carried out simultaneously with the solution at all other points in the domain. This is in strong contrast to the space or time marching procedures applied to parabolic and hyperbolic equations. In terms of Fig. A.5, boundary conditions must be prescribed over}
      @lang["zh-Hans"]{最后，若@link["blazek2005-ch12#eq-a-24"]{(A.24)}是椭圆型的，它有两条复特征线。由理论可知，某点@tex-math{P}处的信息影响域内所有其他区域；另一方面，点@tex-math{P}处的解依赖于整个周围区域。情形如图A.5所示。这意味着点@tex-math{P}处的解受到整个封闭边界（@tex-math{A}、@tex-math{B}、@tex-math{C}）的影响。因此，椭圆型PDE代表一个@emph{边值}（boundary-value）问题：点@tex-math{P}处的解必须与域内所有其他点处的解同时求出。这与应用于抛物型和双曲型方程的空间或时间推进方法形成鲜明对照。按照图A.5，必须在}
    }

    @figure["blazek2005/fig-a-5.png" "图A.5:椭圆型PDE的影响域与依赖域"]{
    @emph{图A.5:椭圆型偏微分方程的影响域与依赖域 @link["blazek2005-ra-3"]{[3]}。}图例:boundary——边界;C、B、A——边界上的点;P——域内考察点;图下文字“P depending on and influencing the whole region”意为“点P依赖于整个区域并影响整个区域”。
}
    @bi{
      @lang["en"]{the entire boundary (@tex-math{A}, @tex-math{B}, @tex-math{C}). The boundary conditions can assume one of the two following forms:
        @itemize{
          @item{Specification of the @emph{dependent variables} along the boundary. This type of boundary condition is called the @emph{Dirichlet condition}.}
          @item{Specification of the derivatives of the dependent variables along the boundary. This type of boundary condition is named the @emph{Neumann condition}.}
        }
      }
      @lang["zh-Hans"]{整个边界（@tex-math{A}、@tex-math{B}、@tex-math{C}）上给定边界条件。边界条件可取如下两种形式之一：
        @itemize{
          @item{沿边界给定@emph{因变量}（dependent variables）的值。这类边界条件称为@emph{Dirichlet条件}。}
          @item{沿边界给定因变量的导数。这类边界条件称为@emph{Neumann条件}。}
        }
      }
    }

    @bi{
      @lang["en"]{In fluid dynamics, the steady subsonic/incompressible inviscid flow is for example governed by elliptic equations. Hence, for such flows physical boundary conditions must be applied to a surface which completely surrounds the simulated flow field.}
      @lang["zh-Hans"]{在流体动力学中，例如定常亚声速/不可压无黏流动就由椭圆型方程支配。因此，对这类流动，物理边界条件必须施加在完全包围所模拟流场的曲面上。}
    }
  }
}
@subtree[#:id "blazek2005-a-4"]{
  @title{A.4 Navier-Stokes Equations in Rotating Frame of Reference A.4 旋转参考系中的Navier-Stokes方程}

  @bi{
    @lang["en"]{In some instances, for example in turbomachinery applications, for propellers or in geophysics, the computational domain is steadily rotating about some axis. In such case, it is convenient to transform the Navier-Stokes equations into a @emph{rotating frame of reference}. Let us consider the situation which is depicted in Fig. A.6. Here, a point @tex-math{P} rotates with the constant angular velocity @tex-math{\vec{\omega}} around a fixed axis. For the sake of simplicity, we assume that the rotation axis coincides with the @tex-math{x}-coordinate axis. Thus, the angular velocity has the components @tex-math{\vec{\omega} = [\omega_1, 0, 0]^T}. The absolute velocity @tex-math{\vec{v}_a} results from the sum of the relative velocity @tex-math{\vec{v}_r} and the entrainment velocity @tex-math{\vec{v}_e}, i.e.,}
    @lang["zh-Hans"]{在某些情形——例如叶轮机械应用、螺旋桨或地球物理——中，计算域绕某一根轴匀速旋转。此时，把Navier-Stokes方程变换到@emph{旋转参考系}（rotating frame of reference）会比较方便。考察图A.6所示的情景：点@tex-math{P}以恒定角速度@tex-math{\vec{\omega}}绕固定轴旋转。为简单起见，假定旋转轴与@tex-math{x}坐标轴重合，于是角速度的分量为@tex-math{\vec{\omega} = [\omega_1, 0, 0]^T}。绝对速度@tex-math{\vec{v}_a}由相对速度@tex-math{\vec{v}_r}与牵连速度@tex-math{\vec{v}_e}相加得到，即}
  }

  @tex-display-math[#:id "eq-a-25"]{\vec{v}_a = \vec{v}_r + \vec{v}_e = \vec{v}_r + \vec{\omega}\times\vec{r}. \tag{A.25}}

  @bi{
    @lang["en"]{If we re-write the Navier-Stokes equations (2.19) in the relative frame of reference, we have to account for the effects due to the @emph{Coriolis force} as well as due to the @emph{centrifugal force}. The Coriolis force per unit mass is defined as}
    @lang["zh-Hans"]{若在相对参考系中重写Navier-Stokes方程(2.19)，就必须考虑@emph{Coriolis力}（科里奥利力）与@emph{离心力}的影响。单位质量所受的Coriolis力定义为}
  }

  @tex-display-math[#:id "eq-a-26"]{\vec{f}_{Corr} = -2\left(\vec{\omega}\times\vec{v}_r\right). \tag{A.26}}

  @bi{
    @lang["en"]{The centrifugal force per unit mass is given by}
    @lang["zh-Hans"]{单位质量所受的离心力为}
  }

  @tex-display-math[#:id "eq-a-27"]{\vec{f}_{cen} = -\vec{\omega}\times\left(\vec{\omega}\times\vec{r}\right) = \omega_1^2\vec{r}_n, \tag{A.27}}

  @bi{
    @lang["en"]{where @tex-math{\vec{r}_n} denotes the position vector perpendicular to the rotation axis. In consequence, the source term @tex-math{\vec{Q}} in Eq. (2.25) has to be extended by the sum of the Coriolis and the centrifugal forces for the momentum equations. Furthermore, the energy equation has to be modified because of the centrifugal force (the Coriolis force does not contribute to the energy balance). Only the continuity equation remains unchanged since the mass balance is invariant to a system rotation. Hence, the Navier-Stokes equations formulated in a relative frame of reference, which rotates with constant angular velocity about the @tex-math{x}-axis, reads}
    @lang["zh-Hans"]{其中@tex-math{\vec{r}_n}表示垂直于旋转轴的位置向量。因此，式(2.25)中的源项@tex-math{\vec{Q}}在动量方程里必须加上Coriolis力与离心力之和；此外，由于离心力的存在，能量方程也须修改（Coriolis力对能量平衡没有贡献）。只有连续性方程保持不变，因为质量平衡对系统旋转而言是不变的。于是，在绕@tex-math{x}轴以恒定角速度旋转的相对参考系中表述的Navier-Stokes方程为}
  }

  @tex-display-math[#:id "eq-a-28"]{\frac{\partial}{\partial t}\int_{\Omega}\tilde{W}\,d\Omega + \oint_{\partial\Omega}\left(\vec{F}_c - \vec{F}_v\right)dS = \int_{\Omega}\vec{Q}\,d\Omega. \tag{A.28}}

  @bi{
    @lang["en"]{The vector of the conservative variables @tex-math{\tilde{W}} consists of the following components}
    @lang["zh-Hans"]{守恒变量向量@tex-math{\tilde{W}}由以下分量组成}
  }

  @tex-display-math[#:id "eq-a-29"]{\tilde{W} = \begin{bmatrix} \rho\\ \rho u\\ \rho v\\ \rho w\\ \rho E \end{bmatrix}, \tag{A.29}}

  @bi{
    @lang["en"]{where @tex-math{\rho}, @tex-math{u}, @tex-math{v}, @tex-math{w}, @tex-math{E} denote the density, the Cartesian velocity components in the relative frame, and the relative total energy per unit mass, respectively. The relative total energy is given by}
    @lang["zh-Hans"]{其中@tex-math{\rho}、@tex-math{u}、@tex-math{v}、@tex-math{w}、@tex-math{E}分别表示密度、相对参考系中的笛卡尔速度分量以及单位质量的相对总能量。相对总能量为}
  }

  @tex-display-math[#:id "eq-a-30"]{E = e + \frac{|\vec{v}_r|^2}{2} - \frac{|\vec{v}_e|^2}{2} = e + \frac{u^2 + v^2 + w^2}{2} - \frac{\omega_1^2|\vec{r}_n|^2}{2} \tag{A.30}}

  @figure["blazek2005/fig-a-6.png" "图A.6:绝对参考系与旋转参考系(旋转轴与x轴重合)"]{
  @emph{图A.6:绝对参考系与旋转参考系。旋转轴与@tex-math{x}轴重合。}图例:O——坐标原点;@tex-math{x}、@tex-math{y}、@tex-math{z}——绝对参考系的坐标轴;absolute frame of reference——绝对参考系;relative (rotating) frame of reference——相对(旋转)参考系;rotational axis——旋转轴;@tex-math{P}——考察点;@tex-math{\vec{r}}——位置向量;@tex-math{\vec{r}_n}——垂直于旋转轴的位置向量;@tex-math{\vec{\omega}}——角速度;@tex-math{\vec{v}_r}——相对速度;@tex-math{\vec{v}_e}——牵连速度。
}
  @bi{
    @lang["en"]{with @tex-math{|\vec{r}_n|^2 = y^2 + z^2}. The vector of the convective fluxes @tex-math{\vec{F}_c} is defined as}
    @lang["zh-Hans"]{其中@tex-math{|\vec{r}_n|^2 = y^2 + z^2}。对流通量向量@tex-math{\vec{F}_c}定义为}
  }

  @tex-display-math[#:id "eq-a-31"]{\vec{F}_c = \begin{bmatrix} \rho V\\ \rho uV + n_x p\\ \rho vV + n_y p\\ \rho wV + n_z p\\ \rho IV \end{bmatrix} \tag{A.31}}

  @bi{
    @lang["en"]{with @tex-math{p} being the static pressure, and @tex-math{n_x}, @tex-math{n_y}, @tex-math{n_z} representing the components of the outward pointing unit normal vector of the surface @tex-math{\partial\Omega}, respectively. Furthermore,}
    @lang["zh-Hans"]{其中@tex-math{p}为静压，@tex-math{n_x}、@tex-math{n_y}、@tex-math{n_z}分别表示曲面@tex-math{\partial\Omega}外指单位法向量的分量。此外}
  }

  @tex-display-math[#:id "eq-a-32"]{\begin{aligned} I &= h + \frac{|\vec{v}_r|^2}{2} - \frac{|\vec{v}_e|^2}{2} = H - \frac{\omega_1^2|\vec{r}_n|^2}{2},\\ V &= n_x u + n_y v + n_z w, \end{aligned} \tag{A.32}}

  @bi{
    @lang["en"]{where @tex-math{I} stands for the @emph{rothalpy}, @tex-math{H} for the relative total enthalpy, and @tex-math{V} for the contravariant velocity, respectively. The rothalpy represents the total energy content in a steadily rotating frame of reference.}
    @lang["zh-Hans"]{其中@tex-math{I}表示@emph{转焓}（rothalpy），@tex-math{H}表示相对总焓，@tex-math{V}表示逆变速度。转焓表示匀速旋转参考系中的总能量。}
  }

  @bi{
    @lang["en"]{The vector of the viscous fluxes @tex-math{\vec{F}_v} retains the same form as presented in Eq. (2.23). Also the components of the viscous stress tensor remain formally as given by Eq. (2.15). However, the source term @tex-math{\vec{Q}} is extended by the Coriolis and the centrifugal force to}
    @lang["zh-Hans"]{黏性通量向量@tex-math{\vec{F}_v}保持与式(2.23)相同的形式；黏性应力张量的各分量在形式上也仍与式(2.15)一致。但源项@tex-math{\vec{Q}}要加上Coriolis力与离心力，扩展为}
  }

  @tex-display-math[#:id "eq-a-33"]{\vec{Q} = \begin{bmatrix} 0\\ \rho f_{e,x}\\ \rho\omega_1(y\omega_1 + 2w) + \rho f_{e,y}\\ \rho\omega_1(z\omega_1 - 2v) + \rho f_{e,z}\\ \rho\vec{f}_e\cdot\vec{v}_r + \dot{q}_h \end{bmatrix} \tag{A.33}}

  @bi{
    @lang["en"]{with @tex-math{\rho\vec{f}_e} being the body force per unit volume (in addition to Coriolis and centrifugal forces), and @tex-math{\dot{q}_h} being the time rate of heat transfer per unit mass, respectively.}
    @lang["zh-Hans"]{其中@tex-math{\rho\vec{f}_e}为单位体积的体力（Coriolis力与离心力之外的部分），@tex-math{\dot{q}_h}为单位质量的热传递时间变化率。}
  }

  @bi{
    @lang["en"]{The transformed governing equations @link["blazek2005-ch12#eq-a-28"]{(A.28)} are closed using thermodynamic relations between the state variables. In the case of a perfect gas, the pressure is computed from the formula}
    @lang["zh-Hans"]{变换后的控制方程@link["blazek2005-ch12#eq-a-28"]{(A.28)}借助状态变量之间的热力学关系封闭。对完全气体，压力按下式计算}
  }

  @tex-display-math[#:id "eq-a-34"]{p = (\gamma - 1)\rho\left[E - \frac{u^2 + v^2 + w^2 - \omega_1^2|\vec{r}_n|^2}{2}\right], \tag{A.34}}

  @bi{
    @lang["en"]{where @tex-math{\gamma} denotes the ratio of the specific heat coefficients. Additionally, the viscosity and the thermal conductivity coefficients have to be supplied as a function of the state of the fluid.}
    @lang["zh-Hans"]{其中@tex-math{\gamma}表示比热比。此外，还须把黏度系数与热导率系数作为流体状态的函数给出。}
  }
}
@subtree[#:id "blazek2005-a-5"]{
  @title{A.5 Navier-Stokes Equations Formulated for Moving Grids A.5 运动网格上表述的Navier-Stokes方程}

  @bi{
    @lang["en"]{In certain cases, for instance where the fluid-structure interaction is investigated or where a store separation is simulated, it is necessary to solve the governing equations on a moving and possibly also a deforming grid. The two most popular methodologies used to tackle such problems, are the @emph{Arbitrary Lagrangian Eulerian} (ALE) formulation @link["blazek2005-ra-4"]{[4]}-@link["blazek2005-ra-6"]{[6]} and the @emph{dynamic grids} @link["blazek2005-ra-7"]{[7]}. Both approaches are closely related and lead to the same modified form of the governing equations which accounts for the relative motion of the grid with respect to the fluid.}
    @lang["zh-Hans"]{在某些情形——例如研究流固耦合或模拟外挂物分离——中，需要在运动且可能变形的网格上求解控制方程。处理此类问题最常用的两种方法是@emph{任意Lagrangian-Eulerian}（Arbitrary Lagrangian Eulerian，ALE）表述 @link["blazek2005-ra-4"]{[4]}-@link["blazek2005-ra-6"]{[6]} 与@emph{动态网格}（dynamic grids）@link["blazek2005-ra-7"]{[7]}。两者密切相关，并且导出同样的、考虑网格相对流体运动的控制方程修正形式。}
  }

  @bi{
    @lang["en"]{Written in the time-dependent integral form for a moving and/or deforming control volume @tex-math{\Omega} with a surface element @tex-math{dS}, the Navier-Stokes equations (2.19) read}
    @lang["zh-Hans"]{针对运动和/或变形的控制体@tex-math{\Omega}（面元为@tex-math{dS}）写成随时间变化的积分形式，Navier-Stokes方程(2.19)为}
  }

  @tex-display-math[#:id "eq-a-35"]{\frac{\partial}{\partial t}\int_{\Omega}\tilde{W}\,d\Omega + \oint_{\partial\Omega}\left(\vec{F}_c^M - \vec{F}_v\right)dS = \int_{\Omega}\vec{Q}\,d\Omega. \tag{A.35}}

  @bi{
    @lang["en"]{The vector of the conservative variables @tex-math{\vec{W}} has the following components}
    @lang["zh-Hans"]{守恒变量向量@tex-math{\vec{W}}具有以下分量}
  }

  @tex-display-math[#:id "eq-a-36"]{\vec{W} = \begin{bmatrix} \rho\\ \rho u\\ \rho v\\ \rho w\\ \rho E \end{bmatrix}, \tag{A.36}}

  @bi{
    @lang["en"]{where @tex-math{\rho}, @tex-math{u}, @tex-math{v}, @tex-math{w}, @tex-math{E} denote the density, the Cartesian velocity components and the total energy per unit mass, respectively. The vector of the convective fluxes @tex-math{\vec{F}_c^M} becomes on dynamic grids}
    @lang["zh-Hans"]{其中@tex-math{\rho}、@tex-math{u}、@tex-math{v}、@tex-math{w}、@tex-math{E}分别表示密度、笛卡尔速度分量与单位质量总能量。在动态网格上，对流通量向量@tex-math{\vec{F}_c^M}变为}
  }

  @tex-display-math[#:id "eq-a-37"]{\vec{F}_c^M = \vec{F}_c - V_t\vec{W} \tag{A.37}}

  @bi{
    @lang["en"]{with @tex-math{\vec{F}_c} given by Eq. (2.21) and @tex-math{V_t} being the contravariant velocity of the face of the control volume. Hence,}
    @lang["zh-Hans"]{其中@tex-math{\vec{F}_c}由式(2.21)给出，@tex-math{V_t}为控制体表面的逆变速度。于是}
  }

  @tex-display-math[#:id "eq-a-38"]{V_t = \vec{g}\cdot\vec{n} = n_x\frac{\partial x}{\partial t} + n_y\frac{\partial y}{\partial t} + n_z\frac{\partial z}{\partial t}, \tag{A.38}}

  @bi{
    @lang["en"]{where @tex-math{\vec{g}} represents the grid velocity, and @tex-math{n_x}, @tex-math{n_y}, @tex-math{n_z} denote the components of the outward facing unit normal vector of the surface @tex-math{\partial\Omega}, respectively. Using Eq. (2.21), the convective fluxes @tex-math{\vec{F}_c^M} can be written in the form}
    @lang["zh-Hans"]{其中@tex-math{\vec{g}}表示网格速度，@tex-math{n_x}、@tex-math{n_y}、@tex-math{n_z}分别表示曲面@tex-math{\partial\Omega}外指单位法向量的分量。利用式(2.21)，对流通量@tex-math{\vec{F}_c^M}可以写成}
  }

  @tex-display-math[#:id "eq-a-39"]{\vec{F}_c^M = \begin{bmatrix} \rho V_r\\ \rho uV_r + n_x p\\ \rho vV_r + n_y p\\ \rho wV_r + n_z p\\ \rho HV_r + V_t p \end{bmatrix}, \tag{A.39}}

  @bi{
    @lang["en"]{where @tex-math{H} stands for the total enthalpy and @tex-math{p} for the static pressure, respectively. Furthermore, @tex-math{V_r} represents the contravariant velocity relative to the motion of the grid, i.e.,}
    @lang["zh-Hans"]{其中@tex-math{H}表示总焓，@tex-math{p}表示静压。此外，@tex-math{V_r}表示相对于网格运动的逆变速度，即}
  }

  @tex-display-math[#:id "eq-a-40"]{V_r = n_x u + n_y v + n_z w - V_t = V - V_t. \tag{A.40}}

  @bi{
    @lang["en"]{The vector of the viscous fluxes @tex-math{\vec{F}_v} and the source term @tex-math{\vec{Q}} retain the same forms as already presented in Eq. (2.23) and Eq. (2.25), respectively. The same holds also for the components of the viscous stress tensor Eq. (2.15). On the other hand, the Jacobian of the convective fluxes (Section A.9), its eigenvalues (Eq. @link["blazek2005-ch12#eq-a-84"]{(A.84)} or @link["blazek2005-ch12#eq-a-88"]{(A.88)}) and hence the spectral radii are changed due to the grid motion (@tex-math{V} is replaced by @tex-math{V_r} in Eq. (4.53), (5.33) or (9.77)).}
    @lang["zh-Hans"]{黏性通量向量@tex-math{\vec{F}_v}与源项@tex-math{\vec{Q}}分别保持与式(2.23)和式(2.25)相同的形式；黏性应力张量的各分量（式(2.15)）也是如此。另一方面，由于网格运动，对流通量的Jacobian（A.9节）、其特征值（@link["blazek2005-ch12#eq-a-84"]{(A.84)}或@link["blazek2005-ch12#eq-a-88"]{(A.88)}）以及谱半径都会改变（在式(4.53)、(5.33)或(9.77)中，@tex-math{V}换成@tex-math{V_r}）。}
  }

  @bi{
    @lang["en"]{It was first pointed out by Thomas and Lombard @link["blazek2005-ra-8"]{[8]} that besides the conservation of mass, momentum and energy, the so-called @emph{Geometric Conservation Law} (GCL) must be satisfied in order to avoid errors induced by a deformation of the control volumes @link["blazek2005-ra-7"]{[7]}, @link["blazek2005-ra-9"]{[9]}-@link["blazek2005-ra-11"]{[11]}. The GCL results from the requirement that the computation of the control volumes or of the grid velocities must be performed in such a way that the resulting numerical scheme preserves the state of a uniform flow, independently of the deformation of the grid @link["blazek2005-ra-11"]{[11]}. The GCL is derived from the continuity equation. The equation for the mass conservation (2.3), formulated for moving grids, reads}
    @lang["zh-Hans"]{Thomas与Lombard @link["blazek2005-ra-8"]{[8]}首先指出，除质量、动量与能量守恒之外，还必须满足所谓的@emph{几何守恒定律}（Geometric Conservation Law，GCL），以避免控制体变形引起的误差 @link["blazek2005-ra-7"]{[7]}、@link["blazek2005-ra-9"]{[9]}-@link["blazek2005-ra-11"]{[11]}。GCL源于如下要求：控制体或网格速度的计算必须保证所得数值格式能保持均匀流动的状态，而与网格变形无关 @link["blazek2005-ra-11"]{[11]}。GCL由连续性方程导出。针对运动网格表述的质量守恒方程(2.3)为}
  }

  @tex-display-math[#:id "eq-a-41"]{\frac{\partial}{\partial t}\int_{\Omega}\rho\,d\Omega + \oint_{\partial\Omega}\rho\left(V - V_t\right)dS = 0. \tag{A.41}}

  @bi{
    @lang["en"]{The above Eq. @link["blazek2005-ch12#eq-a-41"]{(A.41)} must hold also for the case of a uniform fluid velocity (and hence @tex-math{V}) and a constant density. Assuming that the control volume is always closed, the integral over the contravariant velocity @tex-math{V} is zero. Herewith, we obtain the integral form of the GCL}
    @lang["zh-Hans"]{上式@link["blazek2005-ch12#eq-a-41"]{(A.41)}对均匀流体速度（从而均匀的@tex-math{V}）与常密度的情形也必须成立。假定控制体始终封闭，则对逆变速度@tex-math{V}的积分为零。由此得到GCL的积分形式}
  }

  @tex-display-math[#:id "eq-a-42"]{\frac{\partial}{\partial t}\int_{\Omega}d\Omega - \oint_{\partial\Omega}V_t\,dS = 0. \tag{A.42}}

  @bi{
    @lang["en"]{As we can see, the GCL relates the change of the control volume to the motion of its faces. It is obvious that the GCL is automatically satisfied for such moving grids, where the shapes of the control volumes do not change in time. It is essential that the GCL in Eq. @link["blazek2005-ch12#eq-a-42"]{(A.42)} is temporally discretised using the same scheme as it is applied to the governing equations @link["blazek2005-ch12#eq-a-35"]{(A.35)} in order to obtain a self-consistent solution method. Furthermore, the GCL has to be solved concurrently with the fluid equations. We shall demonstrate this on two exemplary temporal discretisations.}
    @lang["zh-Hans"]{可以看到，GCL把控制体的变化与其表面的运动联系起来。显然，对于控制体形状不随时间变化的运动网格，GCL自动满足。关键在于，@link["blazek2005-ch12#eq-a-42"]{(A.42)}中的GCL必须与控制方程@link["blazek2005-ch12#eq-a-35"]{(A.35)}采用同一种时间离散格式，才能得到自洽的求解方法；而且GCL必须与流体方程同步求解。下面以两种典型的时间离散为例加以说明。}
  }

  @emph{Explicit Time-Stepping Scheme 显式时间推进格式}

  @bi{
    @lang["en"]{Let us begin with a basic explicit time-stepping scheme (forward Euler) given in Eq. (6.4). With this particular temporal discretisation, Eq. @link["blazek2005-ch12#eq-a-42"]{(A.42)} becomes}
    @lang["zh-Hans"]{先从式(6.4)给出的基本显式时间推进格式（前向Euler）开始。采用这种时间离散，@link["blazek2005-ch12#eq-a-42"]{(A.42)}成为}
  }

  @tex-display-math[#:id "eq-a-43"]{\Omega^{n+1} - \Omega^n = \int_t^{t+\Delta t}\oint_{\partial\Omega}\left(\vec{g}\cdot\vec{n}\right)dS\,dt. \tag{A.43}}

  @bi{
    @lang["en"]{Since the faces of the control volume @tex-math{\Omega} consist of convex facets, the total change of the volume in Eq. @link["blazek2005-ch12#eq-a-43"]{(A.43)} is equal to the sum of local changes at each facet. If we consider now one particular facet @tex-math{m} of the control volume, like it is sketched in Fig. A.7, we can formulate the local GCL as}
    @lang["zh-Hans"]{由于控制体@tex-math{\Omega}的表面由凸面片组成，@link["blazek2005-ch12#eq-a-43"]{(A.43)}中体积的总变化等于各面片局部变化之和。现在考察控制体的某个面片@tex-math{m}（如图A.7所示），可以把局部GCL写为}
  }

  @figure["blazek2005/fig-a-7.png" "图A.7:控制体的三角形面片m在时间层n与n+1之间的运动"]{
  @emph{图A.7:控制体的三角形面片@tex-math{m}在时间层@tex-math{n}与@tex-math{n+1}之间的运动。}图例:@tex-math{A}、@tex-math{B}、@tex-math{C}——面片在时间层@tex-math{n}的顶点;@tex-math{A'}、@tex-math{B'}、@tex-math{C'}——面片在时间层@tex-math{n+1}的顶点;@tex-math{\vec{n}_m^n}、@tex-math{\vec{n}_m^{n+1}}——两个时间层的面片法向量;@tex-math{dS_m^n}、@tex-math{dS_m^{n+1}}——两个时间层的面片面积。
}
  @tex-display-math[#:id "eq-a-44"]{\Delta\Omega_m = \Omega_m^{n+1} - \Omega_m^n = \Delta t\left[\left(\vec{g}\cdot\vec{n}\right)\Delta S\right]_m^{n+1/2}. \tag{A.44}}

  @bi{
    @lang["en"]{Under the assumption the grid motion is linear in time and in space, the term @tex-math{\Delta\Omega_m} in Eq. @link["blazek2005-ch12#eq-a-44"]{(A.44)} represents the volume @tex-math{ABCA'B'C'} in Fig. A.7 swept out by the facet during @tex-math{\Delta t}. Since the local change of the control volume is known (in general with a certain approximation in 3D), we can compute @tex-math{V_t\Delta S}, which is needed for the evaluation of the convective fluxes @tex-math{\vec{F}_c^M} in Eq. @link["blazek2005-ch12#eq-a-35"]{(A.35)}, directly from Eq. @link["blazek2005-ch12#eq-a-44"]{(A.44)}. The normal vector in Eq. @link["blazek2005-ch12#eq-a-44"]{(A.44)} is defined as the arithmetic average of the normals at @tex-math{t} and @tex-math{t + \Delta t}, i.e.,}
    @lang["zh-Hans"]{在网格运动随时间和空间线性变化的假设下，@link["blazek2005-ch12#eq-a-44"]{(A.44)}中的@tex-math{\Delta\Omega_m}项表示图A.7中面片在@tex-math{\Delta t}期间扫过的体积@tex-math{ABCA'B'C'}。由于控制体的局部变化已知（三维时一般带有一定近似），可以直接由@link["blazek2005-ch12#eq-a-44"]{(A.44)}算出@tex-math{V_t\Delta S}——计算@link["blazek2005-ch12#eq-a-35"]{(A.35)}中的对流通量@tex-math{\vec{F}_c^M}需要它。@link["blazek2005-ch12#eq-a-44"]{(A.44)}中的法向量定义为@tex-math{t}与@tex-math{t + \Delta t}两时刻法向量的算术平均，即}
  }

  @tex-display-math[#:id "eq-a-45"]{\left(\vec{n}\Delta S\right)_m^{n+1/2} = \frac{1}{2}\left[\left(\vec{n}\Delta S\right)_m^{n+1} + \left(\vec{n}\Delta S\right)_m^n\right]. \tag{A.45}}

  @bi{
    @lang["en"]{It is used for the computation of the convective as well as the viscous fluxes in Eq. @link["blazek2005-ch12#eq-a-35"]{(A.35)}.}
    @lang["zh-Hans"]{它用于计算@link["blazek2005-ch12#eq-a-35"]{(A.35)}中的对流通量与黏性通量。}
  }

  @bi{
    @lang["en"]{When we employ the explicit multistage scheme from Section 6.1.1 for the temporal discretisation of Eq. @link["blazek2005-ch12#eq-a-35"]{(A.35)}, the flow solution at a stage @tex-math{k} will be given by the relation}
    @lang["zh-Hans"]{若采用6.1.1节的显式多步格式对@link["blazek2005-ch12#eq-a-35"]{(A.35)}作时间离散，则第@tex-math{k}步的流动解由下式给出}
  }

  @tex-display-math[#:id "eq-a-46"]{\vec{W}^{(k)} = \vec{W}^{(0)}\frac{\Omega^n}{\Omega^{n+1}} - \frac{\alpha_k\Delta t}{\Omega^{n+1}}\left[\sum_{m=1}^{N_F}\left(\vec{F}_c^M - \vec{F}_v\right)_m\Delta S_m^{n+1/2} - \vec{Q}\Omega^n\right], \tag{A.46}}

  @bi{
    @lang["en"]{where @tex-math{N_F} denotes the number of facets of the control volume @tex-math{\Omega}. The convective and viscous fluxes as well as the source term are functions of the solution from the previous stage @tex-math{\vec{W}^{(k-1)}}. Furthermore, the grid velocity is obtained from}
    @lang["zh-Hans"]{其中@tex-math{N_F}表示控制体@tex-math{\Omega}的面片数。对流通量、黏性通量以及源项都是上一步解@tex-math{\vec{W}^{(k-1)}}的函数。此外，网格速度由下式求得}
  }

  @emph{¹原书脚注:note that the number of facets may be different from the number of faces; this is especially the case for the median-dual scheme on unstructured grids.(注意，面片（facet）的数目可能不同于面（face）的数目；对非结构网格上的median-dual格式而言尤其如此。)}

  @tex-display-math[#:id "eq-a-47"]{\left[\left(\vec{g}\cdot\vec{n}\right)\Delta S\right]_m^{n+1/2} = \frac{\Omega_m^{n+1} - \Omega_m^n}{\alpha_k\Delta t}, \tag{A.47}}

  @bi{
    @lang["en"]{in order to be consistent with the multistage scheme Eq. @link["blazek2005-ch12#eq-a-46"]{(A.46)}. Finally, the normal vector is computed by Eq. @link["blazek2005-ch12#eq-a-45"]{(A.45)}.}
    @lang["zh-Hans"]{以便与多步格式@link["blazek2005-ch12#eq-a-46"]{(A.46)}保持一致。最后，法向量按@link["blazek2005-ch12#eq-a-45"]{(A.45)}计算。}
  }

  @emph{Implicit Time-Stepping Scheme 隐式时间推进格式}

  @bi{
    @lang["en"]{Let us consider the 3-point backward Euler scheme from Eq. (6.67) for the second example of temporal discretisation. Omitting the index @tex-math{I}, the right-hand side of Eq. (6.67) becomes on a moving grid}
    @lang["zh-Hans"]{时间离散的第二个例子考虑式(6.67)的三点后向Euler格式。略去指标@tex-math{I}，在运动网格上式(6.67)的右端变为}
  }

  @tex-display-math[#:id "eq-a-48"]{\vec{R}^{n+1} = \sum_{m=1}^{N_F}\left(\vec{F}_c^M - \vec{F}_v\right)_m\Delta S_m^{n+1} - \vec{Q}\Omega^{n+1}. \tag{A.48}}

  @bi{
    @lang["en"]{The convective and viscous fluxes as well as the source term are in this case functions of the new solution @tex-math{\vec{W}^{n+1}}. The grid velocity is computed in line with the time integration scheme from}
    @lang["zh-Hans"]{此时对流通量、黏性通量与源项都是新解@tex-math{\vec{W}^{n+1}}的函数。网格速度按与时间积分格式一致的方式由下式计算}
  }

  @tex-display-math[#:id "eq-a-49"]{\left[\left(\vec{g}\cdot\vec{n}\right)\Delta S\right]_m^{n+1} = \frac{3\Omega_m^{n+1} - 4\Omega_m^n + \Omega_m^{n-1}}{2\Delta t}. \tag{A.49}}

  @bi{
    @lang["en"]{The normal vector, which is required for the evaluation of the convective and the viscous fluxes, has to be computed by extrapolation from two previous time levels}
    @lang["zh-Hans"]{计算对流通量与黏性通量所需的法向量，必须由前两个时间层外推得到}
  }

  @tex-display-math[#:id "eq-a-50"]{\left(\vec{n}\Delta S\right)_m^{n+1} = \frac{3}{2}\left(\vec{n}\Delta S\right)_m^{n+1/2} - \frac{1}{2}\left(\vec{n}\Delta S\right)_m^{n-1/2}, \tag{A.50}}

  @bi{
    @lang["en"]{where the terms at the levels (@tex-math{n + 1/2}) and (@tex-math{n - 1/2}) are obtained from Eq. @link["blazek2005-ch12#eq-a-45"]{(A.45)}. The definitions in Eq. @link["blazek2005-ch12#eq-a-49"]{(A.49)} and @link["blazek2005-ch12#eq-a-50"]{(A.50)} make sure that the temporal discretisation remains of second order on a moving grid (compare to the conditions given in Ref. @link["blazek2005-ra-12"]{[12]}).}
    @lang["zh-Hans"]{其中(@tex-math{n + 1/2})与(@tex-math{n - 1/2})层上的项由@link["blazek2005-ch12#eq-a-45"]{(A.45)}得到。@link["blazek2005-ch12#eq-a-49"]{(A.49)}与@link["blazek2005-ch12#eq-a-50"]{(A.50)}的定义保证时间离散在运动网格上仍保持二阶精度（可对照文献@link["blazek2005-ra-12"]{[12]}给出的条件）。}
  }

  @emph{Wall Boundary Conditions 壁面边界条件}

  @bi{
    @lang["en"]{As we discussed in Section 8.2, the first condition is that there is no flow normal to the wall. For a moving boundary, this translates to @tex-math{V_r = 0}. When applied to Eq. @link["blazek2005-ch12#eq-a-39"]{(A.39)}, only the terms @tex-math{\vec{n}p_w} and @tex-math{V_t p_w} remain in @tex-math{(\vec{F}_c^M)_w}. The wall pressure @tex-math{p_w} is obtained in the same way as presented in Subsection 8.2, the wall velocity is given by Eq. @link["blazek2005-ch12#eq-a-47"]{(A.47)} or @link["blazek2005-ch12#eq-a-49"]{(A.49)}, respectively. The second condition, which arises in the case of viscous flows, states that the fluid moves with the wall velocity, i.e., @tex-math{\vec{v}_w = \vec{g}_w}. This effects the extrapolation into the dummy cells discussed in Subsection 8.2.2.@sidenote{译注：原书此句印作“This effects the extrapolation into the dummy cells”，按文义“effects”应为“affects”（影响）。}}
    @lang["zh-Hans"]{如8.2节所讨论，第一个条件是不存在沿壁面法向的流动；对运动边界，这意味着@tex-math{V_r = 0}。应用于@link["blazek2005-ch12#eq-a-39"]{(A.39)}时，@tex-math{(\vec{F}_c^M)_w}中只剩下@tex-math{\vec{n}p_w}与@tex-math{V_t p_w}两项。壁面压力@tex-math{p_w}按8.2小节所述的同样方式求得，壁面速度则分别由@link["blazek2005-ch12#eq-a-47"]{(A.47)}或@link["blazek2005-ch12#eq-a-49"]{(A.49)}给出。黏性流动中的第二个条件是流体随壁面速度运动，即@tex-math{\vec{v}_w = \vec{g}_w}；这会影响8.2.2小节所讨论的向虚单元的外推。}
  }

  @bi{
    @lang["en"]{More details on the numerical implementation of the governing equations for moving and/or deforming grids and on the discretisation of the GCL can be found in the above cited references and also, e.g., in @link["blazek2005-ra-12"]{[12]}-@link["blazek2005-ra-20"]{[20]}. A very detailed description of schemes for unstructured grids was presented in Refs. @link["blazek2005-ra-15"]{[15]}, @link["blazek2005-ra-20"]{[20]}.}
    @lang["zh-Hans"]{关于运动和/或变形网格上控制方程的数值实现以及GCL离散的更多细节，可在上述文献以及例如 @link["blazek2005-ra-12"]{[12]}-@link["blazek2005-ra-20"]{[20]} 中找到；文献 @link["blazek2005-ra-15"]{[15]}、@link["blazek2005-ra-20"]{[20]} 对非结构网格的格式作了非常详细的描述。}
  }
}
@subtree[#:id "blazek2005-a-6"]{
  @title{A.6 Thin Shear Layer Approximation A.6 薄剪切层近似}

  @bi{
    @lang["en"]{In the case of high Reynolds numbers, the flow is influenced by the viscous stresses only in a narrow region around the body. It is then reasonable to assume that the gradients in the wall normal direction dominate, and hence that the gradients in the other direction(s) can be neglected @link["blazek2005-ra-21"]{[21]}, @link["blazek2005-ra-22"]{[22]}. We speak in such case of the so-called @emph{Thin Shear Layer} (TSL) approximation of the Navier-Stokes equations.}
    @lang["zh-Hans"]{高雷诺数情形下，流动只在物体附近的狭窄区域内受黏性应力影响。此时可以合理地假设壁面法向的梯度占主导，因而其他方向上的梯度可以忽略 @link["blazek2005-ra-21"]{[21]}、@link["blazek2005-ra-22"]{[22]}。这种情形称为Navier-Stokes方程的@emph{薄剪切层}（Thin Shear Layer，TSL）近似。}
  }

  @bi{
    @lang["en"]{Let us consider for illustration the differential form of the Navier-Stokes equations formulated for a general curvilinear grid @link["blazek2005-ch12#eq-a-4"]{(A.4)}. If we further assume that, as rendered in Fig. 2.4, the wall is located at @tex-math{\eta = \text{const.}}, all derivatives in the streamwise (@tex-math{\partial/\partial\xi}) and in the cross-flow direction (@tex-math{\partial/\partial\zeta}) are omitted from the diffusive terms. The 3-D TSL Navier-Stokes equations in differential form then appear as follows in the curvilinear coordinate system (@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta})}
    @lang["zh-Hans"]{为便于说明，考察针对一般曲线网格写出的Navier-Stokes方程微分形式@link["blazek2005-ch12#eq-a-4"]{(A.4)}。再进一步假设（如图2.4所示）壁面位于@tex-math{\eta = \text{const.}}处，则扩散项中沿流向（@tex-math{\partial/\partial\xi}）与横流方向（@tex-math{\partial/\partial\zeta}）的所有导数都被略去。于是，三维TSL Navier-Stokes方程在曲线坐标系(@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta})中的微分形式为}
  }

  @tex-display-math[#:id "eq-a-51"]{\frac{\partial\vec{W}^{*}}{\partial t} + \frac{\partial\vec{F}_{c,1}}{\partial\xi} + \frac{\partial\vec{F}_{c,2}}{\partial\eta} + \frac{\partial\vec{F}_{c,3}}{\partial\zeta} = \frac{\partial\vec{F}_{v,2}}{\partial\eta} + \vec{Q}^{*}. \tag{A.51}}

  @bi{
    @lang["en"]{The vectors of the conservative variables (@tex-math{\vec{W}^{*}}), of the convective fluxes (@tex-math{\vec{F}_{c,1/2/3}}), and of the diffusive flux (@tex-math{\vec{F}_{v,2}}), respectively, are given by the relationships @link["blazek2005-ch12#eq-a-5"]{(A.5)}-@link["blazek2005-ch12#eq-a-7"]{(A.7)}. Furthermore, the source term (@tex-math{\vec{Q}^{*}}) also remains in the form given by Eq. @link["blazek2005-ch12#eq-a-8"]{(A.8)}. However, the components of the viscous stress tensor (Eq. @link["blazek2005-ch12#eq-a-10"]{(A.10)}) and of the thermal fluxes transform to}
    @lang["zh-Hans"]{守恒变量向量（@tex-math{\vec{W}^{*}}）、对流通量向量（@tex-math{\vec{F}_{c,1/2/3}}）与扩散通量向量（@tex-math{\vec{F}_{v,2}}）分别由关系式@link["blazek2005-ch12#eq-a-5"]{(A.5)}-@link["blazek2005-ch12#eq-a-7"]{(A.7)}给出；源项（@tex-math{\vec{Q}^{*}}）也保持@link["blazek2005-ch12#eq-a-8"]{(A.8)}给出的形式。但黏性应力张量（@link["blazek2005-ch12#eq-a-10"]{(A.10)}）与热通量的各分量变换为}
  }

  @tex-display-math[#:id "eq-a-52"]{\begin{aligned} \tau_{xx} &= 2\mu\eta_x\frac{\partial u}{\partial\eta} + \lambda\left(\eta_x\frac{\partial u}{\partial\eta} + \eta_y\frac{\partial v}{\partial\eta} + \eta_z\frac{\partial w}{\partial\eta}\right)\\ \tau_{yy} &= 2\mu\eta_y\frac{\partial v}{\partial\eta} + \lambda\left(\eta_x\frac{\partial u}{\partial\eta} + \eta_y\frac{\partial v}{\partial\eta} + \eta_z\frac{\partial w}{\partial\eta}\right)\\ \tau_{zz} &= 2\mu\eta_z\frac{\partial w}{\partial\eta} + \lambda\left(\eta_x\frac{\partial u}{\partial\eta} + \eta_y\frac{\partial v}{\partial\eta} + \eta_z\frac{\partial w}{\partial\eta}\right)\\ \tau_{xy} &= \tau_{yx} = \mu\left(\eta_y\frac{\partial u}{\partial\eta} + \eta_x\frac{\partial v}{\partial\eta}\right)\\ \tau_{xz} &= \tau_{zx} = \mu\left(\eta_z\frac{\partial u}{\partial\eta} + \eta_x\frac{\partial w}{\partial\eta}\right)\\ \tau_{yz} &= \tau_{zy} = \mu\left(\eta_z\frac{\partial v}{\partial\eta} + \eta_y\frac{\partial w}{\partial\eta}\right)\\ \Theta_x &= u\tau_{xx} + v\tau_{xy} + w\tau_{xz} + k\eta_x\frac{\partial T}{\partial\eta}\\ \Theta_y &= u\tau_{yx} + v\tau_{yy} + w\tau_{yz} + k\eta_y\frac{\partial T}{\partial\eta}\\ \Theta_z &= u\tau_{zx} + v\tau_{zy} + w\tau_{zz} + k\eta_z\frac{\partial T}{\partial\eta} \end{aligned} \tag{A.52}}

  @bi{
    @lang["en"]{In the above formulae @link["blazek2005-ch12#eq-a-52"]{(A.52)}, the partial derivatives with respect to the Cartesian coordinates were approximated as}
    @lang["zh-Hans"]{在上面的公式@link["blazek2005-ch12#eq-a-52"]{(A.52)}中，对笛卡尔坐标的偏导数近似为}
  }

  @tex-display-math[#:id "eq-a-53"]{\begin{aligned} \frac{\partial u}{\partial x} &\approx \eta_x\frac{\partial u}{\partial\eta}\\ \frac{\partial u}{\partial y} &\approx \eta_y\frac{\partial u}{\partial\eta}\\ \frac{\partial u}{\partial z} &\approx \eta_z\frac{\partial u}{\partial\eta} \end{aligned}, \quad \text{etc.} \tag{A.53}}

  @bi{
    @lang["en"]{in accordance with the TSL assumption.}
    @lang["zh-Hans"]{这与TSL假设一致。}
  }
}

@subtree[#:id "blazek2005-a-7"]{
  @title{A.7 Parabolised Navier-Stokes Equations A.7 抛物化Navier-Stokes方程}

  @bi{
    @lang["en"]{In certain cases, where the following three conditions are met:
      @itemize{
        @item{the flow is steady (i.e., @tex-math{\partial\vec{W}^{*}/\partial t = 0}),}
        @item{the fluid moves predominantly in one main direction (there must be no boundary layer separation),}
        @item{the cross-flow components are negligible,}
      }
    }
    @lang["zh-Hans"]{在满足以下三个条件的某些情形：
      @itemize{
        @item{流动是定常的（即@tex-math{\partial\vec{W}^{*}/\partial t = 0}）；}
        @item{流体主要沿一个主流方向运动（必须不存在边界层分离）；}
        @item{横流分量可以忽略；}
      }
    }
  }

  @bi{
    @lang["en"]{the Navier-Stokes equations (2.19) can be simplified to a form called the @emph{Parabolised Navier-Stokes} (PNS) equations @link["blazek2005-ra-23"]{[23]}. Then, the derivatives of the velocity components and of the temperature with respect to the streamwise direction can be dropped from the viscous stress terms. Furthermore, the components in the streamwise direction of the viscous stress tensor @tex-math{\overline{\overline{\tau}}} and of its work (@tex-math{\overline{\overline{\tau}}\cdot\vec{v}}) can be neglected in the viscous flux vector in Eq. (2.23).}
    @lang["zh-Hans"]{Navier-Stokes方程(2.19)就可以简化为称为@emph{抛物化Navier-Stokes}（Parabolised Navier-Stokes，PNS）方程的形式 @link["blazek2005-ra-23"]{[23]}。此时，速度分量与温度对流向的导数可以从黏性应力项中略去；而且，黏性应力张量@tex-math{\overline{\overline{\tau}}}及其做功（@tex-math{\overline{\overline{\tau}}\cdot\vec{v}}）在流向的分量，在式(2.23)的黏性通量向量中也可以忽略。}
  }

  @bi{
    @lang["en"]{In order to demonstrate the PNS approach, let us consider the differential form of the Navier-Stokes equations written for a general curvilinear grid as given by Eq. @link["blazek2005-ch12#eq-a-4"]{(A.4)}. Let us also assume that the streamwise direction corresponds to the coordinate @tex-math{\xi} and the cross-flow directions to the coordinates @tex-math{\eta} and @tex-math{\zeta}, respectively. Then, the differential form of the 3-D PNS equations reads in a curvilinear coordinate system (@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta})}
    @lang["zh-Hans"]{为演示PNS方法，考察针对一般曲线网格写出的Navier-Stokes方程微分形式（@link["blazek2005-ch12#eq-a-4"]{(A.4)}），并假设流向对应坐标@tex-math{\xi}，横流方向分别对应坐标@tex-math{\eta}与@tex-math{\zeta}。于是，三维PNS方程在曲线坐标系(@tex-math{\xi}, @tex-math{\eta}, @tex-math{\zeta})中的微分形式为}
  }

  @tex-display-math[#:id "eq-a-54"]{\frac{\partial\vec{W}^{*}}{\partial t} + \frac{\partial\vec{F}_{c,1}}{\partial\xi} + \frac{\partial\vec{F}_{c,2}}{\partial\eta} + \frac{\partial\vec{F}_{c,3}}{\partial\zeta} = \frac{\partial\vec{F}_{v,2}}{\partial\eta} + \frac{\partial\vec{F}_{v,3}}{\partial\zeta} + \vec{Q}^{*}. \tag{A.54}}

  @bi{
    @lang["en"]{Hence, the viscous flux in the streamwise direction (@tex-math{\vec{F}_{v,1}}) was assumed to be zero. The partial derivatives of the Cartesian velocity components and of the temperature, which appear in the viscous stress tensor and in the thermal fluxes @link["blazek2005-ch12#eq-a-10"]{(A.10)}, are approximated as}
    @lang["zh-Hans"]{可见，流向的黏性通量（@tex-math{\vec{F}_{v,1}}）被假定为零。黏性应力张量与热通量@link["blazek2005-ch12#eq-a-10"]{(A.10)}中出现的笛卡尔速度分量与温度的偏导数，近似为}
  }

  @tex-display-math[#:id "eq-a-55"]{\begin{aligned} \frac{\partial u}{\partial x} &\approx \eta_x\frac{\partial u}{\partial\eta} + \zeta_x\frac{\partial u}{\partial\zeta}\\ \frac{\partial u}{\partial y} &\approx \eta_y\frac{\partial u}{\partial\eta} + \zeta_y\frac{\partial u}{\partial\zeta}\\ \frac{\partial u}{\partial z} &\approx \eta_z\frac{\partial u}{\partial\eta} + \zeta_z\frac{\partial u}{\partial\zeta} \end{aligned}, \quad \text{etc.} \tag{A.55}}

  @bi{
    @lang["en"]{within the PNS approach instead of using the exact formulae @link["blazek2005-ch12#eq-a-12"]{(A.12)}. The definition of the conservative variables @link["blazek2005-ch12#eq-a-5"]{(A.5)}, the relations for the convective fluxes @link["blazek2005-ch12#eq-a-6"]{(A.6)}, for the two remaining viscous fluxes @link["blazek2005-ch12#eq-a-7"]{(A.7)}, as well as for the source term @link["blazek2005-ch12#eq-a-8"]{(A.8)} remain all unchanged.}
    @lang["zh-Hans"]{这就是PNS方法中所用的近似，用以代替精确公式@link["blazek2005-ch12#eq-a-12"]{(A.12)}。守恒变量的定义@link["blazek2005-ch12#eq-a-5"]{(A.5)}、对流通量的关系式@link["blazek2005-ch12#eq-a-6"]{(A.6)}、其余两个黏性通量的关系式@link["blazek2005-ch12#eq-a-7"]{(A.7)}以及源项@link["blazek2005-ch12#eq-a-8"]{(A.8)}全都保持不变。}
  }
}
@subtree[#:id "blazek2005-a-8"]{
  @title{A.8 Axisymmetric Form of the Navier-Stokes Equations A.8 Navier-Stokes方程的轴对称形式}

  @bi{
    @lang["en"]{In cases where flow is simulated around cylindrical bodies or inside cylindrical cavities, it can often be assumed that it is symmetrical with respect to the longitudinal axis. This means that there is no swirl, and also that the derivatives of the flow quantities in the circumferential direction are zero. Under these conditions, one momentum equation can be dropped from the Navier-Stokes equations (2.19). Thus, the governing equations are reduced from three to two dimensions, which leads to a substantially reduced computational effort.}
    @lang["zh-Hans"]{模拟绕圆柱形物体或圆柱形腔体内部的流动时，通常可以假设流动关于纵轴对称。这意味着不存在旋流（swirl），且各流动量沿周向的导数为零。在这些条件下，可以从Navier-Stokes方程(2.19)中删去一个动量方程，控制方程便由三维降为二维，从而显著减少计算量。}
  }

  @bi{
    @lang["en"]{The axisymmetric form of the Navier-Stokes equations reads}
    @lang["zh-Hans"]{Navier-Stokes方程的轴对称形式为}
  }

  @tex-display-math[#:id "eq-a-56"]{\frac{\partial}{\partial t}\int_{\Omega}\tilde{W}\,d\Omega + \oint_{\partial\Omega}\left(\vec{F}_c - \vec{F}_v\right)r\,dS = \int_{\Omega}\vec{Q}\,d\Omega, \tag{A.56}}

  @bi{
    @lang["en"]{where @tex-math{r} is the coordinate in the radial direction. The vector of the conservative variables consists of the four components}
    @lang["zh-Hans"]{其中@tex-math{r}是径向坐标。守恒变量向量由四个分量组成}
  }

  @tex-display-math[#:id "eq-a-57"]{\tilde{W} = \begin{bmatrix} \rho\\ \rho u\\ \rho v\\ \rho E \end{bmatrix} \tag{A.57}}

  @bi{
    @lang["en"]{with @tex-math{u}, @tex-math{v} being here the velocity components in the axial and the radial direction, respectively. The vector of the convective fluxes is given by}
    @lang["zh-Hans"]{这里@tex-math{u}、@tex-math{v}分别表示轴向与径向的速度分量。对流通量向量为}
  }

  @tex-display-math[#:id "eq-a-58"]{\vec{F}_c = \begin{bmatrix} \rho V\\ \rho uV + n_x p\\ \rho vV + n_r p\\ \rho HV \end{bmatrix}, \tag{A.58}}

  @bi{
    @lang["en"]{where @tex-math{n_x} is the unit normal vector in the axial direction, @tex-math{n_r} in the radial direction, and the contravariant velocity @tex-math{V = n_x u + n_r v}. The vector of the viscous fluxes is defined as}
    @lang["zh-Hans"]{其中@tex-math{n_x}是轴向的单位法向量，@tex-math{n_r}是径向的，逆变速度为@tex-math{V = n_x u + n_r v}。黏性通量向量定义为}
  }

  @tex-display-math[#:id "eq-a-59"]{\vec{F}_v = \begin{bmatrix} 0\\ n_x\tau_{xx} + n_r\tau_{xr}\\ n_x\tau_{rx} + n_r\tau_{rr}\\ n_x\Theta_x + n_r\Theta_r \end{bmatrix}, \tag{A.59}}

  @bi{
    @lang["en"]{where}
    @lang["zh-Hans"]{其中}
  }

  @tex-display-math[#:id "eq-a-60"]{\begin{aligned} \Theta_x &= u\tau_{xx} + v\tau_{xr} + k\frac{\partial T}{\partial x}\\ \Theta_r &= u\tau_{rx} + v\tau_{rr} + k\frac{\partial T}{\partial r} \end{aligned} \tag{A.60}}

  @bi{
    @lang["en"]{are the terms describing the work of the viscous stresses and of the heat conduction in the fluid. Finally, the source term reads}
    @lang["zh-Hans"]{它们描述黏性应力做功与流体中的热传导。最后，源项为}
  }

  @tex-display-math[#:id "eq-a-61"]{\vec{Q} = \frac{1}{r}\begin{bmatrix} 0\\ 0\\ p - \tau_{\theta\theta}\\ 0 \end{bmatrix}. \tag{A.61}}

  @bi{
    @lang["en"]{The components of the viscous stress tensor are given by the relations}
    @lang["zh-Hans"]{黏性应力张量的各分量由以下关系式给出}
  }

  @tex-display-math[#:id "eq-a-62"]{\begin{aligned} \tau_{xx} &= -\frac{2\mu}{3}\vec{\nabla}\cdot\vec{v} + 2\mu\frac{\partial u}{\partial x}\\ \tau_{rr} &= -\frac{2\mu}{3}\vec{\nabla}\cdot\vec{v} + 2\mu\frac{\partial v}{\partial r}\\ \tau_{\theta\theta} &= -\frac{2\mu}{3}\vec{\nabla}\cdot\vec{v} + 2\mu\frac{v}{r}\\ \tau_{xr} &= \tau_{rx} = \mu\left(\frac{\partial u}{\partial r} + \frac{\partial v}{\partial x}\right) \end{aligned} \tag{A.62}}

  @bi{
    @lang["en"]{with the divergence of the velocity}
    @lang["zh-Hans"]{其中速度的散度为}
  }

  @tex-display-math[#:id "eq-a-63"]{\vec{\nabla}\cdot\vec{v} = \frac{\partial u}{\partial x} + \frac{1}{r}\frac{\partial(rv)}{\partial r} = \frac{\partial u}{\partial x} + \frac{\partial v}{\partial r} + \frac{v}{r}. \tag{A.63}}

  @bi{
    @lang["en"]{The boundary conditions at the symmetry line read}
    @lang["zh-Hans"]{对称线处的边界条件为}
  }

  @tex-display-math[#:id "eq-a-64"]{\begin{aligned} \rho v &= 0\\ \frac{\partial u}{\partial r} &= \frac{\partial T}{\partial r} = \frac{\partial p}{\partial r} = 0. \end{aligned} \tag{A.64}}

  @bi{
    @lang["en"]{It should be noted that the volume @tex-math{\Omega} is the product of the area of the control volume and an average radius @tex-math{r}. Thus as we can see, the axisymmetric equations @link["blazek2005-ch12#eq-a-56"]{(A.56)} are like the 2-D Navier-Stokes equations, except for the multiplication by the radius, the additional source term @tex-math{(p - \tau_{\theta\theta})/r}, and the changed definition of @tex-math{\vec{\nabla}\cdot\vec{v}}.}
    @lang["zh-Hans"]{应当注意，体积@tex-math{\Omega}是控制体面积与平均半径@tex-math{r}的乘积。于是可以看到，轴对称方程@link["blazek2005-ch12#eq-a-56"]{(A.56)}与二维Navier-Stokes方程相似，差别只在于：乘以半径、附加源项@tex-math{(p - \tau_{\theta\theta})/r}，以及@tex-math{\vec{\nabla}\cdot\vec{v}}定义的改变。}
  }
}
@subtree[#:id "blazek2005-a-9"]{
  @title{A.9 Convective Flux Jacobian A.9 对流通量雅可比矩阵}

  @bi{
    @lang["en"]{The convective flux Jacobian represents the gradient of the convective fluxes with respect to the conservative variables, i.e.,}
    @lang["zh-Hans"]{对流通量雅可比矩阵表示对流通量对守恒变量的梯度，即}
  }

  @tex-display-math[#:id "eq-a-65"]{\bar{A}_c = \frac{\partial\vec{F}_c}{\partial\vec{W}}, \tag{A.65}}

  @bi{
    @lang["en"]{where @tex-math{\vec{F}_c} is given by Eq. (2.21).}
    @lang["zh-Hans"]{其中@tex-math{\vec{F}_c}由方程(2.21)给出。}
  }

  @emph{2-D Formulation 二维形式}

  @bi{
    @lang["en"]{The Jacobian matrix of the convective fluxes takes in two dimensions the following form @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{对流通量的雅可比矩阵在二维情形下取如下形式@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-66"]{\bar{A}_c = \begin{bmatrix} -V_t & n_x & n_y & 0\\ n_x\phi - uV & V - V_t - a_3 n_x u & n_y u - a_2 n_x v & a_2 n_x\\ n_y\phi - vV & n_x v - a_2 n_y u & V - V_t - a_3 n_y v & a_2 n_y\\ V(\phi - a_1) & n_x a_1 - a_2 uV & n_y a_1 - a_2 vV & \gamma V - V_t \end{bmatrix}, \tag{A.66}}

  @bi{
    @lang["en"]{where}
    @lang["zh-Hans"]{其中}
  }

  @tex-display-math[#:id "eq-a-67"]{\begin{aligned} a_1 &= \gamma E - \phi\\ a_2 &= \gamma - 1\\ a_3 &= \gamma - 2\\ V &= n_x u + n_y v\\ \phi &= \frac{1}{2}(\gamma - 1)\left(u^2 + v^2\right) \end{aligned} \tag{A.67}}

  @bi{
    @lang["en"]{and @tex-math{n_x}, @tex-math{n_y} denote the Cartesian components of the unit normal vector @tex-math{\vec{n}} (Fig. 2.1). Furthermore, @tex-math{\gamma} stands for the ratio of specific heat coefficients and @tex-math{V} represents the contravariant velocity. The contravariant velocity of the face of the control volume (@tex-math{V_t} - see Eq. @link["blazek2005-ch12#eq-a-38"]{(A.38)}) is set to zero for stationary grids.}
    @lang["zh-Hans"]{其中@tex-math{n_x}、@tex-math{n_y}表示单位法向量@tex-math{\vec{n}}的笛卡尔分量（图2.1）。此外，@tex-math{\gamma}表示比热比，@tex-math{V}为逆变速度。控制体面的逆变速度@tex-math{V_t}（见方程@link["blazek2005-ch12#eq-a-38"]{(A.38)}）在网格静止时取为零。}
  }

  @emph{3-D Formulation 三维形式}

  @bi{
    @lang["en"]{The expression for the convective flux Jacobian reads in three dimensions @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{对流通量雅可比矩阵在三维情形下的表达式为@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-68"]{\bar{A}_c = \begin{bmatrix} -V_t & n_x & n_y & n_z & 0\\ n_x\phi - uV & V - V_t - a_3 n_x u & n_y u - a_2 n_x v & n_z u - a_2 n_x w & a_2 n_x\\ n_y\phi - vV & n_x v - a_2 n_y u & V - V_t - a_3 n_y v & n_z v - a_2 n_y w & a_2 n_y\\ n_z\phi - wV & n_x w - a_2 n_z u & n_y w - a_2 n_z v & V - V_t - a_3 n_z w & a_2 n_z\\ V(\phi - a_1) & n_x a_1 - a_2 uV & n_y a_1 - a_2 vV & n_z a_1 - a_2 wV & \gamma V - V_t \end{bmatrix}, \tag{A.68}}

  @bi{
    @lang["en"]{with the abbreviations}
    @lang["zh-Hans"]{其中采用以下缩写}
  }

  @tex-display-math[#:id "eq-a-69"]{\begin{aligned} a_1 &= \gamma E - \phi\\ a_2 &= \gamma - 1\\ a_3 &= \gamma - 2\\ V &= n_x u + n_y v + n_z w\\ \phi &= \frac{1}{2}(\gamma - 1)\left(u^2 + v^2 + w^2\right). \end{aligned} \tag{A.69}}

  @bi{
    @lang["en"]{In the above relations @link["blazek2005-ch12#eq-a-68"]{(A.68)} and @link["blazek2005-ch12#eq-a-69"]{(A.69)}, respectively, @tex-math{n_x}, @tex-math{n_y}, and @tex-math{n_z} denote the Cartesian components of the unit normal vector @tex-math{\vec{n}} (see Fig. 2.1). In the case of stationary grids, we have to set @tex-math{V_t = 0}.}
    @lang["zh-Hans"]{在上述关系式@link["blazek2005-ch12#eq-a-68"]{(A.68)}与@link["blazek2005-ch12#eq-a-69"]{(A.69)}中，@tex-math{n_x}、@tex-math{n_y}与@tex-math{n_z}表示单位法向量@tex-math{\vec{n}}的笛卡尔分量（参见图2.1）。网格静止时，须取@tex-math{V_t = 0}。}
  }
}

@subtree[#:id "blazek2005-a-10"]{
  @title{A.10 Viscous Flux Jacobian A.10 黏性通量雅可比矩阵}

  @bi{
    @lang["en"]{The viscous flux Jacobian represents the gradient of the viscous fluxes with respect to the conservative variables, i.e.,}
    @lang["zh-Hans"]{黏性通量雅可比矩阵表示黏性通量对守恒变量的梯度，即}
  }

  @tex-display-math[#:id "eq-a-70"]{\bar{A}_v = \frac{\partial\vec{F}_v}{\partial\vec{W}}, \tag{A.70}}

  @bi{
    @lang["en"]{where @tex-math{\vec{F}_v} is given by Eq. (2.23). In the following, we shall consider for simplicity the Thin Shear Layer (TSL) approximation of the Navier-Stokes equations only (cf. Subsection 2.4.3 and Section A.6). Furthermore, it is assumed that the dynamic viscosity and the thermal conductivity coefficients are frozen with respect to changes of the conservative variables and in space.}
    @lang["zh-Hans"]{其中@tex-math{\vec{F}_v}由方程(2.23)给出。下面为简单起见，我们只考虑Navier-Stokes方程的薄剪切层（Thin Shear Layer，TSL）近似（参见2.4.3小节与A.6节）。此外，假定动力黏度系数与导热系数相对守恒变量的变化以及在空间中都冻结不变。}
  }

  @emph{2-D Formulation 二维形式}

  @bi{
    @lang["en"]{The 2-D viscous flux Jacobian reads in curvilinear coordinates for the TSL approximation @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{在曲线坐标中，TSL近似下的二维黏性通量雅可比矩阵为@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-71"]{\bar{A}_v = \frac{\mu}{J}\begin{bmatrix} 0 & 0 & 0 & 0\\ b_{21} & a_1\partial_\psi(\rho^{-1}) & a_2\partial_\psi(\rho^{-1}) & 0\\ b_{31} & a_2\partial_\psi(\rho^{-1}) & a_3\partial_\psi(\rho^{-1}) & 0\\ b_{41} & b_{42} & b_{43} & a_4\partial_\psi(\rho^{-1}) \end{bmatrix}, \tag{A.71}}

  @bi{
    @lang["en"]{where @tex-math{J} represents the determinant of the coordinate transformation Jacobian correspondingly to Eq. @link["blazek2005-ch12#eq-a-13"]{(A.13)}. The coefficients @tex-math{a} and @tex-math{b} are given by}
    @lang["zh-Hans"]{其中@tex-math{J}表示坐标变换雅可比矩阵的行列式，与方程@link["blazek2005-ch12#eq-a-13"]{(A.13)}相对应。系数@tex-math{a}与@tex-math{b}由下式给出}
  }

  @tex-display-math[#:id "eq-a-72"]{\begin{aligned} b_{21} &= -a_1\partial_\psi(u/\rho) - a_2\partial_\psi(v/\rho)\\ b_{31} &= -a_2\partial_\psi(u/\rho) - a_3\partial_\psi(v/\rho)\\ b_{41} &= a_4\partial_\psi\left[(u^2 + v^2)/\rho - E/\rho\right] - a_1\partial_\psi(u^2/\rho) - {}\\ &\quad 2a_2\partial_\psi(uv/\rho) - a_3\partial_\psi(v^2/\rho)\\ b_{42} &= -a_4\partial_\psi(u/\rho) - b_{21}\\ b_{43} &= -a_4\partial_\psi(v/\rho) - b_{31}\\ a_1 &= (4/3)\psi_x^2 + \psi_y^2\\ a_2 &= (1/3)\psi_x\psi_y\\ a_3 &= \psi_x^2 + (4/3)\psi_y^2\\ a_4 &= (\gamma/Pr)\left(\psi_x^2 + \psi_y^2\right). \end{aligned} \tag{A.72}}

  @bi{
    @lang["en"]{In the above relations, @tex-math{\mu} stands for the dynamic viscosity coefficient, @tex-math{\gamma} for the ratio of specific heat coefficients and @tex-math{Pr} denotes the Prandtl number, respectively.}
    @lang["zh-Hans"]{在上述关系中，@tex-math{\mu}表示动力黏度系数，@tex-math{\gamma}为比热比，@tex-math{Pr}为Prandtl数。}
  }

  @bi{
    @lang["en"]{The terms @tex-math{\partial_\psi(\,) = \partial(\,)/\partial\psi} must be conceived as operators. Let us consider for illustration the term @tex-math{a_1\partial_\psi(\rho^{-1})} in Eq. @link["blazek2005-ch12#eq-a-71"]{(A.71)}. Within many implicit schemes, the viscous flux Jacobian @tex-math{\bar{A}_v} is multiplied by the change of the conservative variables @tex-math{\Delta\vec{W} = \vec{W}^{n+1} - \vec{W}^n}. Hence, the complete term would read}
    @lang["zh-Hans"]{项@tex-math{\partial_\psi(\,) = \partial(\,)/\partial\psi}必须视为算子。为便于说明，考察方程@link["blazek2005-ch12#eq-a-71"]{(A.71)}中的项@tex-math{a_1\partial_\psi(\rho^{-1})}。在许多隐式格式中，黏性通量雅可比矩阵@tex-math{\bar{A}_v}要与守恒变量的改变量@tex-math{\Delta\vec{W} = \vec{W}^{n+1} - \vec{W}^n}相乘。因此，完整的项应写作}
  }

  @tex-display-math[#:id "eq-a-73"]{\left[J^{-1}\mu a_1\partial_\psi(\rho^{-1})\right]\Delta W_2 = A_{22}\Delta W_2. \tag{A.73}}

  @bi{
    @lang["en"]{If we discretise now the above term on structured grid using backward differences, we obtain at the mid-point @tex-math{(i+1/2)}}
    @lang["zh-Hans"]{如果在结构网格上用后向差分离散上述项，则在中点@tex-math{(i+1/2)}处得到}
  }

  @tex-display-math[#:id "eq-a-74"]{\left[A_{22}\Delta W_2\right]_{i+1/2} = J^{-1}_{i+1/2}\,\mu_{i+1/2}\,(a_1)_{i+1/2}\,\frac{\left(\frac{\Delta W_2}{\rho}\right)_{i+1} - \left(\frac{\Delta W_2}{\rho}\right)_i}{\Delta\psi}. \tag{A.74}}

  @bi{
    @lang["en"]{Jacobian matrices for specific coordinate directions result if we set @tex-math{\psi = \xi} or @tex-math{\psi = \eta}, respectively.}
    @lang["zh-Hans"]{若令@tex-math{\psi = \xi}或@tex-math{\psi = \eta}，即得到相应坐标方向的雅可比矩阵。}
  }

  @emph{3-D Formulation 三维形式}

  @bi{
    @lang["en"]{The 3-D viscous flux Jacobian takes in curvilinear coordinates the following form for the TSL approximation @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{在曲线坐标中，TSL近似下的三维黏性通量雅可比矩阵取如下形式@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-75"]{\bar{A}_v = \frac{\mu}{J}\begin{bmatrix} 0 & 0 & 0 & 0 & 0\\ b_{21} & a_1\partial_\psi(\rho^{-1}) & a_2\partial_\psi(\rho^{-1}) & a_3\partial_\psi(\rho^{-1}) & 0\\ b_{31} & a_2\partial_\psi(\rho^{-1}) & a_4\partial_\psi(\rho^{-1}) & a_5\partial_\psi(\rho^{-1}) & 0\\ b_{41} & a_3\partial_\psi(\rho^{-1}) & a_5\partial_\psi(\rho^{-1}) & a_6\partial_\psi(\rho^{-1}) & 0\\ b_{51} & b_{52} & b_{53} & b_{54} & a_7\partial_\psi(\rho^{-1}) \end{bmatrix}, \tag{A.75}}

  @bi{
    @lang["en"]{where}
    @lang["zh-Hans"]{其中}
  }

  @tex-display-math[#:id "eq-a-76"]{\begin{aligned} b_{21} &= -a_1\partial_\psi(u/\rho) - a_2\partial_\psi(v/\rho) - a_3\partial_\psi(w/\rho)\\ b_{31} &= -a_2\partial_\psi(u/\rho) - a_4\partial_\psi(v/\rho) - a_5\partial_\psi(w/\rho)\\ b_{41} &= -a_3\partial_\psi(u/\rho) - a_5\partial_\psi(v/\rho) - a_6\partial_\psi(w/\rho)\\ b_{51} &= a_7\partial_\psi\left[(u^2 + v^2 + w^2)/\rho - E/\rho\right] - {}\\ &\quad a_1\partial_\psi(u^2/\rho) - a_4\partial_\psi(v^2/\rho) - a_6\partial_\psi(w^2/\rho) - {}\\ &\quad 2a_2\partial_\psi(uv/\rho) - 2a_3\partial_\psi(uw/\rho) - 2a_5\partial_\psi(vw/\rho)\\ b_{52} &= -a_7\partial_\psi(u/\rho) - b_{21}\\ b_{53} &= -a_7\partial_\psi(v/\rho) - b_{31}\\ b_{54} &= -a_7\partial_\psi(w/\rho) - b_{41} \end{aligned} \tag{A.76}}

  @bi{
    @lang["en"]{and}
    @lang["zh-Hans"]{以及}
  }

  @tex-display-math[#:id "eq-a-77"]{\begin{aligned} a_1 &= (4/3)\psi_x^2 + \psi_y^2 + \psi_z^2\\ a_2 &= (1/3)\psi_x\psi_y\\ a_3 &= (1/3)\psi_x\psi_z\\ a_5 &= (1/3)\psi_y\psi_z\\ a_4 &= \psi_x^2 + (4/3)\psi_y^2 + \psi_z^2\\ a_6 &= \psi_x^2 + \psi_y^2 + (4/3)\psi_z^2\\ a_7 &= (\gamma/Pr)\left(\psi_x^2 + \psi_y^2 + \psi_z^2\right). \end{aligned} \tag{A.77}}

  @bi{
    @lang["en"]{Again, the terms @tex-math{\partial_\psi(\,) = \partial(\,)/\partial\psi} have to be treated as operators. Jacobian matrices for specific coordinate directions are obtained by setting @tex-math{\psi = \xi} or @tex-math{\psi = \eta} or @tex-math{\psi = \zeta}, respectively.}
    @lang["zh-Hans"]{同样，各项@tex-math{\partial_\psi(\,) = \partial(\,)/\partial\psi}也必须当作算子处理。令@tex-math{\psi = \xi}、@tex-math{\psi = \eta}或@tex-math{\psi = \zeta}，即得到相应坐标方向的雅可比矩阵。}
  }

  @bi{
    @lang["en"]{In the case of a finite volume discretisation, the metric terms @tex-math{\psi_x}, @tex-math{\psi_y} and @tex-math{\psi_z}, can be transformed into the components of the face vector @tex-math{\vec{S} = \vec{n}\Delta S} according to Eq. @link["blazek2005-ch12#eq-a-17"]{(A.17)}. Furthermore, the determinant of the Jacobian of the coordinate transformation @tex-math{J} is replaced by the inverse of the volume formed around the face of the control volume as indicated by Fig. A.1 and by Eq. @link["blazek2005-ch12#eq-a-20"]{(A.20)}. Thus, if we repeat the example of Eq. @link["blazek2005-ch12#eq-a-73"]{(A.73)} for a finite volume scheme, the product @tex-math{J^{-1}a_1} in Eq. @link["blazek2005-ch12#eq-a-72"]{(A.72)} will read}
    @lang["zh-Hans"]{在有限体积离散的情形下，度量项@tex-math{\psi_x}、@tex-math{\psi_y}与@tex-math{\psi_z}可以按照方程@link["blazek2005-ch12#eq-a-17"]{(A.17)}变换为面向量@tex-math{\vec{S} = \vec{n}\Delta S}的分量。此外，坐标变换雅可比矩阵的行列式@tex-math{J}要用围绕控制体面所形成体积的倒数来代替，如图A.1与方程@link["blazek2005-ch12#eq-a-20"]{(A.20)}所示。于是，若就有限体积格式重复方程@link["blazek2005-ch12#eq-a-73"]{(A.73)}的例子，方程@link["blazek2005-ch12#eq-a-72"]{(A.72)}中的乘积@tex-math{J^{-1}a_1}将成为}
  }

  @tex-display-math[#:id "eq-a-78"]{J^{-1}a_1 = \frac{2}{\Omega^{*}}\left(\frac{4}{3}S_x^2 + S_y^2\right). \tag{A.78}}

  @bi{
    @lang["en"]{It should be noted that the face area was included in Eq. @link["blazek2005-ch12#eq-a-78"]{(A.78)} to reflect the multiplication of the viscous fluxes with @tex-math{\Delta S} when the residual is computed - @tex-math{\vec{F}_v} itself contains only the components of the unit normal vector. The discretisation at the mid-point @tex-math{(i+1/2)} then becomes}
    @lang["zh-Hans"]{应当注意，方程@link["blazek2005-ch12#eq-a-78"]{(A.78)}中包含了面面积，以体现计算残差时黏性通量与@tex-math{\Delta S}的相乘——@tex-math{\vec{F}_v}本身只含单位法向量的分量。于是，中点@tex-math{(i+1/2)}处的离散化为}
  }

  @tex-display-math[#:id "eq-a-79"]{\left[A_{22}\Delta W_2\right]_{i+1/2} = \frac{2\,\mu_{i+1/2}}{\Omega^{*}_{i+1/2}}\left(\frac{4}{3}S_x^2 + S_y^2\right)\left[\left(\frac{\Delta W_2}{\rho}\right)_{i+1} - \left(\frac{\Delta W_2}{\rho}\right)_i\right], \tag{A.79}}

  @bi{
    @lang["en"]{where we assumed @tex-math{\Delta\psi = 1} due to the definition of @tex-math{\vec{S}^I} and @tex-math{\vec{S}^J} (see Fig. A.1 and Equations @link["blazek2005-ch12#eq-a-15"]{(A.15)}, @link["blazek2005-ch12#eq-a-16"]{(A.16)}).}
    @lang["zh-Hans"]{其中由于@tex-math{\vec{S}^I}与@tex-math{\vec{S}^J}的定义（参见图A.1以及方程@link["blazek2005-ch12#eq-a-15"]{(A.15)}、@link["blazek2005-ch12#eq-a-16"]{(A.16)}），我们取@tex-math{\Delta\psi = 1}。}
  }
}

@subtree[#:id "blazek2005-a-11"]{
  @title{A.11 Transformation from Conservative to Characteristic Variables A.11 从守恒变量到特征变量的变换}

  @bi{
    @lang["en"]{The convective flux Jacobian (Section A.9) has real eigenvalues and a complete set of eigenvectors. Therefore, the Jacobians can be diagonalised @link["blazek2005-ra-25"]{[25]} as}
    @lang["zh-Hans"]{对流通量雅可比矩阵（A.9节）具有实特征值和完备的特征向量组。因此，这些雅可比矩阵可以对角化为@link["blazek2005-ra-25"]{[25]}}
  }

  @tex-display-math[#:id "eq-a-80"]{\bar{A}_c = \bar{T}\bar{\Lambda}_c\bar{T}^{-1}, \tag{A.80}}

  @bi{
    @lang["en"]{where @tex-math{\bar{T}^{-1}} denotes the matrix of the left eigenvectors, @tex-math{\bar{T}} of the right eigenvectors and @tex-math{\bar{\Lambda}_c} represents the diagonal matrix of the eigenvalues, respectively. The transformation from conservative (@tex-math{\vec{W}}) to characteristic variables (@tex-math{\vec{C}}) reads for an arbitrary variation @tex-math{\delta} (like @tex-math{\partial_t} or @tex-math{\vec{\nabla}})}
    @lang["zh-Hans"]{其中@tex-math{\bar{T}^{-1}}表示左特征向量矩阵，@tex-math{\bar{T}}表示右特征向量矩阵，@tex-math{\bar{\Lambda}_c}表示特征值的对角矩阵。对任意变分@tex-math{\delta}（如@tex-math{\partial_t}或@tex-math{\vec{\nabla}}），从守恒变量（@tex-math{\vec{W}}）到特征变量（@tex-math{\vec{C}}）的变换为}
  }

  @tex-display-math[#:id "eq-a-81"]{\delta\vec{C} = \bar{T}^{-1}\delta\vec{W}. \tag{A.81}}

  @bi{
    @lang["en"]{The diagonalisation of the convective flux Jacobian can be viewed as a decomposition into different waves. The right eigenvectors represent the waves, the characteristic variables are the wave amplitudes, and finally the eigenvalues are the associated wave speeds. In the context of the diagonalisation that will be presented below, we differentiate between two types of waves. First, there are @emph{convective} or @emph{linear} waves, which are connected to eigenvalues of the type @tex-math{\Lambda_c = \vec{v}\cdot\vec{n}}. Second, there are @emph{acoustic} waves which are related to eigenvalues of the type @tex-math{\Lambda_c = \vec{v}\cdot\vec{n} \pm c}. It should be noted that the diagonalisation cannot be conducted simultaneously in multiple spatial directions @link["blazek2005-ra-26"]{[26]}. This is the reason why the flux-difference splitting and the TVD schemes employ only 1-D wave decomposition. Only the fluctuation-splitting schemes (see Subsection 3.1.5) use an @emph{approximate} multidimensional decomposition.}
    @lang["zh-Hans"]{对流通量雅可比矩阵的对角化可以看作分解为不同的波。右特征向量代表波，特征变量是波的振幅，而特征值则是相应的波速。在下面将要介绍的对角化中，我们区分两类波。第一类是对流波（convective）或线性波（linear），与@tex-math{\Lambda_c = \vec{v}\cdot\vec{n}}型的特征值相联系；第二类是声波（acoustic），与@tex-math{\Lambda_c = \vec{v}\cdot\vec{n} \pm c}型的特征值相联系。应当注意，这种对角化无法同时在多个空间方向上进行@link["blazek2005-ra-26"]{[26]}。这正是通量差分分裂格式与TVD格式只采用一维波分解的原因。只有波动分裂格式（fluctuation-splitting，见3.1.5小节）才使用近似的多维分解。}
  }

  @emph{2-D Formulation 二维形式}

  @bi{
    @lang["en"]{The matrix of the left eigenvectors of @tex-math{\bar{A}_c} appears as follows in two dimensions @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{二维情形下，@tex-math{\bar{A}_c}的左特征向量矩阵如下@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-82"]{\bar{T}^{-1} = \begin{bmatrix} 1 - \phi c^{-2} & a_1 u c^{-2} & a_1 v c^{-2} & -a_1 c^{-2}\\ -(n_x u - n_y v)\rho^{-1} & n_y\rho^{-1} & -n_x\rho^{-1} & 0\\ a_2(\phi - cV) & a_2(n_x c - a_1 u) & a_2(n_y c - a_1 v) & a_1 a_2\\ a_2(\phi + cV) & -a_2(n_x c + a_1 u) & -a_2(n_y c + a_1 v) & a_1 a_2 \end{bmatrix}. \tag{A.82}}

  @bi{
    @lang["en"]{The matrix of the right eigenvectors assumes the form @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{右特征向量矩阵取如下形式@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-83"]{\bar{T} = \begin{bmatrix} 1 & 0 & a_3 & a_3\\ u & n_y\rho & a_3(u + n_x c) & a_3(u - n_x c)\\ v & -n_x\rho & a_3(v + n_y c) & a_3(v - n_y c)\\ \phi a_1^{-1} & \rho(n_y u - n_x v) & a_3(a_4 + cV) & a_3(a_4 - cV) \end{bmatrix}. \tag{A.83}}

  @bi{
    @lang["en"]{The diagonal matrix contains the real eigenvalues}
    @lang["zh-Hans"]{对角矩阵包含实特征值}
  }

  @tex-display-math[#:id "eq-a-84"]{\bar{\Lambda}_c = \begin{bmatrix} \Lambda_1 & 0 & 0 & 0\\ 0 & \Lambda_2 & 0 & 0\\ 0 & 0 & \Lambda_3 & 0\\ 0 & 0 & 0 & \Lambda_4 \end{bmatrix}. \tag{A.84}}

  @bi{
    @lang["en"]{The following definitions apply in the above relationships}
    @lang["zh-Hans"]{上述关系中用到的定义如下}
  }

  @tex-display-math[#:id "eq-a-85"]{\begin{aligned} a_1 &= \gamma - 1\\ a_2 &= \frac{1}{\rho c\sqrt{2}}\\ a_3 &= \frac{\rho}{c\sqrt{2}}\\ a_4 &= \frac{\phi + c^2}{\gamma - 1}\\ V &= n_x u + n_y v\\ \phi &= \frac{1}{2}(\gamma - 1)\left(u^2 + v^2\right)\\ \Lambda_1 &= \Lambda_2 = V - V_t\\ \Lambda_3 &= V - V_t + c\\ \Lambda_4 &= V - V_t - c. \end{aligned} \tag{A.85}}

  @bi{
    @lang["en"]{Furthermore, @tex-math{\gamma} denotes the ratio of specific heat coefficients, @tex-math{c} the speed of sound, @tex-math{\vec{n} = [n_x, n_y]^T} the unit normal vector, and @tex-math{V} the contravariant velocity, respectively. Finally, @tex-math{V_t} represents the contravariant velocity of the face of the control volume as given by Eq. @link["blazek2005-ch12#eq-a-38"]{(A.38)}. In the case of stationary grids, @tex-math{V_t} has to be set to zero.}
    @lang["zh-Hans"]{此外，@tex-math{\gamma}表示比热比，@tex-math{c}为声速，@tex-math{\vec{n} = [n_x, n_y]^T}为单位法向量，@tex-math{V}为逆变速度。最后，@tex-math{V_t}表示控制体面的逆变速度，由方程@link["blazek2005-ch12#eq-a-38"]{(A.38)}给出。网格静止时，@tex-math{V_t}须取为零。}
  }

  @emph{3-D Formulation 三维形式}

  @bi{
    @lang["en"]{The matrix of the left eigenvectors of @tex-math{\bar{A}_c} becomes in three dimensions @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{三维情形下，@tex-math{\bar{A}_c}的左特征向量矩阵为@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-86"]{\bar{T}^{-1} = \begin{bmatrix} n_x a_5 - (n_z v - n_y w)\rho^{-1} & n_x a_1 u c^{-2} & n_x a_1 v c^{-2} + n_z\rho^{-1} & n_x a_1 w c^{-2} - n_y\rho^{-1} & -n_x a_1 c^{-2}\\ n_y a_5 - (n_x w - n_z u)\rho^{-1} & n_y a_1 u c^{-2} - n_z\rho^{-1} & n_y a_1 v c^{-2} & n_y a_1 w c^{-2} - n_x\rho^{-1} & -n_y a_1 c^{-2}\\ n_z a_5 - (n_y u - n_x v)\rho^{-1} & n_z a_1 u c^{-2} + n_y\rho^{-1} & n_z a_1 v c^{-2} - n_x\rho^{-1} & n_z a_1 w c^{-2} & -n_z a_1 c^{-2}\\ a_2(\phi - cV) & -a_2(a_1 u - n_x c) & -a_2(a_1 v - n_y c) & -a_2(a_1 w - n_z c) & a_1 a_2\\ a_2(\phi + cV) & -a_2(a_1 u + n_x c) & -a_2(a_1 v + n_y c) & -a_2(a_1 w + n_z c) & a_1 a_2 \end{bmatrix}. \tag{A.86}}

  @bi{
    @lang["en"]{The matrix of the right eigenvectors reads @link["blazek2005-ra-24"]{[24]}}
    @lang["zh-Hans"]{右特征向量矩阵为@link["blazek2005-ra-24"]{[24]}}
  }

  @tex-display-math[#:id "eq-a-87"]{\bar{T} = \begin{bmatrix} n_x & n_y & n_z & a_3 & a_3\\ n_x u & n_y u - n_z\rho & n_z u + n_y\rho & a_3(u + n_x c) & a_3(u - n_x c)\\ n_x v + n_z\rho & n_y v & n_z v - n_x\rho & a_3(v + n_y c) & a_3(v - n_y c)\\ n_x w - n_y\rho & n_y w + n_x\rho & n_z w & a_3(w + n_z c) & a_3(w - n_z c)\\ n_x a_6 + \rho(n_z v - n_y w) & n_y a_6 + \rho(n_x w - n_z u) & n_z a_6 + \rho(n_y u - n_x v) & a_3(a_4 + cV) & a_3(a_4 - cV) \end{bmatrix}. \tag{A.87}}

  @bi{
    @lang["en"]{The diagonal matrix contains the real eigenvalues}
    @lang["zh-Hans"]{对角矩阵包含实特征值}
  }

  @tex-display-math[#:id "eq-a-88"]{\bar{\Lambda}_c = \begin{bmatrix} \Lambda_1 & 0 & 0 & 0 & 0\\ 0 & \Lambda_2 & 0 & 0 & 0\\ 0 & 0 & \Lambda_3 & 0 & 0\\ 0 & 0 & 0 & \Lambda_4 & 0\\ 0 & 0 & 0 & 0 & \Lambda_5 \end{bmatrix}. \tag{A.88}}

  @bi{
    @lang["en"]{The following abbreviations were used}
    @lang["zh-Hans"]{其中使用了以下缩写}
  }

  @tex-display-math[#:id "eq-a-89"]{\begin{aligned} a_1 &= \gamma - 1\\ a_2 &= \frac{1}{\rho c\sqrt{2}}\\ a_3 &= \frac{\rho}{c\sqrt{2}}\\ a_4 &= \frac{\phi + c^2}{\gamma - 1}\\ a_5 &= 1 - \frac{\phi}{c^2}\\ a_6 &= \frac{\phi}{\gamma - 1}\\ V &= n_x u + n_y v + n_z w\\ \phi &= \frac{1}{2}(\gamma - 1)\left(u^2 + v^2 + w^2\right)\\ \Lambda_1 &= \Lambda_2 = \Lambda_3 = V - V_t\\ \Lambda_4 &= V - V_t + c\\ \Lambda_5 &= V - V_t - c. \end{aligned} \tag{A.89}}

  @bi{
    @lang["en"]{In the above relations Eqs. @link["blazek2005-ch12#eq-a-86"]{(A.86)}-@link["blazek2005-ch12#eq-a-89"]{(A.89)}, @tex-math{\gamma} denotes the ratio of specific heat coefficients, @tex-math{c} the speed of sound, @tex-math{\vec{n} = [n_x, n_y, n_z]^T} the unit normal vector, and @tex-math{V} the contravariant velocity, respectively. Finally, @tex-math{V_t} represents the contravariant velocity of the face of the control volume as given by Eq. @link["blazek2005-ch12#eq-a-38"]{(A.38)}. In the case of stationary grids, @tex-math{V_t} has to be set to zero.}
    @lang["zh-Hans"]{在上述关系式@link["blazek2005-ch12#eq-a-86"]{(A.86)}–@link["blazek2005-ch12#eq-a-89"]{(A.89)}中，@tex-math{\gamma}表示比热比，@tex-math{c}为声速，@tex-math{\vec{n} = [n_x, n_y, n_z]^T}为单位法向量，@tex-math{V}为逆变速度。最后，@tex-math{V_t}表示控制体面的逆变速度，由方程@link["blazek2005-ch12#eq-a-38"]{(A.38)}给出。网格静止时，@tex-math{V_t}须取为零。}
  }
}

@subtree[#:id "blazek2005-a-12"]{
  @title{A.12 GMRES Algorithm A.12 GMRES算法}

  @bi{
    @lang["en"]{Consider the system of linear equations}
    @lang["zh-Hans"]{考察如下线性方程组}
  }

  @tex-display-math[#:id "eq-a-90"]{\bar{A}\vec{x} = \vec{b}. \tag{A.90}}

  @bi{
    @lang["en"]{We are looking for an approximate solution of the form}
    @lang["zh-Hans"]{我们寻找如下形式的近似解}
  }

  @tex-display-math[#:id "eq-a-91"]{\vec{x} = \vec{x}_0 + \vec{z}, \tag{A.91}}

  @bi{
    @lang["en"]{where @tex-math{\vec{x}_0} represents an initial guess and @tex-math{\vec{z}} is a member of the Krylov subspace}
    @lang["zh-Hans"]{其中@tex-math{\vec{x}_0}表示初始猜测，@tex-math{\vec{z}}属于Krylov子空间}
  }

  @tex-display-math[#:id "eq-a-92"]{\vec{z}\in\mathcal{K}_m, \quad \mathcal{K}_m \equiv \mathrm{span}\left\{\vec{r}_0, \bar{A}\vec{r}_0, \bar{A}^2\vec{r}_0, \dots, \bar{A}^{m-1}\vec{r}_0\right\} \tag{A.92}}

  @bi{
    @lang["en"]{with @tex-math{\vec{r}_0 = \vec{b} - \bar{A}\vec{x}_0}, and @tex-math{m} being the dimension of @tex-math{\mathcal{K}}. The parameter @tex-math{m} is also termed the number of search directions. The @emph{Generalised Minimal Residual} (GMRES) algorithm @link["blazek2005-ra-27"]{[27]} determines @tex-math{\vec{z}} in such a way that the 2-norm of the residual, i.e.,}
    @lang["zh-Hans"]{其中@tex-math{\vec{r}_0 = \vec{b} - \bar{A}\vec{x}_0}，@tex-math{m}为@tex-math{\mathcal{K}}的维数。参数@tex-math{m}也称为搜索方向数。广义极小残量（Generalised Minimal Residual，GMRES）算法@link["blazek2005-ra-27"]{[27]}按如下方式确定@tex-math{\vec{z}}：使残差的2-范数，即}
  }

  @tex-display-math[#:id "eq-a-93"]{\left\|\vec{b} - \bar{A}(\vec{x}_0 + \vec{z})\right\| \tag{A.93}}

  @bi{
    @lang["en"]{is minimised. In the following, we present the particular steps of the GMRES algorithm.}
    @lang["zh-Hans"]{达到极小。下面给出GMRES算法的各个步骤。}
  }

  @emph{1. Computation of the orthonormal basis of @tex-math{\mathcal{K}_m} 1. 计算@tex-math{\mathcal{K}_m}的标准正交基}

  @bi{
    @lang["en"]{We employ the modified Gram-Schmidt procedure}
    @lang["zh-Hans"]{我们采用修正的Gram-Schmidt方法}
  }

  @tex-display-math{\begin{aligned} \vec{r}_0 &= \vec{b} - \bar{A}\vec{x}_0\\ \vec{v}_1 &= \vec{r}_0/\left\|\vec{r}_0\right\|\\ &\text{DO } j = 1, m\\ &\quad \vec{v}_{j+1} = \bar{A}\vec{v}_j\\ &\quad \text{DO } i = 1, j\\ &\qquad h_{i,j} = \vec{v}_{j+1}\cdot\vec{v}_i\\ &\qquad \vec{v}_{j+1} = \vec{v}_{j+1} - h_{i,j}\,\vec{v}_i\\ &\quad \text{ENDDO}\\ &\quad h_{j+1,j} = \left\|\vec{v}_{j+1}\right\|\\ &\quad \vec{v}_{j+1} = \vec{v}_{j+1}/h_{j+1,j}\\ &\text{ENDDO} \end{aligned}}

  @bi{
    @lang["en"]{where @tex-math{h_{i,j}} denotes the coefficients of the upper Hessenberg matrix (@tex-math{i} = line, @tex-math{j} = column). However, the matrix is extended by the elements @tex-math{h_{j+1,j}}. Therefore, the dimensions becomes @tex-math{(m+1)\times m}.@sidenote{译注：原书此句印作“the dimensions becomes”，按语法应为“the dimensions become”。}}
    @lang["zh-Hans"]{其中@tex-math{h_{i,j}}表示上Hessenberg矩阵的系数（@tex-math{i}为行，@tex-math{j}为列）。不过，该矩阵还附加了元素@tex-math{h_{j+1,j}}，因此其维数为@tex-math{(m+1)\times m}。}
  }

  @emph{2. Generation of the upper Hessenberg matrix 2. 生成上Hessenberg矩阵}

  @bi{
    @lang["en"]{The matrix has the following almost triangular form}
    @lang["zh-Hans"]{该矩阵具有如下近似三角的形式}
  }

  @tex-display-math[#:id "eq-a-94"]{\bar{H}^{*}_m = \left[\begin{array}{ccccc} h_{1,1} & h_{1,2} & \cdots & h_{1,m-1} & h_{1,m}\\ h_{2,1} & h_{2,2} & \cdots & h_{2,m-1} & h_{2,m}\\ 0 & h_{3,2} & \ddots & \vdots & \vdots\\ \vdots & 0 & \ddots & h_{m-1,m-1} & h_{m-1,m}\\ \vdots & \vdots & \ddots & h_{m,m-1} & h_{m,m}\\ 0 & 0 & \cdots & 0 & h_{m+1,m} \end{array}\right]^{(m+1)\times m} \tag{A.94}}

  @bi{
    @lang["en"]{It is used further below to formulate and solve the minimisation problem for the residual (Eq. @link["blazek2005-ch12#eq-a-93"]{(A.93)}).}
    @lang["zh-Hans"]{它将在下文用于表述并求解残差的极小化问题（方程@link["blazek2005-ch12#eq-a-93"]{(A.93)}）。}
  }

  @emph{3. Minimisation of the residual 3. 残差的极小化}

  @bi{
    @lang["en"]{The correction of the start solution @tex-math{\vec{x}_0} is defined as @link["blazek2005-ra-27"]{[27]}}
    @lang["zh-Hans"]{初始解@tex-math{\vec{x}_0}的修正定义为@link["blazek2005-ra-27"]{[27]}}
  }

  @tex-display-math[#:id "eq-a-95"]{\vec{z} = \sum_{j=1}^{m} y_j\vec{v}_j, \tag{A.95}}

  @bi{
    @lang["en"]{where @tex-math{y_j} are the components of the vector}
    @lang["zh-Hans"]{其中@tex-math{y_j}是向量}
  }

  @tex-display-math[#:id "eq-a-96"]{\vec{y} = \left[y_1, y_2, \cdots, y_m\right]^T. \tag{A.96}}

  @bi{
    @lang["en"]{Furthermore, it can be shown that}
    @lang["zh-Hans"]{的分量。此外，可以证明}
  }

  @tex-display-math[#:id "eq-a-97"]{\bar{A}\bar{V}_m = \bar{V}_{m+1}\bar{H}^{*}_m \tag{A.97}}

  @bi{
    @lang["en"]{with}
    @lang["zh-Hans"]{其中}
  }

  @tex-display-math[#:id "eq-a-98"]{\bar{V}_m = \left[\vec{v}_1, \vec{v}_2, \cdots, \vec{v}_m\right] \tag{A.98}}

  @bi{
    @lang["en"]{being a matrix with @tex-math{\vec{v}_j} as columns. Let us introduce the notation}
    @lang["zh-Hans"]{是以@tex-math{\vec{v}_j}为列的矩阵。引入记号}
  }

  @tex-display-math[#:id "eq-a-99"]{\vec{e} = \left[\left\|\vec{r}_0\right\|, 0, \cdots, 0\right]^T, \tag{A.99}}

  @bi{
    @lang["en"]{where @tex-math{\vec{e}} has @tex-math{(m+1)} elements. Using the definition of Eq. @link["blazek2005-ch12#eq-a-99"]{(A.99)}, we observe that @tex-math{\vec{r}_0 = \vec{b} - \bar{A}\vec{x}_0 = \bar{V}_{m+1}\vec{e}}. Hence, we obtain for the residual Eq. @link["blazek2005-ch12#eq-a-93"]{(A.93)}}
    @lang["zh-Hans"]{其中@tex-math{\vec{e}}有@tex-math{(m+1)}个元素。利用方程@link["blazek2005-ch12#eq-a-99"]{(A.99)}的定义，可以看出@tex-math{\vec{r}_0 = \vec{b} - \bar{A}\vec{x}_0 = \bar{V}_{m+1}\vec{e}}。于是，对于残差方程@link["blazek2005-ch12#eq-a-93"]{(A.93)}可得}
  }

  @tex-display-math[#:id "eq-a-100"]{\begin{aligned} \left\|\vec{b} - \bar{A}(\vec{x}_0 + \vec{z})\right\| &= \left\|\vec{r}_0 - \bar{A}\left(\sum_{j=1}^{m} y_j\vec{v}_j\right)\right\|\\ &= \left\|\vec{r}_0 - \bar{A}\bar{V}_m\vec{y}\right\|\\ &= \left\|\bar{V}_{m+1}\left(\vec{e} - \bar{H}^{*}_m\vec{y}\right)\right\|\\ &= \left\|\vec{e} - \bar{H}^{*}_m\vec{y}\right\|. \end{aligned} \tag{A.100}}

  @bi{
    @lang["en"]{We employed the orthonormality of @tex-math{\bar{V}_{m+1}} in the last step (this means @tex-math{\vec{v}_i^T\cdot\vec{v}_j = 0} for @tex-math{i \neq j} and @tex-math{\vec{v}_i^T\cdot\vec{v}_j = 1} for @tex-math{i = j}). Therefore, the problem of the minimisation of the residual can be simplified as}
    @lang["zh-Hans"]{最后一步用到了@tex-math{\bar{V}_{m+1}}的正交归一性（即当@tex-math{i \neq j}时@tex-math{\vec{v}_i^T\cdot\vec{v}_j = 0}，当@tex-math{i = j}时@tex-math{\vec{v}_i^T\cdot\vec{v}_j = 1}）。于是，残差的极小化问题可以简化为}
  }

  @tex-display-math[#:id "eq-a-101"]{\min_{\vec{z}\in\mathcal{K}_m}\left\|\vec{b} - \bar{A}(\vec{x}_0 + \vec{z})\right\| = \min_{\vec{y}\in R^m}\left\|\vec{e} - \bar{H}^{*}_m\vec{y}\right\|. \tag{A.101}}

  @bi{
    @lang["en"]{The solution of the minimisation problem can be obtained with the aid of the Q-R algorithm which is described next.}
    @lang["zh-Hans"]{该极小化问题的解可以借助下面介绍的Q-R算法求得。}
  }

  @emph{4. Q-R algorithm 4. Q-R算法}

  @bi{
    @lang["en"]{Let us define @tex-math{\bar{R}_m = \bar{Q}_m\bar{H}^{*}_m} with}
    @lang["zh-Hans"]{定义@tex-math{\bar{R}_m = \bar{Q}_m\bar{H}^{*}_m}，其中}
  }

  @tex-display-math[#:id "eq-a-102"]{\bar{Q}_m \overset{\mathrm{def}}{=} \bar{F}_m\bar{F}_{m-1}\cdots\bar{F}_1 \tag{A.102}}

  @bi{
    @lang["en"]{being the product of the Givens rotation matrices}
    @lang["zh-Hans"]{是Givens旋转矩阵的乘积}
  }

  @tex-display-math[#:id "eq-a-103"]{\bar{F}_j = \left[\begin{array}{ccc} \bar{I}_{j-1} & & \\ & \left[\begin{array}{cc} c_j & s_j\\ -s_j & c_j \end{array}\right] & \\ & & \bar{I}_{m-j} \end{array}\right]^{(m+1)\times(m+1)} \tag{A.103}}

  @bi{
    @lang["en"]{In Eq. @link["blazek2005-ch12#eq-a-103"]{(A.103)}, @tex-math{\bar{I}_j} denotes the identity matrix of dimension @tex-math{j}. Further, @tex-math{c_j} and @tex-math{s_j} (@tex-math{c_j^2 + s_j^2 = 1}) represent the sine/cosine of the rotation angle. The rotations are chosen such that @tex-math{\bar{H}^{*}_m} is transformed into an upper triangular matrix @tex-math{\bar{R}_m} which has the dimensions @tex-math{(m+1)\times m} and which last line contains only zeros. Since @tex-math{\bar{Q}_m^T\bar{Q}_m = \bar{I}}, we can write in Eq. @link["blazek2005-ch12#eq-a-101"]{(A.101)}}
    @lang["zh-Hans"]{在方程@link["blazek2005-ch12#eq-a-103"]{(A.103)}中，@tex-math{\bar{I}_j}表示维数为@tex-math{j}的单位矩阵。此外，@tex-math{c_j}与@tex-math{s_j}（@tex-math{c_j^2 + s_j^2 = 1}）表示旋转角的正弦/余弦。旋转的选取使得@tex-math{\bar{H}^{*}_m}被变换为上三角矩阵@tex-math{\bar{R}_m}，其维数为@tex-math{(m+1)\times m}，且最后一行全为零。由于@tex-math{\bar{Q}_m^T\bar{Q}_m = \bar{I}}，在方程@link["blazek2005-ch12#eq-a-101"]{(A.101)}中可以写成}
  }

  @tex-display-math[#:id "eq-a-104"]{\begin{aligned} \left\|\vec{e} - \bar{H}^{*}_m\vec{y}\right\| &= \left\|\bar{Q}_m^T\left(\bar{Q}_m\vec{e} - \bar{Q}_m\bar{H}^{*}_m\vec{y}\right)\right\|\\ &= \left\|\vec{g} - \bar{R}_m\vec{y}\right\|, \end{aligned} \tag{A.104}}

  @bi{
    @lang["en"]{where @tex-math{\vec{g} = \bar{Q}_m\vec{e}} denotes the transformation of the vector @tex-math{\vec{e}} (Eq. @link["blazek2005-ch12#eq-a-99"]{(A.99)}). The last line of @tex-math{\bar{R}_m} consists of zeros, therefore only the term @tex-math{g_{m+1}} is nonzero in the row @tex-math{(m+1)} of the vector @tex-math{(\vec{g} - \bar{R}_m\vec{y})}. If we denote the first @tex-math{m}-components of @tex-math{(\vec{g} - \bar{R}_m\vec{y})} as @tex-math{p_j} (@tex-math{j = 1, \cdots, m}), then the norm in Eq. @link["blazek2005-ch12#eq-a-104"]{(A.104)} becomes}
    @lang["zh-Hans"]{其中@tex-math{\vec{g} = \bar{Q}_m\vec{e}}表示向量@tex-math{\vec{e}}（方程@link["blazek2005-ch12#eq-a-99"]{(A.99)}）变换后的结果。@tex-math{\bar{R}_m}的最后一行全为零，因此在向量@tex-math{(\vec{g} - \bar{R}_m\vec{y})}的第@tex-math{(m+1)}行中只有@tex-math{g_{m+1}}项非零。若把@tex-math{(\vec{g} - \bar{R}_m\vec{y})}的前@tex-math{m}个分量记为@tex-math{p_j}（@tex-math{j = 1, \cdots, m}），则方程@link["blazek2005-ch12#eq-a-104"]{(A.104)}中的范数成为}
  }

  @tex-display-math[#:id "eq-a-105"]{\left\|\vec{g} - \bar{R}_m\vec{y}\right\| = \sqrt{g_{m+1}^2 + \sum_{j=1}^{m} p_j^2}. \tag{A.105}}

  @bi{
    @lang["en"]{If we choose the components @tex-math{y_j} of @tex-math{\vec{y}} in such a way that @tex-math{p_j^2 = 0} for all @tex-math{j = 1, \cdots, m}, we obtain for the minimisation problem in Eq. @link["blazek2005-ch12#eq-a-101"]{(A.101)}}
    @lang["zh-Hans"]{若选取@tex-math{\vec{y}}的分量@tex-math{y_j}使得对所有@tex-math{j = 1, \cdots, m}都有@tex-math{p_j^2 = 0}，则方程@link["blazek2005-ch12#eq-a-101"]{(A.101)}的极小化问题成为}
  }

  @tex-display-math[#:id "eq-a-106"]{\min_{\vec{y}\in R^m}\left\|\vec{g} - \bar{R}_m\vec{y}\right\| = \left|g_{m+1}\right|. \tag{A.106}}

  @bi{
    @lang["en"]{The components @tex-math{y_j} results from the solution of the following system of linear equations}
    @lang["zh-Hans"]{分量@tex-math{y_j}由求解下列线性方程组得到}
  }

  @tex-display-math[#:id "eq-a-107"]{\left[\begin{array}{cccc} R_{1,1} & \cdots & R_{1,m-1} & R_{1,m}\\ 0 & \ddots & \vdots & \vdots\\ \vdots & \ddots & R_{m-1,m-1} & R_{m-1,m}\\ 0 & \cdots & 0 & R_{m,m} \end{array}\right]\left[\begin{array}{c} y_1\\ \vdots\\ y_{m-1}\\ y_m \end{array}\right] = \left[\begin{array}{c} g_1\\ \vdots\\ g_{m-1}\\ g_m \end{array}\right]. \tag{A.107}}

  @bi{
    @lang["en"]{by back-substitution. The solution of the system of equations @link["blazek2005-ch12#eq-a-90"]{(A.90)} is then obtained with the known @tex-math{y_j} from Eq. @link["blazek2005-ch12#eq-a-95"]{(A.95)}.}
    @lang["zh-Hans"]{通过回代求解。随后利用已知的@tex-math{y_j}，由方程@link["blazek2005-ch12#eq-a-95"]{(A.95)}即得方程组@link["blazek2005-ch12#eq-a-90"]{(A.90)}的解。}
  }

  @bi{
    @lang["en"]{It is important to remark that}
    @lang["zh-Hans"]{值得注意的是}
  }

  @tex-display-math[#:id "eq-a-108"]{\begin{aligned} \left\|\vec{r}_m\right\| &= \left\|\vec{b} - \bar{A}(\vec{x}_0 + \vec{z})\right\|\\ &= \left\|\vec{e} - \bar{H}^{*}_m\vec{y}\right\|\\ &= \left\|\vec{g} - \bar{R}_m\vec{y}\right\|\\ &= \left|g_{m+1}\right|. \end{aligned} \tag{A.108}}

  @bi{
    @lang["en"]{This means that the actual residual can be easily determined as @tex-math{\left|g_{m+1}\right|}.}
    @lang["zh-Hans"]{这意味着实际残差可以方便地由@tex-math{\left|g_{m+1}\right|}确定。}
  }
}

@subtree[#:id "blazek2005-a-13"]{
  @title{A.13 Tensor Notation A.13 张量记号}

  @bi{
    @lang["en"]{Expressions like coordinate (@tex-math{x_i}) or velocity components (@tex-math{v_i}) represent @emph{first-order tensors}. They have three components and thus correspond to vectors. Hence,}
    @lang["zh-Hans"]{像坐标（@tex-math{x_i}）或速度分量（@tex-math{v_i}）这样的量表示一阶张量（first-order tensor）。它们有三个分量，因而对应于向量。于是，}
  }

  @tex-display-math[#:id "eq-a-109"]{\begin{aligned} x_i &= \left[x_1, x_2, x_3\right] = \left[x, y, z\right] = \vec{r}\\ v_i &= \left[v_1, v_2, v_3\right] = \left[u, v, w\right] = \vec{v}. \end{aligned} \tag{A.109}}

  @bi{
    @lang["en"]{@emph{Second-order tensors} consist of nine components and can be written as @tex-math{3\times 3} matrices, e.g.,}
    @lang["zh-Hans"]{二阶张量（second-order tensor）有九个分量，可以写成@tex-math{3\times 3}矩阵，例如}
  }

  @tex-display-math[#:id "eq-a-110"]{v_i v_j \equiv \begin{bmatrix} v_1 v_1 & v_1 v_2 & v_1 v_3\\ v_2 v_1 & v_2 v_2 & v_2 v_3\\ v_3 v_1 & v_3 v_2 & v_3 v_3 \end{bmatrix}. \tag{A.110}}

  @bi{
    @lang["en"]{Similarly, the tensor of viscous stresses @tex-math{\overline{\overline{\tau}} = \tau_{ij}} reads}
    @lang["zh-Hans"]{类似地，黏性应力张量@tex-math{\overline{\overline{\tau}} = \tau_{ij}}为}
  }

  @tex-display-math[#:id "eq-a-111"]{\tau_{ij} \equiv \begin{bmatrix} \tau_{11} & \tau_{12} & \tau_{13}\\ \tau_{21} & \tau_{22} & \tau_{23}\\ \tau_{31} & \tau_{32} & \tau_{33} \end{bmatrix} \tag{A.111}}

  @bi{
    @lang["en"]{The Kronecker symbol @tex-math{\delta_{ij}} is a special second-order tensor. It corresponds to a @tex-math{3\times 3} identity matrix. Thus, the relation holds}
    @lang["zh-Hans"]{Kronecker符号@tex-math{\delta_{ij}}是一种特殊的二阶张量，对应于@tex-math{3\times 3}单位矩阵。于是有关系式}
  }

  @tex-display-math[#:id "eq-a-112"]{\delta_{ij} = \begin{cases} 1 & \text{if } i = j\\ 0 & \text{if } i \neq j. \end{cases} \tag{A.112}}

  @bi{
    @lang["en"]{The last important rule is the so-called @emph{Einstein summation convention}. It states that whenever two identical indices occur in an expression, it means a sum over all three coordinate directions. With this, the scalar product between the vectors @tex-math{\vec{u}} and @tex-math{\vec{v}} can be expressed as}
    @lang["zh-Hans"]{最后一条重要规则是所谓的Einstein求和约定（Einstein summation convention）。它规定：表达式中凡出现两个相同的指标，就意味着对所有三个坐标方向求和。据此，向量@tex-math{\vec{u}}与@tex-math{\vec{v}}之间的标量积可以表示为}
  }

  @tex-display-math[#:id "eq-a-113"]{u_i v_i = u_1 v_1 + u_2 v_2 + u_3 v_3 = \vec{u}\cdot\vec{v}. \tag{A.113}}

  @bi{
    @lang["en"]{Furthermore, the divergence of the vector @tex-math{\vec{v}} becomes in tensor notation}
    @lang["zh-Hans"]{此外，向量@tex-math{\vec{v}}的散度在张量记号下为}
  }

  @tex-display-math[#:id "eq-a-114"]{\frac{\partial v_i}{\partial x_i} = \frac{\partial v_1}{\partial x_1} + \frac{\partial v_2}{\partial x_2} + \frac{\partial v_3}{\partial x_3} = \vec{\nabla}\cdot\vec{v}. \tag{A.114}}
}
