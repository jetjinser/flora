if has nix; then
  watch_file nix/flake.nix
  watch_file nix/flake.lock
  use flake path:nix
elif has guix; then
  watch_file channels.scm manifest.scm
  watch_file ../grove/channels.scm ../grove/manifest.scm ../grove/guix.scm
  eval "$(guix time-machine -C channels.scm -- shell \
    -m ../grove/manifest.scm -m manifest.scm \
    -f ../grove/guix.scm --search-paths)"
fi
