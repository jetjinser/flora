if has nix; then
  watch_file nix/flake.nix
  watch_file nix/flake.lock
  use flake path:nix
elif has guix; then
  GROVE_CHECKOUT=${GROVE_CHECKOUT:-$HOME/vie/projet/prototype/grove}
  watch_file channels.scm manifest.scm
  watch_file "$GROVE_CHECKOUT/channels.scm" "$GROVE_CHECKOUT/manifest.scm" \
    "$GROVE_CHECKOUT/guix.scm"
  eval "$(guix time-machine -C channels.scm -- shell \
    -m "$GROVE_CHECKOUT/manifest.scm" -m manifest.scm \
    -f "$GROVE_CHECKOUT/guix.scm" --search-paths)"
fi
