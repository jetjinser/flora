flora_grove_source="${FLORA_GROVE_SOURCE:-}"
if [ -n "$flora_grove_source" ]; then
  if [ ! -f "$flora_grove_source/flake.nix" ] || \
     [ ! -f "$flora_grove_source/guix/channel/grove/packages.scm" ]; then
    log_error "FLORA_GROVE_SOURCE must name a Grove checkout"
    exit 1
  fi
  flora_grove_source="$(cd "$flora_grove_source" && pwd)"
  export FLORA_GROVE_SOURCE="$flora_grove_source"
fi

if has nix; then
  watch_file nix/flake.nix
  watch_file nix/flake.lock
  if [ -n "$flora_grove_source" ]; then
    watch_file "$flora_grove_source/flake.nix"
    watch_file "$flora_grove_source/flake.lock"
    use flake path:nix --override-input grove "path:$flora_grove_source"
  else
    use flake path:nix
  fi
elif has guix; then
  watch_file channels.scm manifest.scm smathml/manifest.scm
  if [ -n "$flora_grove_source" ]; then
    watch_file "$flora_grove_source/guix/channel/grove/packages.scm"
    watch_file "$flora_grove_source/grove-package.scm"
    watch_file "$flora_grove_source/guix/package-definitions.scm"
    export GUIX_PACKAGE_PATH="$flora_grove_source/guix/channel${GUIX_PACKAGE_PATH:+:$GUIX_PACKAGE_PATH}"
  fi
  eval "$(guix time-machine -C channels.scm -- shell \
    -m manifest.scm -m smathml/manifest.scm --search-paths)"
fi
